page{background:#f3f7f5;color:#183f34;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.page{padding:32rpx;padding-bottom:calc(40rpx + env(safe-area-inset-bottom))}.card{background:#fff;border-radius:28rpx;padding:32rpx;margin-bottom:24rpx;box-shadow:0 12rpx 40rpx rgba(19,66,52,.04)}.title{font-size:34rpx;font-weight:600}.sub{font-size:26rpx;line-height:1.7;color:#71837b;margin-top:12rpx}button{width:100%;box-sizing:border-box;border-radius:18rpx;font-size:28rpx;line-height:88rpx;margin:20rpx 0 0;background:#edf5f1;color:#087f6b}button::after{border:0}.primary{background:#087f6b;color:white}.error{color:#ad493d;font-size:26rpx;line-height:1.6;margin-top:20rpx}.hero{padding:24rpx 4rpx 40rpx}.hero-title{font-size:48rpx;font-weight:600}.hero-label{font-size:24rpx;letter-spacing:4rpx;color:#087f6b;margin-bottom:16rpx}.link{text-align:center;color:#788d82;font-size:24rpx;padding:24rpx}

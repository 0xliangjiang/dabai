.summary{font-size:28rpx;margin:32rpx 4rpx 16rpx;color:#53695f}.empty{padding:32rpx 4rpx;font-size:28rpx;line-height:1.6;color:#53695f}.goal-row{padding:24rpx;background:#fff;border-radius:20rpx;margin-bottom:16rpx}.goal-main{display:flex;align-items:flex-start}.goal-toggle{width:80rpx;height:80rpx;line-height:80rpx;margin:0 20rpx 0 0;flex-shrink:0;font-size:32rpx}.goal-done{background:#087f6b;color:#fff}.goal-title{flex:1;min-width:0;word-break:break-all;font-size:30rpx;line-height:1.6;padding-top:14rpx}.goal-finished{text-decoration:line-through;color:#53695f}.goal-actions{display:flex;justify-content:flex-end;margin-top:16rpx}.goal-action{width:auto;min-width:112rpx;font-size:28rpx;line-height:80rpx;margin:0 0 0 16rpx;padding:0 20rpx}.goal-delete{color:#ad493d;background:#faf0ed}

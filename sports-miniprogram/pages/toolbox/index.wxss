.tool-list{background:#fff;border-radius:28rpx;padding:0 28rpx}.tool-entry{display:flex;align-items:center;padding:32rpx 0;border-bottom:1rpx solid #e6eee9}.tool-entry:last-child{border-bottom:0}.tool-icon{width:72rpx;height:72rpx;line-height:72rpx;text-align:center;border-radius:20rpx;background:#edf5f1;color:#087f6b;font-size:36rpx;font-weight:500;flex-shrink:0;margin-right:24rpx}.tool-copy{flex:1;min-width:0}.tool-arrow{font-size:40rpx;color:#087f6b;margin-left:16rpx;flex-shrink:0}.tool-description{font-size:28rpx;line-height:1.6;color:#53695f;margin-top:8rpx}.tool-note{font-size:28rpx;line-height:1.6;color:#53695f;padding:24rpx 4rpx}.service-entry{display:flex;align-items:center;padding:24rpx 28rpx;border:1rpx solid #cfdfd6;border-radius:24rpx;margin-top:24rpx}.service-title{font-size:30rpx;font-weight:500}.tool-pressed{background:#e8f2ec}

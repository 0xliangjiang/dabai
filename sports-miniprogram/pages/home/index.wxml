<view class="page">
  <view class="hero"><view class="hero-label">{{previewMode ? 'DAILY GOALS' : 'DAILY MOVEMENT'}}</view><view class="hero-title">{{previewMode ? '设定目标，开始今天' : '今天，向目标迈一步'}}</view><view class="sub">{{previewMode ? '填写目标，体验提交流程。' : '共用已绑定账号，集中管理步数服务；真实操作需要关联账号。'}}</view></view>
  <view wx:if="{{loading}}" class="card"><view class="sub">正在连接账号…</view></view>
  <view wx:elif="{{!linked && !previewMode}}" class="card"><view class="title">关联你的运动账号</view><view class="sub">在原小程序的运动页面生成绑定码，复制到这里完成关联。请使用同一个微信账号。</view><input class="binding-code" maxlength="32" value="{{bindingCode}}" bindinput="inputBindingCode" placeholder="输入 12 位绑定码" disabled="{{busy}}"/><button class="primary" bindtap="linkWithCode" loading="{{linking}}" disabled="{{busy || !bindingCode}}">确认关联账号</button><view wx:if="{{error}}" class="error">{{error}}</view><button bindtap="openSource" disabled="{{busy}}">获取绑定码</button><button bindtap="useLinkedAccount" disabled="{{busy}}">已关联，重新登录</button><button wx:if="{{previewAvailable}}" bindtap="enterPreview" disabled="{{busy}}">无需关联，公开体验</button></view>
  <block wx:else>
    <view wx:if="{{previewMode}}" class="card preview-notice"><view class="title">公开体验 · 演示模式</view><view class="sub">无需登录或关联，即可体验目标提交流程。演示结果仅在当前页面显示，不修改真实账号数据。</view><button bindtap="useLinkedAccount" disabled="{{busy}}">关联账号，使用真实服务</button></view>
    <view wx:if="{{!previewMode && !enabled}}" class="card"><view class="sub">当前步数服务暂未开放，账号与会员信息仍可查看。</view></view>
    <view wx:if="{{!previewMode}}" class="card"><view class="title">{{accountName}}</view><view class="sub">{{isBound ? '微信已绑定' : '请返回原小程序完成微信绑定'}}</view><view class="stats"><view class="stat"><view class="stat-value">{{todaySteps || '—'}}</view><view class="stat-label">今日已设置步数</view></view><view class="stat"><view class="stat-value">{{membershipText}}</view><view class="stat-label">会员有效期</view></view></view><button wx:if="{{!isBound}}" bindtap="openSource">去完成绑定</button><button wx:if="{{previewAvailable}}" bindtap="enterPreview" disabled="{{busy}}">查看公开演示</button></view>
    <view class="card"><view class="title">{{previewMode ? '目标' : '设置今日步数'}}</view><view wx:if="{{!previewMode}}" class="sub">输入 1–98,800 步；提交后以微信运动实际显示为准。</view><input type="number" maxlength="5" value="{{stepsInput}}" bindinput="inputSteps" placeholder="{{previewMode ? '输入目标' : '输入目标步数'}}" disabled="{{busy}}"/><view wx:if="{{!previewMode}}" class="suggestions"><button data-steps="10000" bindtap="chooseSteps" disabled="{{busy}}">10,000</button><button data-steps="20000" bindtap="chooseSteps" disabled="{{busy}}">20,000</button></view><button class="primary" bindtap="submitSteps" loading="{{busy && !adLoading}}" disabled="{{busy || (!previewMode && (!isBound || !enabled))}}">{{previewMode ? '提交' : '提交步数'}}</button><view wx:if="{{previewMode && todaySteps}}" class="sub">本次演示目标：{{todaySteps}}</view><view wx:if="{{result}}" class="result">{{result}}</view><view wx:if="{{error}}" class="error">{{error}}</view></view>
    <view wx:if="{{!previewMode && expired}}" class="card"><view class="title">解锁一次步数服务</view><view class="sub">会员已到期。完整观看一次广告后，可提交一次；失败不会消耗本次授权。</view><button wx:if="{{adUnitId}}" bindtap="watchAd" loading="{{adLoading}}" disabled="{{busy || !isBound || !enabled}}">{{grantToken ? '已解锁，请提交步数' : '观看广告，解锁一次'}}</button><view wx:else class="sub">广告服务暂未开放，可使用卡密延期。</view></view>
    <view wx:if="{{!previewMode}}" class="card"><view class="title">卡密延期</view><input class="code" value="{{accessCode}}" bindinput="inputCode" placeholder="请输入运动会员卡密" disabled="{{busy}}"/><button bindtap="redeemCode" disabled="{{busy}}">兑换卡密</button><button bindtap="openSource">返回原小程序管理账号</button></view>
  </block>
  <navigator class="link" url="/pages/privacy/index">隐私说明</navigator>
</view>

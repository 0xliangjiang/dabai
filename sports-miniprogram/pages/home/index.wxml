<view class="page">
  <view class="hero"><view class="hero-title">{{previewMode ? "目标提交" : "运动账号服务"}}</view><view class="tool-sub">{{previewMode ? "目标保存在本机，可在目标清单中查看。" : "关联已绑定账号，查看会员并提交步数目标。"}}</view></view>
  <view wx:if="{{loading}}" class="card"><view class="tool-sub">正在读取服务配置…</view></view>
  <view wx:elif="{{!configReady}}" class="card"><view class="title">暂时无法读取服务配置</view><view class="error">{{error}}</view><button class="primary" bindtap="useLinkedAccount">重试</button></view>
  <view wx:elif="{{previewMode}}" class="card"><label class="field-label" for="public-goal">目标</label><input id="public-goal" class="public-goal" maxlength="80" value="{{goalInput}}" bindinput="inputGoal" placeholder="输入目标" confirm-type="done" bindconfirm="submitGoal"/><button class="primary" bindtap="submitGoal">提交</button><view wx:if="{{result}}" class="result">{{result}}</view><view wx:if="{{error}}" class="error">{{error}}</view><navigator class="link" url="/pages/goals/index">查看目标清单</navigator><navigator class="link" url="/pages/home/index?mode=account">真实账号服务</navigator></view>
  <view wx:elif="{{!linked}}" class="card"><view class="title">关联你的运动账号</view><view class="tool-sub">在原小程序的运动页面生成绑定码，复制到这里完成关联。请使用同一个微信账号。</view><label class="field-label" for="binding">绑定码</label><input id="binding" class="binding-code" maxlength="32" value="{{bindingCode}}" bindinput="inputBindingCode" placeholder="输入 12 位绑定码" disabled="{{busy}}"/><button class="primary" bindtap="linkWithCode" loading="{{linking}}" disabled="{{busy}}">确认关联账号</button><view wx:if="{{error}}" class="error">{{error}}</view><button bindtap="openSource" disabled="{{busy}}">获取绑定码</button><button bindtap="useLinkedAccount" disabled="{{busy}}">已关联，重新登录</button></view>
  <block wx:else>
    <view wx:if="{{!enabled}}" class="card"><view class="tool-sub">当前步数服务暂未开放，账号与会员信息仍可查看。</view></view>
    <view class="card"><view class="title">{{accountName}}</view><view class="tool-sub">{{isBound ? '微信已绑定' : '请返回原小程序完成微信绑定'}}</view><view class="stats"><view class="stat"><view class="stat-value">{{todaySteps || '—'}}</view><view class="stat-label">今日已设置步数</view></view><view class="stat"><view class="stat-value">{{membershipText}}</view><view class="stat-label">会员有效期</view></view></view><button wx:if="{{!isBound}}" bindtap="openSource">去完成绑定</button></view>
    <view class="card"><view class="title">设置今日步数</view><view class="tool-sub">输入 1–98,800 步；提交后以微信运动实际显示为准。</view><label class="field-label" for="steps">目标步数</label><input id="steps" type="number" maxlength="5" value="{{stepsInput}}" bindinput="inputSteps" placeholder="输入目标步数" disabled="{{busy}}"/><view class="suggestions"><button data-steps="10000" bindtap="chooseSteps" disabled="{{busy}}">10,000</button><button data-steps="20000" bindtap="chooseSteps" disabled="{{busy}}">20,000</button></view><button class="primary" bindtap="submitSteps" loading="{{busy && !adLoading}}" disabled="{{busy || !isBound || !enabled}}">提交步数</button><view wx:if="{{result}}" class="result">{{result}}</view><view wx:if="{{error}}" class="error">{{error}}</view></view>
    <view wx:if="{{expired}}" class="card"><view class="title">解锁一次步数服务</view><view class="tool-sub">会员已到期。完整观看一次广告后，可提交一次；失败不会消耗本次授权。</view><button wx:if="{{adUnitId}}" bindtap="watchAd" loading="{{adLoading}}" disabled="{{busy || !isBound || !enabled}}">{{grantToken ? '已解锁，请提交步数' : '观看广告，解锁一次'}}</button><view wx:else class="tool-sub">广告服务暂未开放，请返回原小程序管理会员。</view></view>
    <button bindtap="openSource">返回原小程序管理账号</button>
  </block>
  <navigator class="link" url="/pages/toolbox/index" open-type="reLaunch">返回工具箱</navigator><navigator class="link" url="/pages/privacy/index">隐私说明</navigator>
</view>

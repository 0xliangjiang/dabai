.privacy-mask {
  position: fixed;
  inset: 0;
  z-index: 1100;
  display: flex;
  align-items: flex-end;
  background: rgba(13, 31, 23, 0.55);
}

.privacy-card {
  width: 100%;
  box-sizing: border-box;
  padding: 44rpx 36rpx calc(36rpx + env(safe-area-inset-bottom));
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  background: #ffffff;
  animation: privacy-slide-up 0.3s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

@keyframes privacy-slide-up {
  from {
    transform: translateY(40rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.privacy-title {
  color: #18241d;
  font-size: 34rpx;
  font-weight: 800;
  text-align: center;
}

.privacy-text {
  margin-top: 18rpx;
  color: #4b5d53;
  font-size: 26rpx;
  line-height: 1.6;
}

.privacy-link {
  color: #0a7a52;
  font-weight: 700;
}

.privacy-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.privacy-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.privacy-btn::after {
  border: 0;
}

.privacy-btn.reject {
  color: #66796d;
  background: #eef3f0;
}

.privacy-btn.agree {
  color: #ffffff;
  background: linear-gradient(135deg, #2fce8e 0%, #0d9d6c 100%);
}

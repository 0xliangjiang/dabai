/* 给页面滚动容器加底部留白，防止内容被自定义 tab bar 遮挡 */
page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.streak-chip {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #faf0d7 0%, #f3e3b8 100%);
  color: #8a6420;
  font-size: 22rpx;
  font-weight: 800;
  letter-spacing: 0.5rpx;
}

.points-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-top: 14rpx;
}

.points-yuan {
  color: #b98a2e;
  font-size: 26rpx;
  font-weight: 800;
}

.points-actions {
  margin-top: 28rpx;
}

.points-actions .checkin-btn,
.points-actions .withdraw-btn {
  flex: 1;
  width: auto;
  height: 84rpx;
}

.withdraw-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  color: #8a6420;
  background: linear-gradient(135deg, #faf0d7 0%, #f1deab 100%);
  border: 1rpx solid rgba(185, 138, 46, 0.25);
  box-sizing: border-box;
}

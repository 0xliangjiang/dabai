/* 给页面滚动容器加底部留白，防止内容被自定义 tab bar 遮挡 */
/* tab bar 高度 = 14 + 104 + 14 + safe-area ≈ 132rpx + safe-area */
page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.withdraw-btn {
  width: 152rpx;
  height: 68rpx;
  flex: 0 0 auto;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #047857;
  background: #d1fae5;
}

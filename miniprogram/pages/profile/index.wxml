<view class="cu-page page-shell">
  <view class="hero anim-up">
    <view class="eyebrow">我的</view>
    <view class="hero-title">账户中心</view>
  </view>

  <view class="content-stack floating-stack">
    <view class="cu-card profile-card flex align-center justify-between gap anim-up delay-1">
      <view class="flex align-center gap-sm flex-sub">
        <view class="profile-avatar">白</view>
        <view class="flex-sub">
          <view class="section-title">{{loginTitle}}</view>
          <view class="section-desc">{{loginDesc}}</view>
        </view>
      </view>
      <button wx:if="{{!isLoggedIn}}" class="cu-btn login-btn pressable" hover-class="pressed" disabled="{{loggingIn}}" loading="{{loggingIn}}" bindtap="login">微信登录</button>
      <button wx:else class="cu-btn secondary mini-btn pressable" hover-class="pressed" bindtap="logout">退出</button>
    </view>

    <view class="cu-card glass-card grid-2 anim-up delay-2">
      <view class="metric">
        <view class="muted text-sm">身份</view>
        <view class="metric-value">{{identityText}}</view>
      </view>
      <view class="metric">
        <view class="muted text-sm">优惠</view>
        <view class="metric-value">预估</view>
      </view>
    </view>

    <view class="cu-card flex-direction gap anim-up delay-3">
      <view class="flex align-start justify-between gap-sm">
        <view class="flex-sub">
          <view class="section-title">优惠说明</view>
          <view class="section-desc">展示金额为预估参考，实际结果以订单结算为准。</view>
        </view>
        <view class="cu-tag blue">预估</view>
      </view>
    </view>

    <view class="cu-card flex align-start justify-between gap-sm anim-up delay-3">
      <view class="flex-sub">
        <view class="section-title">订单有遗漏？</view>
        <view class="section-desc">提交订单信息。</view>
      </view>
      <navigator class="mini-link" url="/pages/claim/index">去补充</navigator>
    </view>

    <view class="cu-list anim-up delay-4">
      <navigator class="cu-item flex align-center justify-between line" hover-class="item-pressed" url="/pages/rebate-rules/index">
        <view>
          <view class="cu-label">优惠说明</view>
          <view class="section-desc">查看预估、结算规则</view>
        </view>
        <view class="cu-arrow">›</view>
      </navigator>
      <navigator class="cu-item flex align-center justify-between line" hover-class="item-pressed" url="/pages/claim/index">
        <view>
          <view class="cu-label">订单补充</view>
          <view class="section-desc">补充订单信息</view>
        </view>
        <view class="cu-arrow">›</view>
      </navigator>
      <navigator class="cu-item flex align-center justify-between line" hover-class="item-pressed" url="/pages/privacy/index">
        <view>
          <view class="cu-label">隐私政策</view>
          <view class="section-desc">了解登录、剪贴板和订单数据用途</view>
        </view>
        <view class="cu-arrow">›</view>
      </navigator>
      <navigator class="cu-item flex align-center justify-between line" hover-class="item-pressed" url="/pages/agreement/index">
        <view>
          <view class="cu-label">用户协议</view>
          <view class="section-desc">查看服务使用说明</view>
        </view>
        <view class="cu-arrow">›</view>
      </navigator>
      <button
        class="cu-item contact-item flex align-center justify-between" hover-class="item-pressed"
        open-type="contact"
        show-message-card="true"
        send-message-title="大白小助手客服"
        send-message-path="/pages/home/index"
      >
        <view>
          <view class="cu-label">客服入口</view>
          <view class="section-desc">咨询订单、优惠和使用问题</view>
        </view>
        <view class="cu-arrow">›</view>
      </button>
      <view class="cu-item flex align-center justify-between">
        <view>
          <view class="cu-label">服务时间</view>
          <view class="section-desc">工作日 09:00-18:00，非工作时间请留言</view>
        </view>
      </view>
    </view>
  </view>

  <privacy-consent show="{{showPrivacy}}" bind:agree="onPrivacyAgree" bind:reject="onPrivacyReject" />
</view>

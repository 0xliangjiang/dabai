<view class="cu-page page-shell">
  <view class="hero">
    <view class="eyebrow">我的</view>
    <view class="hero-title">账户中心</view>
  </view>

  <view class="content-stack floating-stack">
    <view class="cu-card glass-card grid-2">
      <view class="metric">
        <view class="muted text-sm">身份</view>
        <view class="metric-value">用户</view>
      </view>
      <view class="metric">
        <view class="muted text-sm">返利</view>
        <view class="metric-value">预估</view>
      </view>
    </view>

    <view class="cu-card flex-direction gap">
      <view class="flex align-start justify-between gap-sm">
        <view class="flex-sub">
          <view class="section-title">返利说明</view>
          <view class="section-desc">展示金额为预估参考，实际到账以订单结算为准。</view>
        </view>
        <view class="cu-tag blue">预估</view>
      </view>
    </view>

    <view class="cu-card flex align-start justify-between gap-sm">
      <view class="flex-sub">
        <view class="section-title">订单有遗漏？</view>
        <view class="section-desc">提交订单信息。</view>
      </view>
      <navigator class="mini-link" url="/pages/claim/index">去补充</navigator>
    </view>

    <view class="cu-list">
      <navigator class="cu-item flex align-center justify-between line" url="/pages/claim/index">
        <view>
          <view class="cu-label">订单补充</view>
          <view class="section-desc">补充订单信息</view>
        </view>
        <view class="cu-arrow">›</view>
      </navigator>
      <view class="cu-item flex align-center justify-between">
        <view>
          <view class="cu-label">客服入口</view>
          <view class="section-desc">联系平台客服</view>
        </view>
      </view>
    </view>
  </view>
</view>

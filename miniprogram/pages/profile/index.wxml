<view class="cu-page page-shell">
  <view class="hero hero-slim anim-up"></view>

  <view class="content-stack floating-stack">
    <view class="cu-card profile-card flex align-center justify-between gap anim-up delay-1">
      <view class="flex align-center gap-sm flex-sub">
        <view class="avatar-ring {{isLoggedIn ? 'is-member' : ''}}">
          <image wx:if="{{displayAvatar}}" class="profile-avatar-img" src="{{displayAvatar}}" mode="aspectFill" />
          <view wx:else class="profile-avatar">{{nickname ? nickname[0] : '匠'}}</view>
          <view wx:if="{{isLoggedIn}}" class="avatar-dot"></view>
        </view>
        <view class="flex-sub">
          <view class="section-title">{{loginTitle}}</view>
          <view wx:if="{{loginDesc}}" class="section-desc">{{loginDesc}}</view>
        </view>
      </view>
      <button wx:if="{{!isLoggedIn}}" class="cu-btn login-btn pressable" hover-class="pressed" disabled="{{loggingIn}}" loading="{{loggingIn}}" bindtap="login">微信登录</button>
      <view wx:else class="mini-link" bindtap="startEditProfile">编辑</view>
    </view>

    <view wx:if="{{isLoggedIn && editingProfile}}" class="cu-card cu-form anim-up">
      <view class="section-title">编辑资料</view>
      <view class="flex align-center gap">
        <button class="avatar-picker pressable" hover-class="pressed" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image wx:if="{{draftAvatarTemp || displayAvatar}}" class="avatar-picker-img" src="{{draftAvatarTemp || displayAvatar}}" mode="aspectFill" />
          <view wx:else class="avatar-picker-empty">选头像</view>
        </button>
        <view class="flex-sub">
          <view class="cu-label margin-bottom-sm">昵称</view>
          <input class="cu-input" type="nickname" value="{{draftNickname}}" placeholder="请输入昵称" bindinput="onNicknameInput" />
        </view>
      </view>
      <view class="flex gap-sm">
        <button class="cu-btn secondary flex-sub pressable" hover-class="pressed" bindtap="cancelEditProfile">取消</button>
        <button class="cu-btn primary flex-sub pressable" hover-class="pressed" loading="{{savingProfile}}" disabled="{{savingProfile}}" bindtap="saveProfile">{{savingProfile ? '保存中…' : '保存'}}</button>
      </view>
    </view>

    <view class="cu-card points-card anim-up delay-2">
      <view class="flex align-center justify-between">
        <view class="muted text-sm">积分余额</view>
        <view class="streak-chip">{{checkin.streak > 0 ? '已连续签到 ' + checkin.streak + ' 天' : '每日签到 +5 积分'}}</view>
      </view>
      <view class="points-row">
        <view class="points-value">{{isLoggedIn ? availablePoints : '—'}}</view>
        <view class="points-yuan">≈ ¥{{isLoggedIn ? balanceText : '—'}}</view>
      </view>
      <view class="points-sub">100 积分 = 1 元，满 1000 积分可兑换</view>
      <view class="points-actions flex gap-sm">
        <button class="cu-btn checkin-btn pressable {{checkin.todayChecked ? 'checked' : ''}}" hover-class="pressed" bindtap="checkIn" disabled="{{checkinLoading}}">{{checkin.todayChecked ? '已签到' : '签到'}}</button>
        <view class="cu-btn withdraw-btn pressable" hover-class="pressed" bindtap="openWithdrawForm">积分兑换</view>
      </view>
    </view>

    <!-- 兑换申请弹窗 -->
    <view wx:if="{{showWithdrawForm}}" class="modal-overlay" bindtap="closeWithdrawForm">
      <view class="modal-card" catchtap="stopProp">
        <view class="modal-title">积分兑换申请</view>
        <view class="form-tip muted text-sm">当前积分 {{availablePoints}} · 100 积分 = 1 元 · 最低兑换 1000 积分</view>

        <view class="cu-label margin-top">兑换积分</view>
        <input class="cu-input" type="number" placeholder="请输入积分数量，最低 1000" value="{{withdrawAmount}}" bindinput="onWithdrawAmountInput" />

        <view class="flex gap-sm margin-top">
          <button class="cu-btn secondary flex-sub pressable" hover-class="pressed" bindtap="closeWithdrawForm">取消</button>
          <button class="cu-btn primary flex-sub pressable" hover-class="pressed" loading="{{submittingWithdraw}}" disabled="{{submittingWithdraw}}" bindtap="submitWithdraw">提交申请</button>
        </view>
      </view>
    </view>

    <view class="cu-list anim-up delay-3">
      <navigator class="cu-item flex align-center justify-between line" hover-class="item-pressed" url="/pages/withdrawals/index">
<view class="cu-label">兑换记录</view>
        <view class="cu-arrow">›</view>
      </navigator>
      <navigator class="cu-item flex align-center justify-between line" hover-class="item-pressed" url="/pages/claim/index">
<view class="cu-label">订单补充</view>
        <view class="cu-arrow">›</view>
      </navigator>
      <view class="cu-item flex align-center justify-between line" hover-class="item-pressed" bindtap="toggleMoreLinks">
<view class="cu-label">更多说明</view>
        <view class="cu-arrow more-arrow {{showMoreLinks ? 'expanded' : ''}}">›</view>
      </view>
      <block wx:if="{{showMoreLinks}}">
        <navigator class="cu-item sub-item flex align-center justify-between line" hover-class="item-pressed" url="/pages/rebate-rules/index">
          <view class="cu-label">积分说明</view>
          <view class="cu-arrow">›</view>
        </navigator>
        <navigator class="cu-item sub-item flex align-center justify-between line" hover-class="item-pressed" url="/pages/privacy/index">
          <view class="cu-label">隐私政策</view>
          <view class="cu-arrow">›</view>
        </navigator>
        <navigator class="cu-item sub-item flex align-center justify-between line" hover-class="item-pressed" url="/pages/agreement/index">
          <view class="cu-label">用户协议</view>
          <view class="cu-arrow">›</view>
        </navigator>
      </block>
      <view wx:if="{{isLoggedIn}}" class="cu-item logout-item flex align-center justify-between" hover-class="item-pressed" bindtap="logout">
        <view class="cu-label logout-label">退出登录</view>
        <view class="cu-arrow">›</view>
      </view>
    </view>

  </view>

  <!-- 悬浮客服按钮 -->
  <button
    class="fab-contact" hover-class="fab-contact-pressed"
    open-type="contact"
    show-message-card="true"
    send-message-title="捷径一生工具箱客服"
    send-message-path="/pages/home/index"
  >
    <view class="fab-icon">💬</view>
    <view class="fab-label">客服</view>
  </button>

  <privacy-consent show="{{showPrivacy}}" bind:agree="onPrivacyAgree" bind:reject="onPrivacyReject" />
</view>

page { padding-bottom: calc(160rpx + env(safe-area-inset-bottom)); }

.deal-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.content-switch {
  display: grid;
  grid-template-columns: 1fr 1fr;
  padding: 8rpx;
  border: 1rpx solid rgba(13, 157, 108, 0.14);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.92);
}

.content-switch-item {
  height: 72rpx;
  border-radius: 12rpx;
  color: #617066;
  font-size: 27rpx;
  font-weight: 700;
  background: transparent;
}

.content-switch-item::after {
  border: 0;
}

.content-switch-item.active {
  color: #ffffff;
  background: #0a7a52;
  box-shadow: 0 6rpx 14rpx rgba(10, 122, 82, 0.18);
}

.article-list-card {
  padding: 0;
  overflow: hidden;
}

.article-list-cover,
.article-cover-skeleton {
  width: 100%;
  height: 300rpx;
}

.article-list-cover {
  display: block;
  background: #e8f2ec;
}

.article-list-body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 28rpx;
}

.deal-meta {
  margin-top: 4rpx;
}

.subscribe-btn {
  width: 152rpx;
  height: 76rpx;
  flex: 0 0 auto;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #2fce8e 0%, #0d9d6c 100%);
  box-shadow: 0 8rpx 18rpx rgba(13, 157, 108, 0.22);
}

.subscribe-btn.subscribed {
  color: #0a7a52;
  background: #e9f6f0;
  box-shadow: none;
}

.pin-tag {
  flex: 0 0 auto;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #ffece8;
  color: #d4380d;
  font-size: 20rpx;
  font-weight: 800;
}

page { padding-bottom: calc(160rpx + env(safe-area-inset-bottom)); }

.deal-card {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.deal-meta {
  margin-top: 4rpx;
}

.subscribe-btn {
  width: 152rpx;
  height: 76rpx;
  flex: 0 0 auto;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #2fce8e 0%, #0d9d6c 100%);
  box-shadow: 0 8rpx 18rpx rgba(13, 157, 108, 0.22);
}

.subscribe-btn.subscribed {
  color: #0a7a52;
  background: #e9f6f0;
  box-shadow: none;
}

.pin-tag {
  flex: 0 0 auto;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #ffece8;
  color: #d4380d;
  font-size: 20rpx;
  font-weight: 800;
}

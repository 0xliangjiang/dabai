.deal-detail-page {
  padding-bottom: 60rpx;
}

.step-badge {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  flex: 0 0 52rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #2fce8e 0%, #0d9d6c 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
}

.step-content {
  padding-top: 6rpx;
  color: #18241d;
  font-size: 28rpx;
  line-height: 1.6;
}

.step-copy-box {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.step-code {
  font-size: 24rpx;
}

.step-copy-btn {
  height: 76rpx;
  font-size: 26rpx;
  color: #ffffff;
  background: #10b981;
}

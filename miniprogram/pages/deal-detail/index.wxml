<view class="cu-page page-shell deal-detail-page">
  <view class="hero hero-slim anim-up"></view>

  <view class="content-stack floating-stack">
    <block wx:if="{{loading}}">
      <view class="cu-card flex-direction gap-sm anim-up">
        <view class="skeleton-block skeleton-line"></view>
        <view class="skeleton-block skeleton-line half"></view>
        <view class="skeleton-block skeleton-line tall"></view>
        <view class="skeleton-block skeleton-line tall"></view>
      </view>
    </block>

    <view wx:elif="{{notFound}}" class="cu-card error-card flex-direction align-center anim-pop">
      <view class="error-icon">!</view>
      <view class="text-bold">线报不存在或已下线</view>
      <button class="cu-btn secondary block margin-top pressable" hover-class="pressed" bindtap="backToList">返回线报列表</button>
    </view>

    <block wx:else>
      <view class="cu-card flex-direction gap-sm anim-up">
        <view class="section-title">{{deal.title}}</view>
        <view wx:if="{{deal.summary}}" class="section-desc">{{deal.summary}}</view>
        <button class="cu-btn share-deal-btn block pressable margin-top-sm" hover-class="pressed" bindtap="openShareModal">
          <text class="share-deal-icon">📤</text> 分享给好友 / 朋友圈
        </button>
      </view>

      <view
        wx:for="{{deal.steps}}"
        wx:key="index"
        class="cu-card step-card anim-up delay-{{index < 4 ? index + 1 : 4}}"
      >
        <view class="flex align-start gap-sm">
          <view class="step-badge">{{index + 1}}</view>
          <view class="flex-sub">
            <view class="step-content">{{item.content}}</view>

            <view wx:if="{{item.images.length}}" class="step-images margin-top-sm">
              <image
                wx:for="{{item.images}}"
                wx:for-item="img"
                wx:key="*this"
                class="step-image"
                src="{{img}}"
                mode="aspectFill"
                bindtap="previewImage"
                data-urls="{{item.images}}"
                data-current="{{img}}"
              />
            </view>

            <video wx:if="{{item.videoUrl}}" class="step-video margin-top-sm" src="{{item.videoUrl}}" controls object-fit="contain"></video>

            <view wx:if="{{item.copyValue}}" class="step-copy-box margin-top-sm">
              <view class="code-box step-code text-cut-2">{{item.copyValue}}</view>
              <button
                class="cu-btn step-copy-btn pressable {{copiedIndex === index ? 'is-copied' : ''}}"
                hover-class="pressed"
                bindtap="copyStep"
                data-index="{{index}}"
              >{{copiedIndex === index ? '已复制 ✓' : '一键复制'}}</button>
            </view>
          </view>
        </view>
      </view>

      <view class="hint-bar anim-up delay-4">按步骤操作即可，遇到问题可在「我的」页联系客服。</view>
    </block>
  </view>

  <!-- 分享弹窗 -->
  <view wx:if="{{showShareModal}}" class="modal-overlay" bindtap="closeShareModal">
    <view class="modal-card" catchtap="stopProp">
      <view class="modal-title">分享这条线报</view>

      <view class="share-options">
        <button class="share-option pressable" hover-class="pressed" open-type="share" bindtap="closeShareModal">
          <view class="share-option-icon green">👥</view>
          <view class="share-option-text flex-sub">
            <view class="share-option-title">微信好友 / 群</view>
            <view class="share-option-desc">点击直接选择好友或群发送</view>
          </view>
          <view class="cu-arrow">›</view>
        </button>

        <view class="share-option pressable" hover-class="pressed" bindtap="showTimelineTutorial">
          <view class="share-option-icon orange">🌅</view>
          <view class="share-option-text flex-sub">
            <view class="share-option-title">分享到朋友圈</view>
            <view class="share-option-desc">查看教程，一步发到朋友圈</view>
          </view>
          <view class="cu-arrow">›</view>
        </view>
      </view>

      <view wx:if="{{showTimelineGuide}}" class="timeline-guide">
        <view class="timeline-guide-title">分享到朋友圈步骤</view>
        <view class="timeline-step"><text class="timeline-step-num">1</text>点击屏幕<text class="timeline-strong">右上角「⋯」</text></view>
        <view class="timeline-step"><text class="timeline-step-num">2</text>在弹出菜单里选择<text class="timeline-strong">「分享到朋友圈」</text></view>
        <view class="timeline-step"><text class="timeline-step-num">3</text>编辑文字后发布，好友下单你得积分</view>
        <view class="timeline-guide-tip">提示：微信规定朋友圈分享只能从「⋯」菜单发起，无法一键跳转，按上面三步即可。</view>
      </view>

      <button class="cu-btn secondary block margin-top pressable" hover-class="pressed" bindtap="closeShareModal">关闭</button>
    </view>
  </view>
</view>

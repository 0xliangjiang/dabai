<view class="cu-page">
  <view class="cu-section">
    <view class="cu-title">我的订单</view>
    <view class="cu-subtitle">佣金为预估展示，最终以订单结算和复核结果为准。</view>
  </view>

  <view wx:if="{{orders.length === 0}}" class="cu-card cu-empty flex align-center justify-center">
    <view>暂未匹配到订单</view>
  </view>

  <view wx:for="{{orders}}" wx:key="id" class="cu-card cu-section">
    <view class="flex align-start justify-between gap-sm">
      <view class="cu-label flex-sub text-cut-2">{{item.itemTitle}}</view>
      <view class="cu-tag orange">{{item.status}}</view>
    </view>
    <view class="cu-subtitle">预估佣金 <text class="money">¥{{item.estimatedCommission}}</text></view>
  </view>
</view>

<view class="cu-page page-shell">
  <view class="hero anim-up">
    <view class="eyebrow">优惠订单</view>
    <view class="hero-title">我的订单进度</view>
  </view>

  <view class="content-stack floating-stack">
    <view class="cu-card glass-card grid-2 anim-up delay-1">
      <view class="metric">
        <view class="muted text-sm">订单数量</view>
        <view class="metric-value">{{loading ? '—' : orders.length}}</view>
      </view>
      <view class="metric">
        <view class="muted text-sm">结算状态</view>
        <view class="metric-value">{{loading ? '—' : (orders.length ? '预估' : '暂无')}}</view>
      </view>
    </view>

    <block wx:if="{{loading}}">
      <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="cu-card flex-direction gap-sm anim-up delay-{{index + 1}}">
        <view class="skeleton-block skeleton-line"></view>
        <view class="skeleton-block skeleton-line half"></view>
        <view class="skeleton-block skeleton-line tall"></view>
      </view>
    </block>

    <view wx:elif="{{showEmpty}}" class="cu-card cu-empty flex-direction align-center justify-center anim-up delay-2">
      <view class="empty-icon">积</view>
      <view class="text-bold">暂未匹配到订单</view>
      <view class="section-desc">通过本小程序生成的打开内容下单后会显示在这里。</view>
    </view>

    <block wx:else>
      <view wx:for="{{orders}}" wx:key="id" class="cu-card product-card flex-direction gap anim-up delay-{{index < 4 ? index + 1 : 4}}">
        <view class="flex align-start justify-between gap-sm">
          <view class="section-title flex-sub text-cut-2">{{item.itemTitle}}</view>
          <view class="cu-tag orange">{{item.status}}</view>
        </view>
        <view class="soft-panel flex align-center justify-between">
          <view>
            <view class="muted text-sm">预估积分</view>
          </view>
          <view class="price">{{item.estimatedPoints}}<text class="points-unit"> 积分</text></view>
        </view>
      </view>
    </block>
  </view>
</view>

<view class="page">
  <view class="section">
    <view class="title">我的订单</view>
    <view class="subtitle">佣金为预估展示，最终以订单结算和复核结果为准。</view>
  </view>

  <view wx:if="{{orders.length === 0}}" class="panel">
    <t-empty description="暂未匹配到订单" />
  </view>

  <view wx:for="{{orders}}" wx:key="id" class="panel section">
    <view class="row">
      <view class="label">{{item.itemTitle}}</view>
      <t-tag theme="warning" variant="light">{{item.status}}</t-tag>
    </view>
    <view class="subtitle">预估佣金 <text class="money">¥{{item.estimatedCommission}}</text></view>
  </view>
</view>

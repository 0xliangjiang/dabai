<view class="cu-page page-shell">
  <view class="hero hero-slim anim-up"></view>

  <view class="content-stack floating-stack">
    <view class="cu-card glass-card grid-2 anim-up delay-1">
      <view class="metric">
        <view class="muted text-sm">已结算积分</view>
        <view class="metric-value">{{loading ? '—' : settledPoints}}</view>
      </view>
      <view class="metric">
        <view class="muted text-sm">预估待结算</view>
        <view class="metric-value">{{loading ? '—' : pendingPoints}}</view>
      </view>
    </view>

    <block wx:if="{{loading}}">
      <view wx:for="{{[1, 2, 3]}}" wx:key="*this" class="cu-card flex-direction gap-sm anim-up delay-{{index + 1}}">
        <view class="skeleton-block skeleton-line"></view>
        <view class="skeleton-block skeleton-line half"></view>
        <view class="skeleton-block skeleton-line tall"></view>
      </view>
    </block>

    <view wx:elif="{{showEmpty}}" class="cu-card cu-empty flex-direction align-center justify-center anim-up delay-2">
      <view class="empty-icon">积</view>
      <view class="text-bold">暂未匹配到订单</view>
      <view class="section-desc">下单后会显示在这里</view>
    </view>

    <block wx:else>
      <view wx:for="{{orders}}" wx:key="id" class="cu-card product-card flex-direction gap anim-up delay-{{index < 4 ? index + 1 : 4}}">
        <view class="flex align-start justify-between gap-sm">
          <view class="section-title flex-sub text-cut-2">{{item.itemTitle}}</view>
          <view class="cu-tag {{item.statusClass}}">{{item.statusLabel}}</view>
        </view>
        <view class="order-meta">
          <view class="order-meta-row">
            <view class="order-meta-label">下单时间</view>
            <view class="order-meta-value">{{item.payTimeText || '—'}}</view>
          </view>
          <view class="order-meta-row">
            <view class="order-meta-label">实付金额</view>
            <view class="order-meta-value">¥{{item.payAmountText}}</view>
          </view>
        </view>
        <view class="soft-panel flex align-center justify-between">
          <view class="muted text-sm">我的积分</view>
          <view class="flex align-center">
            <view class="price">{{item.points}}<text class="points-unit"> 积分</text></view>
            <text class="points-state {{item.settled ? 'settled' : 'pending'}}">{{item.rebateLabel}}</text>
          </view>
        </view>
        <view wx:if="{{item.canRefresh}}" class="flex align-center justify-between gap-sm refresh-row">
          <view class="muted text-sm">已确认收货？后台已结算可点此到账</view>
          <button
            class="cu-btn refresh-rebate-btn pressable {{item.refreshing ? 'is-loading' : ''}}"
            hover-class="pressed"
            loading="{{item.refreshing}}"
            bindtap="refreshRebate"
            data-id="{{item.id}}"
            data-index="{{index}}"
          >刷新返利</button>
        </view>
      </view>
    </block>
  </view>
</view>

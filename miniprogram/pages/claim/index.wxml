<view class="cu-page page-shell">
  <view class="hero">
    <view class="eyebrow">订单补充</view>
    <view class="hero-title">补充订单信息，方便人工复核</view>
    <view class="hero-desc">用于辅助复核，不会自动发放佣金，请尽量填写准确。</view>
  </view>

  <view class="cu-card cu-form floating-stack">
    <view class="hint-bar">只需要填写订单号末尾几位。截图不是必须，但有截图会更方便后台确认。</view>
    <view>
      <view class="cu-label margin-bottom-sm">订单后几位</view>
      <input class="cu-input" value="{{orderSuffix}}" placeholder="例如 1234" bindinput="onSuffixChange" />
    </view>
    <view>
      <view class="cu-label margin-bottom-sm">补充说明</view>
      <textarea class="cu-textarea" value="{{notes}}" placeholder="补充说明（选填）" auto-height bindinput="onNotesChange" />
    </view>
    <view class="cu-upload flex-direction align-center justify-center gap-sm" bindtap="onAddFile">
      <view class="cu-label">上传截图</view>
      <view class="muted text-sm">{{files.length ? "已选择 1 张截图" : "点击选择订单截图"}}</view>
    </view>
    <button wx:if="{{files.length}}" class="cu-btn secondary block" bindtap="onRemoveFile">移除截图</button>
    <button class="cu-btn primary block" bindtap="submit">提交复核</button>
  </view>
</view>

<view class="cu-page page-shell">
  <view class="hero hero-slim anim-up"></view>

  <view class="cu-card cu-form floating-stack anim-up delay-1">
    <view class="margin-bottom-sm muted text-sm">输入淘宝或京东的订单号，系统自动匹配并绑定积分。</view>
    <view>
      <view class="cu-label margin-bottom-sm">订单号</view>
      <input
        class="cu-input"
        value="{{orderNumber}}"
        placeholder="请输入完整订单号或末4位"
        type="number"
        bindinput="onOrderNumberChange"
      />
    </view>
    <button
      class="cu-btn primary block pressable"
      hover-class="pressed"
      loading="{{submitting}}"
      disabled="{{submitting}}"
      bindtap="submit"
    >{{submitting ? '绑定中…' : '立即绑定'}}</button>
  </view>

  <privacy-consent show="{{showPrivacy}}" bind:agree="onPrivacyAgree" bind:reject="onPrivacyReject" />
</view>

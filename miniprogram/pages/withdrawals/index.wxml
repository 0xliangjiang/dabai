<view class="cu-page page-shell">
  <view class="hero hero-slim anim-up"></view>

  <view class="content-stack floating-stack">
    <view class="cu-card flex align-center justify-between anim-up delay-1" style="padding: 28rpx 32rpx;">
      <view class="muted text-sm">当前可兑换余额</view>
      <view class="balance-inline">¥{{balanceText}}</view>
    </view>

    <view wx:if="{{loading}}" class="cu-card empty-card anim-up">加载中…</view>

    <view wx:elif="{{showEmpty}}" class="cu-card empty-card anim-up">
      <view class="empty-title">暂无兑换记录</view>
      <view class="muted text-sm margin-top-xs">在「我的」页面点击「积分兑换」即可发起申请</view>
    </view>

    <view wx:else class="cu-card anim-up delay-2">
      <view wx:for="{{list}}" wx:key="id" class="withdraw-record">
        <view class="flex align-center justify-between">
          <view class="withdraw-amount">-¥{{item.amountText}}</view>
          <view class="withdraw-status {{item.status}}">{{item.statusText}}</view>
        </view>
        <view class="record-meta flex align-center justify-between margin-top-xs">
          <view class="muted text-sm">{{item.payTypeText}} · {{item.payAccount}}</view>
          <view class="muted" style="font-size: 22rpx;">{{item.dateText}}</view>
        </view>
        <view wx:if="{{item.status === 'rejected' && item.notes}}" class="reject-note">驳回说明：{{item.notes}}</view>
      </view>
    </view>

    <view class="hint-bar anim-up delay-3">兑换申请提交后 3 个工作日内审核到账，节假日顺延；如有疑问可通过「我的 → 客服入口」联系我们。</view>
  </view>
</view>

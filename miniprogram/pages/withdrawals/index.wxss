.balance-inline {
  background: linear-gradient(150deg, #0c8a5b 0%, #07543c 80%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  font-size: 38rpx;
  font-weight: 900;
  letter-spacing: 0.5rpx;
}

.empty-card {
  padding: 64rpx 32rpx;
  text-align: center;
  color: #8aa093;
  font-size: 26rpx;
}

.empty-title {
  color: #3a4d42;
  font-size: 30rpx;
  font-weight: 700;
}

.reject-note {
  margin-top: 12rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: #fef2f2;
  color: #991b1b;
  font-size: 22rpx;
  line-height: 1.5;
}

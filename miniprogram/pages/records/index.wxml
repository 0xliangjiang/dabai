<view class="cu-page page-shell">
  <view class="hero">
    <view class="eyebrow">推广记录</view>
    <view class="hero-title">已生成的推广内容</view>
  </view>

  <view class="content-stack floating-stack">
    <view class="cu-card glass-card flex align-center justify-between">
      <view>
        <view class="muted text-sm">累计生成</view>
        <view class="metric-value">{{records.length}}</view>
      </view>
      <view class="cu-tag green">已记录</view>
    </view>

    <view wx:if="{{showEmpty}}" class="cu-card cu-empty flex-direction align-center justify-center">
      <view class="empty-icon">0</view>
      <view class="text-bold">还没有转链记录</view>
      <view class="section-desc">生成后会出现在这里。</view>
    </view>

    <view wx:for="{{records}}" wx:key="id" class="cu-card product-card flex-direction gap-sm">
      <view class="flex align-start gap">
        <image wx:if="{{item.itemImageUrl}}" class="product-thumb" src="{{item.itemImageUrl}}" mode="aspectFill" />
        <view wx:else class="product-thumb placeholder flex align-center justify-center">记录</view>
        <view class="flex-sub">
          <view class="flex align-center justify-between gap-sm">
            <view class="cu-tag blue">{{item.status}}</view>
            <view class="muted text-sm">{{item.createdAtText}}</view>
          </view>
          <view class="section-title margin-top-sm text-cut-2">{{item.itemTitle}}</view>
          <view class="flex align-center justify-between margin-top-sm">
            <view class="rate-badge">{{item.platformLabel}} · {{item.commissionPercent}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>

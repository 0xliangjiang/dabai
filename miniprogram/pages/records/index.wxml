<view class="page">
  <view class="section">
    <view class="title">推广记录</view>
    <view class="subtitle">查看你复制过的商品和预估收益状态。</view>
  </view>

  <view wx:if="{{records.length === 0}}" class="panel">
    <t-empty description="还没有转链记录" />
  </view>

  <view wx:for="{{records}}" wx:key="id" class="panel section">
    <view class="row">
      <view class="label">{{item.itemTitle}}</view>
      <t-tag theme="primary" variant="light">{{item.status}}</t-tag>
    </view>
    <view class="subtitle">{{item.createdAt}}</view>
  </view>
</view>

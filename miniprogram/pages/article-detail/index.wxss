page {
  background: #f4f8f5;
}

.article-page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(64rpx + env(safe-area-inset-bottom));
}

.article-shell {
  width: 100%;
  max-width: 960rpx;
  margin: 0 auto;
  overflow: hidden;
  border: 1rpx solid rgba(31, 60, 43, 0.08);
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(21, 70, 45, 0.08);
}

.article-cover {
  display: block;
  width: 100%;
  max-height: 760rpx;
  background: #e8f2ec;
}

.article-content {
  padding: 44rpx 36rpx 56rpx;
}

.article-title {
  color: #14231a;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1.3;
}

.article-summary {
  margin-top: 18rpx;
  color: #65736a;
  font-size: 27rpx;
  line-height: 1.7;
}

.article-meta {
  margin-top: 18rpx;
  padding-bottom: 28rpx;
  border-bottom: 1rpx solid #edf1ee;
  color: #91a098;
  font-size: 23rpx;
}

.article-blocks {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  padding-top: 34rpx;
}

.article-paragraph {
  white-space: pre-wrap;
  word-break: break-word;
  color: #26352c;
  font-size: 30rpx;
  line-height: 1.85;
}

.article-paragraph.is-bold {
  font-weight: 800;
}

.article-paragraph.is-italic {
  font-style: italic;
}

.align-left { text-align: left; }
.align-center { text-align: center; }
.align-right { text-align: right; }

.article-heading {
  color: #13261b;
  font-weight: 900;
  line-height: 1.45;
}

.article-heading.level-2 {
  padding-top: 12rpx;
  font-size: 38rpx;
}

.article-heading.level-3 {
  padding-top: 6rpx;
  font-size: 33rpx;
}

.article-image-block,
.article-image {
  width: 100%;
}

.article-image {
  display: block;
  border-radius: 12rpx;
  background: #e8f2ec;
}

.article-caption {
  margin-top: 12rpx;
  color: #89968e;
  font-size: 23rpx;
  line-height: 1.5;
  text-align: center;
}

.article-quote {
  padding: 24rpx 28rpx;
  border-left: 8rpx solid #19a974;
  background: #eef9f4;
  color: #355244;
  font-size: 28rpx;
  line-height: 1.75;
}

.article-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.article-list-item {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  color: #26352c;
  font-size: 29rpx;
  line-height: 1.75;
}

.article-list-marker {
  width: 44rpx;
  flex: 0 0 44rpx;
  color: #0a7a52;
  font-weight: 800;
}

.article-list-text {
  min-width: 0;
  flex: 1;
  word-break: break-word;
}

.article-callout {
  padding: 24rpx 28rpx;
  border: 1rpx solid #b8ddef;
  border-radius: 12rpx;
  background: #eef8fc;
  color: #244b5d;
  font-size: 27rpx;
  line-height: 1.7;
}

.article-callout.tone-success {
  border-color: #b8e4cf;
  background: #eef9f4;
  color: #24513e;
}

.article-callout.tone-warning {
  border-color: #f0d59d;
  background: #fff8e8;
  color: #694c18;
}

.article-callout-label {
  margin-bottom: 8rpx;
  font-weight: 900;
}

.article-divider {
  height: 1rpx;
  background: #e4ebe6;
}

.article-state {
  display: flex;
  min-height: 60vh;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.skeleton-article {
  padding: 28rpx;
}

.skeleton-article .cover {
  width: 100%;
  height: 320rpx;
  margin-bottom: 30rpx;
}

@media (min-width: 900px) {
  .article-page {
    padding-right: 48rpx;
    padding-left: 48rpx;
  }

  .article-content {
    padding-right: 64rpx;
    padding-left: 64rpx;
  }
}

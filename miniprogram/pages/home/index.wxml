<view class="cu-page">
  <view class="cu-section">
    <view class="cu-title">粘贴口令或链接</view>
    <view class="cu-subtitle">系统会生成你的专属推广口令和链接，复制后用于后续订单归因。</view>
  </view>

  <view class="cu-card cu-section cu-form">
    <view class="cu-label">淘宝内容</view>
    <textarea class="cu-textarea" value="{{rawContent}}" placeholder="粘贴淘宝口令、商品链接或短链" auto-height bindinput="onInput" />
    <button class="cu-btn bg-blue block" loading="{{loading}}" bindtap="convert">生成推广内容</button>
  </view>

  <view wx:if="{{result}}" class="cu-card cu-section flex-direction gap">
    <view class="flex align-start justify-between gap-sm">
      <view class="cu-label flex-sub text-cut-2">{{result.itemTitle}}</view>
      <view class="cu-tag green">可复制</view>
    </view>
    <view class="cu-subtitle">预估佣金以淘宝客结算结果为准。</view>
    <view class="flex-direction gap">
      <view>
        <view class="cu-label">淘口令</view>
        <view class="cu-subtitle result-code">{{result.generatedPassword}}</view>
      </view>
      <view>
        <view class="cu-label">推广链接</view>
        <view class="cu-subtitle result-code">{{result.generatedShortUrl || result.generatedClickUrl}}</view>
      </view>
    </view>
    <view class="flex gap-sm">
      <button class="cu-btn line-blue flex-sub" bindtap="copyPassword">复制口令</button>
      <button class="cu-btn bg-cyan flex-sub" bindtap="copyLink">复制链接</button>
    </view>
  </view>
</view>

<view class="cu-page page-shell">
  <view class="hero hero-slim anim-up"></view>

  <view class="content-stack floating-stack">
    <view wx:if="{{!enabled && !loading}}" class="cu-card error-card flex-direction align-center anim-pop">
      <view class="error-icon">!</view>
      <view class="text-bold">邀请活动暂未开启</view>
      <view class="section-desc margin-top-sm">敬请期待，开启后即可邀请好友赚提成</view>
    </view>

    <block wx:else>
      <!-- 收益概况 -->
      <view class="cu-card anim-up">
        <view class="section-title">我的邀请</view>
        <view class="section-desc">邀请好友使用小程序，TA 的返利你额外提成（不影响 TA 自己的返利）</view>
        <view class="invite-stats margin-top">
          <view class="invite-stat">
            <view class="invite-stat-value">{{downlineCount}}</view>
            <view class="invite-stat-label">已邀请好友</view>
          </view>
          <view class="invite-stat">
            <view class="invite-stat-value">{{earnedText}}</view>
            <view class="invite-stat-label">已到账提成(元)</view>
          </view>
          <view class="invite-stat">
            <view class="invite-stat-value">{{pendingText}}</view>
            <view class="invite-stat-label">待结算提成(元)</view>
          </view>
        </view>
      </view>

      <!-- 邀请按钮 -->
      <view class="cu-card anim-up delay-1">
        <button class="cu-btn primary block pressable" hover-class="pressed" bindtap="openShareModal">邀请好友 / 分享</button>
        <view class="invite-tip margin-top-sm">提成会自动并入你的积分余额，可在「我的」页查看与兑换。</view>
      </view>
    </block>
  </view>

  <!-- 分享弹窗 -->
  <view wx:if="{{showShareModal}}" class="modal-overlay" bindtap="closeShareModal">
    <view class="modal-card" catchtap="stopProp">
      <view class="modal-title">邀请好友</view>
      <view class="share-options">
        <button class="share-option pressable" hover-class="pressed" open-type="share" bindtap="closeShareModal">
          <view class="share-option-icon green">👥</view>
          <view class="share-option-text flex-sub">
            <view class="share-option-title">微信好友 / 群</view>
            <view class="share-option-desc">点击直接选择好友或群发送</view>
          </view>
          <view class="cu-arrow">›</view>
        </button>

        <view class="share-option pressable" hover-class="pressed" bindtap="showTimelineTutorial">
          <view class="share-option-icon orange">🌅</view>
          <view class="share-option-text flex-sub">
            <view class="share-option-title">分享到朋友圈</view>
            <view class="share-option-desc">查看教程，一步发到朋友圈</view>
          </view>
          <view class="cu-arrow">›</view>
        </view>
      </view>

      <view wx:if="{{showTimelineGuide}}" class="timeline-guide">
        <view class="timeline-guide-title">分享到朋友圈步骤</view>
        <view class="timeline-step"><text class="timeline-step-num">1</text>点击屏幕<text class="timeline-strong">右上角「⋯」</text></view>
        <view class="timeline-step"><text class="timeline-step-num">2</text>在弹出菜单里选择<text class="timeline-strong">「分享到朋友圈」</text></view>
        <view class="timeline-step"><text class="timeline-step-num">3</text>好友通过你的分享进来并下单，你得提成</view>
      </view>

      <button class="cu-btn secondary block margin-top pressable" hover-class="pressed" bindtap="closeShareModal">关闭</button>
    </view>
  </view>

  <privacy-consent show="{{showPrivacy}}" bind:agree="onPrivacyAgree" bind:reject="onPrivacyReject" />
</view>

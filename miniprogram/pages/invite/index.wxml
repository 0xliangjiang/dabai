<view class="cu-page page-shell">
  <view class="hero hero-slim anim-up">
    <view class="invite-badge">邀请有奖</view>
    <view class="invite-hero-title">邀请好友，赚返利提成</view>
    <view class="invite-hero-sub">好友下单，平台额外奖励你提成 · 不影响 TA 自己的返利</view>
  </view>

  <view class="content-stack floating-stack">
    <view wx:if="{{singlePageMode}}" class="cu-card timeline-entry-card anim-pop">
      <view class="entry-mark">好友邀请</view>
      <view class="entry-title">你收到了一份省钱邀请</view>
      <view class="entry-desc">进入完整小程序后，可使用微信安全登录。首次加入会自动绑定邀请关系，你的返利不会受到影响。</view>
      <view class="entry-steps">
        <view class="entry-step">
          <view class="entry-step-num">1</view>
          <view class="entry-step-text">
            <view class="entry-step-title">前往完整小程序</view>
            <view class="entry-step-desc">点击页面底部微信提供的「前往小程序」</view>
          </view>
        </view>
        <view class="entry-line"></view>
        <view class="entry-step">
          <view class="entry-step-num">2</view>
          <view class="entry-step-text">
            <view class="entry-step-title">登录并自动加入</view>
            <view class="entry-step-desc">阅读协议并授权登录后，即可开始查询优惠</view>
          </view>
        </view>
      </view>
      <view class="entry-safe">邀请参数已保留，进入后会自动完成绑定</view>
    </view>

    <view wx:elif="{{needsLogin}}" class="cu-card login-entry-card anim-pop">
      <view class="login-entry-icon">✓</view>
      <view class="entry-title">登录后接受好友邀请</view>
      <view class="entry-desc">登录仅用于保存你的优惠、订单和邀请关系。首次登录后，你会自动成为该好友邀请的用户。</view>
      <button class="cta-btn pressable" hover-class="pressed" loading="{{loggingIn}}" disabled="{{loggingIn}}" bindtap="startLogin">
        {{loggingIn ? "正在登录..." : "微信登录并加入"}}
      </button>
      <view wx:if="{{errorMsg}}" class="login-error">{{errorMsg}}</view>
      <view class="entry-agreement">继续即表示你已阅读并同意隐私政策与用户协议</view>
    </view>

    <block wx:elif="{{loading}}">
      <view class="cu-card flex-direction gap-sm anim-up">
        <view class="skeleton-block skeleton-line half"></view>
        <view class="skeleton-block invite-value-skeleton"></view>
        <view class="skeleton-block skeleton-line"></view>
      </view>
      <view class="cu-card flex-direction gap-sm anim-up delay-1">
        <view class="skeleton-block skeleton-line"></view>
        <view class="skeleton-block skeleton-line half"></view>
        <view class="skeleton-block skeleton-line tall"></view>
      </view>
    </block>

    <view wx:elif="{{errorMsg}}" class="cu-card error-card flex-direction align-center anim-pop">
      <view class="error-icon">!</view>
      <view class="text-bold">{{errorMsg}}</view>
      <button class="cu-btn secondary block margin-top pressable" hover-class="pressed" bindtap="retryLoad">重新加载</button>
    </view>

    <view wx:elif="{{!enabled}}" class="cu-card error-card flex-direction align-center anim-pop">
      <view class="error-icon">!</view>
      <view class="text-bold">邀请活动暂未开启</view>
      <view class="section-desc margin-top-sm">敬请期待，开启后即可邀请好友赚提成</view>
    </view>

    <block wx:else>
      <!-- 收益概况 -->
      <view class="cu-card earn-card anim-up">
        <view class="earn-label">累计已到账奖励值</view>
        <view class="earn-value">{{earnedText}}</view>
        <view class="earn-grid">
          <view class="earn-cell">
            <view class="earn-cell-num">{{downlineCount}}</view>
            <view class="earn-cell-cap">已邀请好友</view>
          </view>
          <view class="earn-divider"></view>
          <view class="earn-cell">
            <view class="earn-cell-num">{{pendingText}}</view>
            <view class="earn-cell-cap">待结算奖励值</view>
          </view>
        </view>
      </view>

      <!-- 邀请按钮 -->
      <view class="cu-card cta-card anim-up delay-1">
        <view class="cta-row">
          <view class="cta-emoji">🎁</view>
          <view class="flex-sub">
            <view class="cta-title">邀好友，赚提成</view>
            <view class="cta-sub">TA 每笔返利，你都能多拿一份奖励</view>
          </view>
        </view>
        <button class="cta-btn pressable" hover-class="pressed" bindtap="openShareModal">立即邀请好友</button>
        <view class="invite-tip">提成会自动并入你的奖励值，可在「我的」页查看与兑换</view>
      </view>

      <!-- 已邀请好友列表 -->
      <view class="cu-card anim-up delay-2">
        <view class="list-head">
          <view class="section-title">已邀请的好友</view>
          <view class="count-chip">{{downlineCount}} 人</view>
        </view>
        <view wx:if="{{downlines.length === 0}}" class="empty-friends">
          <view class="empty-friends-emoji">👥</view>
          <view class="invite-tip">还没有好友通过你的分享加入，快去邀请吧～</view>
        </view>
        <view wx:else class="downline-list">
          <view wx:for="{{downlines}}" wx:key="id" class="downline-row">
            <view class="downline-avatar">{{item.initial}}</view>
            <view class="downline-info flex-sub">
              <view class="downline-name">{{item.name}}</view>
              <view class="downline-date">{{item.joinedAt}} 加入</view>
            </view>
            <view class="downline-contrib">+{{item.contributedText}}<text class="dc-unit"> 奖励值</text></view>
          </view>
        </view>
        <view wx:if="{{loadingMore}}" class="list-footer muted">正在加载更多...</view>
        <view wx:elif="{{loadMoreError}}" class="list-footer">
          <text>{{loadMoreError}}</text>
          <button class="footer-retry pressable" hover-class="pressed" bindtap="retryLoadMore">重试</button>
        </view>
        <view wx:elif="{{downlines.length > 0 && !hasMore}}" class="list-footer muted">已经到底了</view>
      </view>
    </block>
  </view>

  <!-- 分享弹窗 -->
  <view wx:if="{{showShareModal}}" class="modal-overlay" bindtap="closeShareModal">
    <view class="modal-card" catchtap="stopProp">
      <view class="modal-title">邀请好友</view>
      <view class="share-options">
        <button class="share-option pressable" hover-class="pressed" open-type="share" bindtap="closeShareModal">
          <view class="share-option-icon green">👥</view>
          <view class="share-option-text flex-sub">
            <view class="share-option-title">微信好友 / 群</view>
            <view class="share-option-desc">点击直接选择好友或群发送</view>
          </view>
          <view class="cu-arrow">›</view>
        </button>

        <view class="share-option pressable" hover-class="pressed" bindtap="showTimelineTutorial">
          <view class="share-option-icon orange">🌅</view>
          <view class="share-option-text flex-sub">
            <view class="share-option-title">分享到朋友圈</view>
            <view class="share-option-desc">查看教程，一步发到朋友圈</view>
          </view>
          <view class="cu-arrow">›</view>
        </view>
      </view>

      <view wx:if="{{showTimelineGuide}}" class="timeline-guide">
        <view class="timeline-guide-title">分享到朋友圈步骤</view>
        <view class="timeline-step"><text class="timeline-step-num">1</text>点击屏幕<text class="timeline-strong">右上角「⋯」</text></view>
        <view class="timeline-step"><text class="timeline-step-num">2</text>在弹出菜单里选择<text class="timeline-strong">「分享到朋友圈」</text></view>
        <view class="timeline-step"><text class="timeline-step-num">3</text>好友通过你的分享进来并下单，你得提成</view>
      </view>

      <button class="cu-btn secondary block margin-top pressable" hover-class="pressed" bindtap="closeShareModal">关闭</button>
    </view>
  </view>

  <privacy-consent show="{{showPrivacy}}" bind:agree="onPrivacyAgree" bind:reject="onPrivacyReject" />
</view>

/* ---- Hero ---- */
.invite-badge {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.invite-hero-title {
  margin-top: 20rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
}

.invite-hero-sub {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.82);
}

/* ---- 收益概况卡 ---- */
.earn-card {
  text-align: center;
  background: linear-gradient(160deg, #ffffff 0%, #f4faf7 100%);
}

.earn-label {
  font-size: 24rpx;
  color: #8aa093;
}

.earn-value {
  margin-top: 8rpx;
  font-size: 76rpx;
  font-weight: 800;
  line-height: 1.1;
  color: #0a7a52;
  letter-spacing: 1rpx;
}

.earn-grid {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid #ecf3ee;
}

.earn-cell {
  flex: 1;
}

.earn-cell-num {
  font-size: 38rpx;
  font-weight: 700;
  color: #25372d;
}

.earn-cell-cap {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8aa093;
}

.earn-divider {
  width: 1rpx;
  height: 56rpx;
  background: #ecf3ee;
}

/* ---- 邀请 CTA ---- */
.cta-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.cta-emoji {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: linear-gradient(140deg, #f6e6b8 0%, #e8c476 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.cta-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #25372d;
}

.cta-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8aa093;
}

.cta-btn {
  margin-top: 24rpx;
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 20rpx;
  border: none;
  font-size: 31rpx;
  font-weight: 700;
  color: #5a3d08;
  background: linear-gradient(140deg, #f6e6b8 0%, #e8c476 46%, #cda44a 100%);
  box-shadow: 0 16rpx 30rpx -12rpx rgba(205, 164, 74, 0.6);
}

.cta-btn::after {
  border: none;
}

.invite-tip {
  margin-top: 18rpx;
  font-size: 23rpx;
  color: #8aa093;
  line-height: 1.5;
  text-align: center;
}

/* ---- 好友列表 ---- */
.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.count-chip {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #d9f6e8;
  color: #07684a;
  font-size: 22rpx;
  font-weight: 600;
}

.empty-friends {
  text-align: center;
  padding: 30rpx 0 10rpx;
}

.empty-friends-emoji {
  font-size: 56rpx;
  opacity: 0.5;
  margin-bottom: 8rpx;
}

.downline-list {
  margin-top: 12rpx;
}

.downline-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f4f1;
}

.downline-row:last-child {
  border-bottom: none;
}

.downline-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(150deg, #13c489 0%, #0a8f60 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.downline-name {
  font-size: 28rpx;
  color: #25372d;
  font-weight: 500;
}

.downline-date {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9aa0a6;
}

.downline-contrib {
  font-size: 30rpx;
  font-weight: 700;
  color: #0a7a52;
}

.dc-unit {
  font-size: 22rpx;
  font-weight: 500;
  margin-left: 2rpx;
}

/* ---- Hero ---- */
.invite-badge {
  display: inline-block;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #fff;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.invite-hero-title {
  margin-top: 20rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
}

.invite-hero-sub {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.82);
}

/* ---- 朋友圈单页模式 / 首次登录 ---- */
.timeline-entry-card,
.login-entry-card {
  padding: 42rpx 36rpx;
}

.entry-mark {
  display: inline-flex;
  align-items: center;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 8rpx;
  background: #e7f7ef;
  color: #087451;
  font-size: 22rpx;
  font-weight: 700;
}

.entry-title {
  margin-top: 24rpx;
  color: #193329;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.3;
}

.entry-desc {
  margin-top: 16rpx;
  color: #66796d;
  font-size: 25rpx;
  line-height: 1.75;
}

.entry-steps {
  margin-top: 32rpx;
  padding: 28rpx;
  border: 1rpx solid #deebe4;
  border-radius: 16rpx;
  background: #f8fbf9;
}

.entry-step {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.entry-step-num {
  display: flex;
  width: 52rpx;
  height: 52rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #0a7a52;
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
}

.entry-step-text {
  min-width: 0;
  flex: 1;
}

.entry-step-title {
  color: #25372d;
  font-size: 27rpx;
  font-weight: 700;
}

.entry-step-desc {
  margin-top: 5rpx;
  color: #7c8e83;
  font-size: 22rpx;
  line-height: 1.5;
}

.entry-line {
  width: 2rpx;
  height: 30rpx;
  margin: 8rpx 0 8rpx 25rpx;
  background: #c9ded3;
}

.entry-safe,
.entry-agreement {
  margin-top: 24rpx;
  color: #8aa093;
  font-size: 21rpx;
  line-height: 1.5;
  text-align: center;
}

.login-entry-card {
  text-align: center;
}

.login-entry-icon {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #dcf7e9;
  color: #087451;
  font-size: 44rpx;
  font-weight: 800;
}

.login-error {
  margin-top: 18rpx;
  color: #c2413b;
  font-size: 23rpx;
  line-height: 1.5;
}

/* ---- 收益概况卡 ---- */
.earn-card {
  text-align: center;
  background: linear-gradient(160deg, #ffffff 0%, #f4faf7 100%);
}

.invite-value-skeleton {
  width: 46%;
  height: 84rpx;
  margin: 12rpx auto;
}

.earn-label {
  font-size: 24rpx;
  color: #8aa093;
}

.earn-value {
  margin-top: 8rpx;
  font-size: 76rpx;
  font-weight: 800;
  line-height: 1.1;
  color: #0a7a52;
  letter-spacing: 1rpx;
}

.earn-grid {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding-top: 26rpx;
  border-top: 1rpx solid #ecf3ee;
}

.earn-cell {
  flex: 1;
}

.earn-cell-num {
  font-size: 38rpx;
  font-weight: 700;
  color: #25372d;
}

.earn-cell-cap {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8aa093;
}

.earn-divider {
  width: 1rpx;
  height: 56rpx;
  background: #ecf3ee;
}

/* ---- 邀请 CTA ---- */
.cta-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.cta-emoji {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  background: linear-gradient(140deg, #f6e6b8 0%, #e8c476 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.cta-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #25372d;
}

.cta-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #8aa093;
}

.cta-btn {
  margin: 24rpx 0 0;
  padding: 0;
  width: 100%;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 46rpx;
  border: none;
  font-size: 31rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #6b4a0b;
  background: linear-gradient(135deg, #ffdd86 0%, #f3b63f 100%);
  box-shadow: 0 14rpx 28rpx -12rpx rgba(224, 158, 39, 0.65);
}

.cta-btn::after {
  border: none;
}

.cta-btn.pressed {
  background: linear-gradient(135deg, #f5cf6f 0%, #e2a52f 100%);
}

.poster-entry-btn {
  display: flex;
  width: 100%;
  height: 76rpx;
  margin: 16rpx 0 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: 1rpx solid rgba(10, 122, 82, 0.24);
  border-radius: 38rpx;
  background: #f3faf6;
  color: #087451;
  font-size: 26rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.poster-entry-btn::after {
  border: 0;
}

.poster-entry-icon {
  font-size: 28rpx;
}

.share-option-icon.poster {
  background: #e7f4ef;
  color: #087451;
  font-size: 27rpx;
  font-weight: 800;
}

.invite-tip {
  margin-top: 18rpx;
  font-size: 23rpx;
  color: #8aa093;
  line-height: 1.5;
  text-align: center;
}

/* ---- 好友列表 ---- */
.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.count-chip {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  background: #d9f6e8;
  color: #07684a;
  font-size: 22rpx;
  font-weight: 600;
}

.empty-friends {
  text-align: center;
  padding: 30rpx 0 10rpx;
}

.empty-friends-emoji {
  font-size: 56rpx;
  opacity: 0.5;
  margin-bottom: 8rpx;
}

.downline-list {
  margin-top: 12rpx;
}

.downline-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f4f1;
}

.downline-row:last-child {
  border-bottom: none;
}

.downline-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(150deg, #13c489 0%, #0a8f60 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.downline-name {
  font-size: 28rpx;
  color: #25372d;
  font-weight: 500;
}

.downline-date {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9aa0a6;
}

.downline-contrib {
  font-size: 30rpx;
  font-weight: 700;
  color: #0a7a52;
}

.dc-unit {
  font-size: 22rpx;
  font-weight: 500;
  margin-left: 2rpx;
}

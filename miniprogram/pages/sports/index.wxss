.sports-page {
  display: flex;
  width: 100%;
  height: calc(100vh - 146rpx - env(safe-area-inset-bottom));
  min-height: 760rpx;
  padding: 20rpx 22rpx 0;
  flex-direction: column;
  gap: 14rpx;
  overflow: hidden;
  color: #102521;
  background: #f4f7f6;
  box-sizing: border-box;
}

.account-panel {
  display: flex;
  min-width: 0;
  min-height: 120rpx;
  padding: 15rpx 16rpx;
  flex: 0 0 120rpx;
  align-items: center;
  gap: 14rpx;
  border: 1rpx solid rgba(16, 58, 49, 0.08);
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow:
    0 20rpx 42rpx -32rpx rgba(17, 72, 61, 0.28),
    0 7rpx 16rpx -14rpx rgba(16, 37, 33, 0.16);
  box-sizing: border-box;
}

.account-emblem {
  position: relative;
  display: flex;
  width: 62rpx;
  height: 62rpx;
  flex: 0 0 62rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(0, 124, 97, 0.14);
  border-radius: 18rpx;
  background: #eaf8f3;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  box-sizing: border-box;
}

.emblem-line {
  position: relative;
  width: 30rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #007c61;
}

.emblem-line::before,
.emblem-line::after {
  position: absolute;
  top: -6rpx;
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid #00a97d;
  border-radius: 50%;
  background: #eaf8f3;
  content: "";
  box-sizing: border-box;
}

.emblem-line::before { left: -2rpx; }
.emblem-line::after { right: -2rpx; }

.account-summary {
  min-width: 0;
  flex: 1;
}

.account-heading {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 10rpx;
}

.account-label {
  color: #5f746e;
  font-size: 19rpx;
  font-weight: 500;
  line-height: 1.35;
}

.account-platform {
  color: #00a97d;
  font-family: "SFMono-Regular", Menlo, Consolas, monospace;
  font-size: 15rpx;
  font-weight: 600;
  line-height: 1.35;
  letter-spacing: 1rpx;
}

.account-name {
  margin-top: 2rpx;
  overflow: hidden;
  color: #102521;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-meta-row {
  display: flex;
  min-width: 0;
  margin-top: 2rpx;
  align-items: center;
  gap: 12rpx;
}

.account-meta,
.account-target {
  overflow: hidden;
  font-size: 17rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.account-meta {
  min-width: 0;
  color: #768983;
}

.account-target {
  flex: 0 0 auto;
  color: #007c61;
  font-weight: 600;
}

.bind-action {
  display: flex;
  width: 112rpx;
  min-width: 112rpx;
  max-width: 112rpx;
  min-height: 56rpx;
  margin: 0;
  padding: 0 15rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 0;
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 600;
  line-height: 1;
  box-sizing: border-box;
}

.bind-action::after,
.quick-target::after,
.quick-custom-action::after,
.recovery-ad-action::after,
.recovery-secondary-action::after,
.recovery-code-submit::after,
.send-button::after,
.manual-goal-preset::after,
.manual-goal-save::after,
.membership-header-action::after,
.membership-dialog-plan::after,
.dialog-close::after,
.dialog-primary::after { border: 0; }

.bind-action.is-bound {
  color: #007c61;
  background: #e5f7f0;
}

.bind-action.is-unbound {
  color: #ffffff;
  background: #00a97d;
  box-shadow: 0 9rpx 18rpx -12rpx rgba(0, 124, 97, 0.7);
}

.bind-action.is-loading { opacity: 0.72; }
.bind-action.is-pressed { transform: scale(0.97); }

.bind-status-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
}

.bind-title { white-space: nowrap; }

.chat-panel {
  display: flex;
  min-height: 0;
  flex: 1;
  flex-direction: column;
  overflow: hidden;
  border: 1rpx solid rgba(16, 58, 49, 0.08);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow:
    0 24rpx 48rpx -34rpx rgba(17, 72, 61, 0.32),
    0 8rpx 20rpx -18rpx rgba(16, 37, 33, 0.18);
}

.chat-header {
  display: flex;
  min-height: 82rpx;
  padding: 12rpx 20rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-bottom: 1rpx solid #e6eeeb;
  box-sizing: border-box;
}

.assistant-identity {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  gap: 12rpx;
}

.assistant-avatar,
.message-avatar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(0, 124, 97, 0.14);
  background: #eaf8f3;
  box-sizing: border-box;
}

.assistant-avatar {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  border-radius: 15rpx;
}

.activity-line,
.message-avatar-mark {
  position: relative;
  width: 26rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #007c61;
}

.activity-line::before,
.activity-line::after,
.message-avatar-mark::before,
.message-avatar-mark::after {
  position: absolute;
  top: -4rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #00a97d;
  content: "";
}

.activity-line::before,
.message-avatar-mark::before { left: -1rpx; }
.activity-line::after,
.message-avatar-mark::after { right: -1rpx; }

.assistant-copy { min-width: 0; }

.assistant-name {
  color: #102521;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.25;
}

.assistant-state {
  margin-top: 2rpx;
  overflow: hidden;
  color: #7a8d87;
  font-size: 17rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chat-header-actions {
  display: flex;
  min-width: 0;
  flex: 0 0 auto;
  align-items: center;
  gap: 16rpx;
}

.membership-header-action {
  display: flex;
  min-width: 138rpx;
  min-height: 56rpx;
  margin: 0;
  padding: 0 15rpx 0 11rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 1rpx solid rgba(0, 124, 97, 0.14);
  border-radius: 999rpx;
  color: #007c61;
  background: #eaf8f3;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.92),
    0 0 0 1rpx rgba(0, 124, 97, 0.025);
  line-height: 1;
  box-sizing: border-box;
  transition: transform 120ms cubic-bezier(0.23, 1, 0.32, 1), background-color 120ms cubic-bezier(0.23, 1, 0.32, 1);
}

.membership-header-action.is-pressed {
  background: #def3eb;
  transform: scale(0.97);
}

.membership-header-icon {
  position: relative;
  display: flex;
  width: 30rpx;
  height: 30rpx;
  flex: 0 0 30rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #00a97d;
  border-radius: 50%;
  box-sizing: border-box;
}

.membership-header-icon::before,
.membership-header-icon::after {
  position: absolute;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: #00a97d;
  content: "";
}

.membership-header-icon::before { top: 4rpx; left: 5rpx; }
.membership-header-icon::after { right: 5rpx; bottom: 4rpx; }

.membership-header-icon-core {
  width: 9rpx;
  height: 9rpx;
  border-radius: 3rpx;
  background: #007c61;
  transform: rotate(45deg);
}

.membership-header-label {
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}

.system-state {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 7rpx;
  color: #698078;
  font-family: "SFMono-Regular", Menlo, Consolas, monospace;
  font-size: 15rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.system-state-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #00a97d;
  box-shadow: 0 0 0 5rpx rgba(0, 169, 125, 0.09);
}

.manual-goal-icon {
  position: relative;
  display: flex;
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(0, 124, 97, 0.14);
  border-radius: 15rpx;
  background: #eaf8f3;
  box-sizing: border-box;
}

.manual-goal-icon-core {
  position: relative;
  width: 25rpx;
  height: 25rpx;
  border: 3rpx solid #00a97d;
  border-radius: 50%;
  box-sizing: border-box;
}

.manual-goal-icon-core::before {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: 7rpx;
  height: 7rpx;
  border-radius: 50%;
  background: #007c61;
  content: "";
}

.manual-goal-panel {
  display: flex;
  min-height: 0;
  flex: 1;
  flex-direction: column;
  overflow-y: auto;
  background: #fbfdfc;
}

.manual-goal-current {
  display: flex;
  min-height: 260rpx;
  padding: 30rpx 28rpx;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-bottom: 1rpx solid #e6eeeb;
  text-align: center;
  box-sizing: border-box;
}

.manual-goal-current-label { color: #71857e; font-size: 19rpx; font-weight: 500; line-height: 1.5; }
.manual-goal-current-value { display: flex; min-width: 0; margin-top: 8rpx; align-items: baseline; justify-content: center; gap: 8rpx; color: #102521; font-family: "SFMono-Regular", Menlo, Consolas, monospace; font-size: 52rpx; font-weight: 600; line-height: 1.2; font-variant-numeric: tabular-nums; }
.manual-goal-current-unit { color: #60766e; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 20rpx; font-weight: 500; }
.manual-goal-current-note { max-width: 520rpx; margin-top: 14rpx; color: #7b8e88; font-size: 18rpx; line-height: 1.6; }

.manual-goal-form { padding: 26rpx 28rpx 30rpx; flex: 0 0 auto; background: #ffffff; }
.manual-goal-label { color: #29443b; font-size: 20rpx; font-weight: 600; line-height: 1.5; }
.manual-goal-label.is-custom { margin-top: 22rpx; }
.manual-goal-presets { display: flex; margin-top: 12rpx; gap: 12rpx; }
.manual-goal-preset {
  height: 64rpx;
  margin: 0;
  padding: 0 20rpx;
  flex: 1;
  border: 1rpx solid #d7e3df;
  border-radius: 14rpx;
  color: #405951;
  background: #ffffff;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 64rpx;
  font-variant-numeric: tabular-nums;
  box-sizing: border-box;
  transition: transform 120ms cubic-bezier(0.23, 1, 0.32, 1), border-color 120ms ease, background-color 120ms ease;
}

.manual-goal-preset.is-selected { border-color: rgba(0, 169, 125, 0.42); color: #007c61; background: #eaf8f3; }
.manual-goal-preset.is-pressed { transform: scale(0.98); }

.manual-goal-input-row {
  display: flex;
  width: 100%;
  min-height: 72rpx;
  margin-top: 12rpx;
  padding: 4rpx 4rpx 4rpx 18rpx;
  align-items: center;
  gap: 10rpx;
  border: 1rpx solid #d3e1dc;
  border-radius: 15rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.manual-goal-input-row.is-focused { border-color: rgba(0, 169, 125, 0.62); box-shadow: 0 0 0 3rpx rgba(0, 169, 125, 0.08); }
.manual-goal-input-row.has-error { border-color: rgba(181, 55, 45, 0.48); }
.manual-goal-input { width: 0; min-width: 0; height: 60rpx; padding: 0; flex: 1; color: #102521; font-family: "SFMono-Regular", Menlo, Consolas, monospace; font-size: 25rpx; line-height: 60rpx; font-variant-numeric: tabular-nums; box-sizing: border-box; }
.manual-goal-placeholder { color: #9aaaa5; }
.manual-goal-input-unit { flex: 0 0 auto; color: #6e817a; font-size: 18rpx; line-height: 1; }
.manual-goal-save { display: flex; width: 132rpx; min-width: 132rpx; height: 60rpx; margin: 0; padding: 0 14rpx; flex: 0 0 132rpx; align-items: center; justify-content: center; border: 0; border-radius: 12rpx; color: #ffffff; background: #00a97d; font-size: 19rpx; font-weight: 600; line-height: 1; white-space: nowrap; box-sizing: border-box; }
.manual-goal-save.is-disabled { color: #9caaa5; background: #edf1ef; }
.manual-goal-save.is-pressed { transform: scale(0.97); }
.manual-goal-helper,
.manual-goal-error { min-height: 32rpx; margin-top: 9rpx; font-size: 16rpx; line-height: 1.5; }
.manual-goal-helper { color: #879993; }
.manual-goal-error { color: #a23b32; }

.goal-dashboard {
  display: grid;
  min-height: 246rpx;
  padding: 18rpx 22rpx;
  flex: 0 0 auto;
  grid-template-columns: minmax(250rpx, 0.98fr) minmax(0, 1.02fr);
  align-items: center;
  gap: 20rpx;
  background: #fbfdfc;
  border-bottom: 1rpx solid #e6eeeb;
  box-sizing: border-box;
}

.goal-ring-wrap {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: center;
}

.goal-ring {
  position: relative;
  display: flex;
  width: 198rpx;
  height: 198rpx;
  align-items: center;
  justify-content: center;
  border: 11rpx solid #dfe9e6;
  border-radius: 50%;
  background: #ffffff;
  box-shadow:
    inset 0 0 0 1rpx rgba(16, 58, 49, 0.06),
    0 20rpx 34rpx -26rpx rgba(0, 124, 97, 0.4);
  box-sizing: border-box;
}

.goal-ring::before {
  position: absolute;
  inset: -11rpx;
  border: 11rpx solid transparent;
  border-top-color: #00a97d;
  border-right-color: #00a97d;
  border-bottom-color: rgba(0, 169, 125, 0.34);
  border-radius: 50%;
  content: "";
  transform: rotate(20deg);
}

.goal-ring:not(.has-target)::before {
  border-top-color: #b9cac4;
  border-right-color: transparent;
  border-bottom-color: transparent;
}

.goal-ring-core {
  position: relative;
  z-index: 1;
  min-width: 0;
  text-align: center;
}

.goal-kicker {
  color: #778b84;
  font-size: 17rpx;
  font-weight: 500;
  line-height: 1.4;
}

.goal-number {
  margin-top: 2rpx;
  overflow: hidden;
  color: #102521;
  font-family: "SFMono-Regular", Menlo, Consolas, monospace;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: -2rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.goal-unit {
  margin-top: 2rpx;
  color: #007c61;
  font-size: 16rpx;
  font-weight: 600;
  line-height: 1.4;
}

.goal-data { min-width: 0; }

.goal-data-head,
.goal-stat {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.goal-data-head {
  padding-bottom: 11rpx;
  border-bottom: 1rpx solid #dce8e4;
}

.goal-data-title {
  color: #29443b;
  font-size: 20rpx;
  font-weight: 600;
}

.goal-data-badge {
  padding: 5rpx 9rpx;
  border-radius: 8rpx;
  color: #7b6a43;
  background: #f5eedf;
  font-size: 15rpx;
  font-weight: 600;
  line-height: 1.25;
}

.goal-data-badge.is-ready {
  color: #007c61;
  background: #e5f7f0;
}

.goal-stat {
  padding-top: 10rpx;
}

.goal-stat-label {
  flex: 0 0 auto;
  color: #7a8d87;
  font-size: 16rpx;
  line-height: 1.35;
}

.goal-stat-value {
  min-width: 0;
  overflow: hidden;
  color: #3e554d;
  font-size: 17rpx;
  font-weight: 600;
  line-height: 1.35;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.goal-stat-value.is-positive { color: #007c61; }

.goal-hint {
  margin-top: 11rpx;
  color: #879993;
  font-size: 15rpx;
  line-height: 1.5;
}

.quick-targets {
  padding: 14rpx 22rpx 16rpx;
  flex: 0 0 auto;
  border-bottom: 1rpx solid #e6eeeb;
  background: #ffffff;
}

.quick-targets-head {
  display: flex;
  width: 100%;
  min-width: 0;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
}

.quick-targets-title {
  min-width: 0;
  flex: 1;
  color: #29443b;
  font-size: 19rpx;
  font-weight: 600;
}

.quick-custom-action {
  display: flex;
  width: 132rpx;
  min-width: 132rpx;
  min-height: 44rpx;
  margin-top: 0;
  margin-right: 0;
  margin-bottom: 0;
  margin-left: 0;
  padding: 0 11rpx;
  flex: 0 0 132rpx;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 10rpx;
  color: #007c61;
  background: #eaf8f3;
  font-size: 16rpx;
  font-weight: 600;
  line-height: 44rpx;
  box-sizing: border-box;
}

.quick-custom-action.is-pressed {
  background: #dcf2ea;
  transform: scale(0.97);
}

.quick-targets-row {
  display: grid;
  margin-top: 10rpx;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 9rpx;
}

.quick-target {
  display: flex;
  min-width: 0;
  height: 68rpx;
  margin: 0;
  padding: 8rpx 11rpx;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid #dce8e4;
  border-radius: 14rpx;
  color: #102521;
  background: #ffffff;
  text-align: left;
  line-height: 1;
  box-sizing: border-box;
}

.quick-target.is-pressed {
  border-color: rgba(0, 169, 125, 0.36);
  background: #e5f7f0;
  transform: scale(0.97);
}

.quick-target-copy { min-width: 0; }

.quick-target-main {
  display: flex;
  min-width: 0;
  align-items: baseline;
  gap: 4rpx;
}

.quick-target-value {
  overflow: hidden;
  font-family: "SFMono-Regular", Menlo, Consolas, monospace;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: -1rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.quick-target-unit {
  color: #60766e;
  font-size: 15rpx;
  font-weight: 500;
}

.quick-target-caption {
  display: block;
  margin-top: 2rpx;
  color: #8a9b95;
  font-size: 14rpx;
  line-height: 1.25;
}

.chat-scroll {
  min-height: 0;
  flex: 1;
  background-color: #f5f7f7;
  background-image:
    linear-gradient(rgba(16, 58, 49, 0.025) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(16, 58, 49, 0.025) 1rpx, transparent 1rpx);
  background-size: 36rpx 36rpx;
}

.chat-content {
  display: flex;
  min-height: 100%;
  padding: 20rpx 22rpx 28rpx;
  flex-direction: column;
  gap: 20rpx;
  box-sizing: border-box;
}

.empty-conversation {
  display: flex;
  margin: 12rpx 0 0;
  padding: 18rpx;
  align-items: center;
  gap: 14rpx;
  border: 1rpx solid rgba(0, 124, 97, 0.08);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.72);
}

.empty-conversation-mark {
  position: relative;
  width: 38rpx;
  height: 38rpx;
  flex: 0 0 38rpx;
  border: 4rpx solid #00a97d;
  border-radius: 50%;
  box-sizing: border-box;
}

.empty-conversation-mark::after {
  position: absolute;
  right: -5rpx;
  bottom: -3rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #102521;
  content: "";
}

.empty-conversation-copy { min-width: 0; }
.empty-conversation-title { color: #29443b; font-size: 19rpx; font-weight: 600; line-height: 1.35; }
.empty-conversation-text { margin-top: 3rpx; color: #7b8e88; font-size: 16rpx; line-height: 1.5; }

.message-row {
  display: flex;
  min-width: 0;
  align-items: flex-start;
  gap: 10rpx;
}

.message-row.is-user { flex-direction: row-reverse; }
.message-row.is-user .message-author { text-align: right; }
.message-row.is-user .message-avatar { background: #102521; border-color: #102521; }
.message-row.is-user .message-bubble { border-color: #102521; border-radius: 17rpx 6rpx 17rpx 17rpx; color: #ffffff; background: #102521; }

.message-avatar {
  width: 36rpx;
  height: 36rpx;
  flex: 0 0 36rpx;
  border-radius: 11rpx;
}

.message-avatar-mark { width: 17rpx; height: 2rpx; }
.message-avatar-mark::before,
.message-avatar-mark::after { top: -3rpx; width: 8rpx; height: 8rpx; }
.message-avatar-mark.is-user { width: 9rpx; height: 9rpx; border-radius: 50%; background: #ffffff; }
.message-avatar-mark.is-user::before,
.message-avatar-mark.is-user::after { display: none; }

.message-group { min-width: 0; max-width: 88%; }
.message-author { margin-bottom: 5rpx; color: #7d8f89; font-size: 16rpx; font-weight: 500; line-height: 1.3; }

.message-bubble {
  padding: 15rpx 18rpx;
  border: 1rpx solid #dce8e4;
  border-radius: 6rpx 17rpx 17rpx 17rpx;
  color: #344c43;
  background: #ffffff;
  font-size: 21rpx;
  line-height: 1.58;
  white-space: pre-wrap;
  word-break: break-word;
  box-sizing: border-box;
}

.message-bubble.is-success { border-color: rgba(0, 169, 125, 0.2); color: #075d49; background: #e8f8f2; }
.typing-bubble { display: flex; min-width: 86rpx; align-items: center; gap: 7rpx; }
.typing-dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: #7f938c; animation: typing-pulse 1.1s cubic-bezier(0.23, 1, 0.32, 1) infinite; }
.typing-dot:nth-child(2) { animation-delay: 0.15s; }
.typing-dot:nth-child(3) { animation-delay: 0.3s; }

.composer-wrap {
  flex: 0 0 auto;
  padding: 10rpx 14rpx 14rpx;
  border-top: 1rpx solid #e6eeeb;
  background: #ffffff;
}

.composer-notice {
  display: flex;
  margin-bottom: 8rpx;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  color: #7d8f89;
  font-size: 17rpx;
  line-height: 1.4;
}

.notice-dot { width: 7rpx; height: 7rpx; border-radius: 50%; background: #9b6829; }

.composer {
  display: flex;
  min-height: 68rpx;
  padding: 4rpx 4rpx 4rpx 15rpx;
  align-items: center;
  gap: 8rpx;
  border: 1rpx solid #d3e1dc;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  transition: border-color 150ms cubic-bezier(0.23, 1, 0.32, 1), box-shadow 150ms cubic-bezier(0.23, 1, 0.32, 1);
  box-sizing: border-box;
}

.composer.is-focused { border-color: rgba(0, 169, 125, 0.62); box-shadow: 0 0 0 3rpx rgba(0, 169, 125, 0.08); }
.composer.is-disabled { opacity: 0.72; }

.composer-input {
  min-width: 0;
  height: 56rpx;
  min-height: 56rpx;
  padding: 0;
  flex: 1;
  color: #29443b;
  font-size: 21rpx;
  line-height: 56rpx;
  box-sizing: border-box;
}

.composer-placeholder { color: #97a7a2; }

.send-button {
  display: flex;
  width: 88rpx;
  min-width: 88rpx;
  height: 56rpx;
  margin: 0;
  padding: 0;
  flex: 0 0 88rpx;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 13rpx;
  line-height: 1;
  box-sizing: border-box;
}

.send-button.is-disabled { color: #a0ada8; background: #eef2f0; }
.send-button.is-active { color: #ffffff; background: #00a97d; box-shadow: 0 9rpx 18rpx -12rpx rgba(0, 124, 97, 0.76); }
.send-button.is-active:active { transform: scale(0.97); }
.send-label { font-size: 19rpx; font-weight: 600; line-height: 1; }

/* ---- 会员到期恢复 ---- */
.expiry-recovery {
  flex: 0 0 auto;
  padding: 18rpx 20rpx 20rpx;
  border-top: 1rpx solid rgba(147, 105, 40, 0.12);
  border-bottom: 1rpx solid rgba(16, 58, 49, 0.08);
  background:
    radial-gradient(280rpx 150rpx at 100% 0%, rgba(214, 180, 95, 0.13) 0%, rgba(214, 180, 95, 0) 70%),
    #fbfcf9;
}

.recovery-head {
  display: flex;
  min-width: 0;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.recovery-copy,
.recovery-action-copy { min-width: 0; flex: 1; }
.recovery-title { color: #18372e; font-size: 23rpx; font-weight: 600; line-height: 1.42; }
.recovery-subtitle { margin-top: 4rpx; color: #71827b; font-size: 17rpx; line-height: 1.5; }

.recovery-reward {
  flex: 0 0 auto;
  padding: 6rpx 11rpx;
  border: 1rpx solid rgba(176, 132, 54, 0.16);
  border-radius: 999rpx;
  color: #8a6527;
  background: #f8edcf;
  font-size: 16rpx;
  font-weight: 600;
  line-height: 1.35;
  font-variant-numeric: tabular-nums;
}

.recovery-ad-action,
.recovery-secondary-action {
  display: flex;
  min-width: 0;
  margin: 0;
  align-items: center;
  text-align: left;
  box-sizing: border-box;
}

.recovery-ad-action {
  width: 100%;
  min-height: 82rpx;
  margin-top: 15rpx;
  padding: 11rpx 15rpx;
  gap: 13rpx;
  border: 1rpx solid rgba(0, 124, 97, 0.12);
  border-radius: 17rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #0b8f69 0%, #07664c 100%);
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.18),
    0 12rpx 22rpx -16rpx rgba(5, 75, 54, 0.66);
  transition: transform 140ms cubic-bezier(0.23, 1, 0.32, 1), opacity 140ms cubic-bezier(0.23, 1, 0.32, 1);
}

.recovery-ad-action.is-pressed { transform: scale(0.985); }
.recovery-ad-action.is-loading { opacity: 0.76; }
.recovery-ad-action.is-unlocked { background: linear-gradient(145deg, #087a5b 0%, #075640 100%); }

.recovery-action-icon {
  display: flex;
  width: 44rpx;
  height: 44rpx;
  flex: 0 0 44rpx;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
}

.recovery-action-icon.is-ad { color: #0a7657; background: rgba(255, 255, 255, 0.9); }
.recovery-action-icon.is-code { color: #8b6527; background: #f7ebcd; }
.recovery-action-icon.is-invite { color: #087354; background: #e2f3ec; }
.recovery-ad-action .recovery-action-title { color: #ffffff; }
.recovery-ad-action .recovery-action-meta { color: rgba(255, 255, 255, 0.7); }
.recovery-action-title { overflow: hidden; color: #244339; font-size: 19rpx; font-weight: 600; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.recovery-action-meta { overflow: hidden; margin-top: 1rpx; color: #75877f; font-size: 15rpx; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.recovery-action-arrow { flex: 0 0 auto; color: rgba(255, 255, 255, 0.84); font-size: 25rpx; line-height: 1; }

.recovery-secondary-actions {
  display: grid;
  margin-top: 9rpx;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 9rpx;
}

.recovery-secondary-action {
  width: 100%;
  min-height: 70rpx;
  padding: 9rpx 12rpx;
  gap: 10rpx;
  border: 1rpx solid rgba(16, 58, 49, 0.09);
  border-radius: 15rpx;
  color: #244339;
  background: rgba(255, 255, 255, 0.86);
  transition: transform 120ms cubic-bezier(0.23, 1, 0.32, 1), border-color 120ms cubic-bezier(0.23, 1, 0.32, 1);
}

.recovery-secondary-action.is-pressed { transform: scale(0.98); border-color: rgba(0, 124, 97, 0.22); }

.recovery-code-form {
  display: flex;
  min-width: 0;
  margin-top: 10rpx;
  padding: 7rpx;
  align-items: center;
  gap: 8rpx;
  border: 1rpx solid rgba(0, 124, 97, 0.18);
  border-radius: 15rpx;
  background: #ffffff;
  box-shadow: 0 0 0 3rpx rgba(0, 169, 125, 0.05);
}

.recovery-code-input {
  min-width: 0;
  height: 54rpx;
  padding: 0 11rpx;
  flex: 1;
  color: #244339;
  font-family: "SFMono-Regular", Menlo, Consolas, monospace;
  font-size: 18rpx;
  line-height: 54rpx;
  box-sizing: border-box;
}

.recovery-code-submit {
  width: 88rpx;
  min-width: 88rpx;
  height: 54rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 11rpx;
  color: #ffffff;
  background: #0a8764;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 54rpx;
}

.recovery-code-submit.is-disabled { color: #98a6a1; background: #edf2ef; }
.composer-notice.is-expired { color: #8a6527; }

@keyframes typing-pulse {
  0%, 60%, 100% { opacity: 0.35; transform: translateY(0); }
  30% { opacity: 1; transform: translateY(-3rpx); }
}

.membership-overlay {
  position: fixed;
  z-index: 1250;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  padding: 28rpx;
  align-items: center;
  justify-content: center;
  background: rgba(12, 32, 27, 0.56);
  box-sizing: border-box;
}

.membership-dialog {
  width: 100%;
  max-width: 640rpx;
  max-height: calc(100vh - 56rpx);
  padding: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(16, 58, 49, 0.1);
  border-radius: 26rpx;
  background: #ffffff;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.94),
    0 30rpx 76rpx -24rpx rgba(8, 47, 38, 0.4),
    0 0 0 1rpx rgba(0, 124, 97, 0.025);
  box-sizing: border-box;
}

.membership-dialog-heading { min-width: 0; flex: 1; }
.membership-dialog-subtitle { margin-top: 3rpx; color: #6e827d; font-size: 19rpx; line-height: 1.5; }

.membership-dialog-plans {
  display: flex;
  width: 100%;
  min-width: 0;
  margin-top: 16rpx;
  flex-wrap: wrap;
  gap: 12rpx;
  box-sizing: border-box;
}

.membership-dialog-plan {
  display: flex;
  width: 100%;
  min-width: 0;
  min-height: 148rpx;
  margin: 0;
  padding: 16rpx;
  overflow: hidden;
  flex: 0 0 calc(50% - 6rpx);
  flex-direction: column;
  justify-content: space-between;
  border: 1rpx solid rgba(16, 58, 49, 0.1);
  border-radius: 18rpx;
  color: #102521;
  background: #f7faf9;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.92),
    0 0 0 1rpx rgba(0, 124, 97, 0.02);
  text-align: left;
  line-height: 1.25;
  box-sizing: border-box;
  transition: transform 120ms cubic-bezier(0.23, 1, 0.32, 1), border-color 120ms cubic-bezier(0.23, 1, 0.32, 1), opacity 120ms cubic-bezier(0.23, 1, 0.32, 1);
}

.membership-dialog-plan.is-permanent {
  border-color: rgba(0, 124, 97, 0.2);
  background: #eaf8f3;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.84),
    0 12rpx 24rpx -22rpx rgba(0, 124, 97, 0.42);
}

.membership-dialog-plan.is-pressed { transform: scale(0.97); border-color: rgba(0, 124, 97, 0.28); }
.membership-dialog-plan.is-loading { opacity: 0.7; }
.membership-dialog-plan-head { display: flex; min-width: 0; align-items: center; justify-content: space-between; gap: 8rpx; }
.membership-dialog-plan-label { min-width: 0; flex: 1; color: #102521; font-size: 26rpx; font-weight: 600; }
.membership-dialog-plan-badge { flex: 0 0 auto; padding: 4rpx 8rpx; border-radius: 999rpx; color: #007c61; background: rgba(0, 169, 125, 0.11); font-size: 14rpx; font-weight: 600; white-space: nowrap; }
.membership-dialog-plan-days { margin-top: 5rpx; color: #6e827d; font-size: 18rpx; line-height: 1.5; }
.membership-dialog-plan-footer { display: flex; min-width: 0; margin-top: 12rpx; align-items: flex-end; justify-content: space-between; gap: 8rpx; }
.membership-dialog-plan-price { min-width: 0; color: #007c61; font-size: 29rpx; font-weight: 600; white-space: nowrap; font-variant-numeric: tabular-nums; }
.membership-dialog-plan-currency { margin-right: 2rpx; font-size: 19rpx; }
.membership-dialog-plan-buy { flex: 0 0 auto; padding: 5rpx 9rpx; border-radius: 999rpx; color: #007c61; background: #e5f7f0; font-size: 15rpx; font-weight: 600; line-height: 1; }
.membership-dialog-plan.is-permanent .membership-dialog-plan-buy { color: #ffffff; background: #00a97d; }

.membership-dialog-note {
  display: flex;
  min-width: 0;
  margin-top: 14rpx;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #70847e;
  font-size: 17rpx;
  line-height: 1.5;
  text-align: center;
}

.membership-dialog-note-dot { width: 8rpx; height: 8rpx; flex: 0 0 8rpx; border-radius: 50%; background: #00a97d; }

.binding-overlay {
  position: fixed;
  z-index: 1200;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  padding: 40rpx;
  align-items: center;
  justify-content: center;
  background: rgba(12, 32, 27, 0.54);
  box-sizing: border-box;
}

.binding-dialog {
  position: relative;
  width: 100%;
  max-width: 610rpx;
  padding: 28rpx 32rpx 32rpx;
  border: 1rpx solid rgba(16, 58, 49, 0.08);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 28rpx 72rpx rgba(8, 47, 38, 0.28);
  box-sizing: border-box;
}

.dialog-header { display: flex; min-height: 64rpx; align-items: center; justify-content: space-between; gap: 24rpx; }
.dialog-title { min-width: 0; flex: 1; color: #102521; font-size: 28rpx; font-weight: 600; line-height: 1.4; }

.dialog-close {
  position: relative;
  display: flex;
  width: 64rpx;
  min-width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  flex: 0 0 64rpx;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 50%;
  background: #eef4f1;
}

.dialog-close.is-disabled { opacity: 0.48; }
.dialog-close-icon,
.dialog-close-icon::after { position: absolute; width: 24rpx; height: 3rpx; border-radius: 999rpx; background: #5d746c; content: ""; }
.dialog-close-icon { transform: rotate(45deg); }
.dialog-close-icon::after { top: 0; left: 0; transform: rotate(90deg); }

.dialog-description { margin-top: 8rpx; color: #71857e; font-size: 21rpx; line-height: 1.6; }
.captcha-image { width: 100%; height: 126rpx; margin-top: 22rpx; border: 1rpx solid #dce8e4; border-radius: 14rpx; background: #f5f7f7; }
.captcha-input { width: 100%; height: 80rpx; margin-top: 18rpx; padding: 0 21rpx; border: 1rpx solid #d3e1dc; border-radius: 14rpx; color: #29443b; background: #ffffff; font-size: 24rpx; line-height: 80rpx; box-sizing: border-box; }
.bind-qrcode { display: block; width: 360rpx; height: 360rpx; margin: 22rpx auto 8rpx; border: 1rpx solid #dce8e4; border-radius: 16rpx; background: #ffffff; }

.dialog-primary {
  width: 100%;
  height: 80rpx;
  margin: 20rpx 0 0;
  padding: 0 24rpx;
  border: 0;
  border-radius: 16rpx;
  color: #ffffff;
  background: #00a97d;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 80rpx;
}

.dialog-primary.is-disabled { color: rgba(255, 255, 255, 0.82); background: #67a994; }
.binding-message,
.binding-error { margin-top: 16rpx; padding: 13rpx 15rpx; border-radius: 12rpx; font-size: 20rpx; line-height: 1.55; }
.binding-message { color: #52665f; background: #eef5f2; }
.binding-error { color: #a23b32; background: #fff0ed; }

@media (max-width: 360px) {
  .sports-page { padding-right: 16rpx; padding-left: 16rpx; }
  .account-panel { padding-right: 13rpx; padding-left: 13rpx; gap: 11rpx; }
  .account-emblem { width: 56rpx; height: 56rpx; flex-basis: 56rpx; }
  .account-platform { display: none; }
  .bind-action { width: 100rpx; min-width: 100rpx; max-width: 100rpx; padding-right: 12rpx; padding-left: 12rpx; }
  .goal-dashboard { padding-right: 16rpx; padding-left: 16rpx; grid-template-columns: minmax(214rpx, .92fr) minmax(0, 1.08fr); gap: 13rpx; }
  .goal-ring { width: 174rpx; height: 174rpx; }
  .goal-number { font-size: 33rpx; }
  .goal-hint { display: none; }
  .quick-targets { padding-right: 16rpx; padding-left: 16rpx; }
  .quick-targets-row { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 7rpx; }
  .quick-target { padding-right: 8rpx; padding-left: 8rpx; }
  .quick-target-value { font-size: 19rpx; }
  .system-state { display: none; }
  .chat-header-actions { gap: 0; }
  .membership-header-action { min-width: 132rpx; padding-right: 13rpx; padding-left: 10rpx; }
  .manual-goal-current { min-height: 230rpx; padding-right: 20rpx; padding-left: 20rpx; }
  .manual-goal-form { padding-right: 18rpx; padding-left: 18rpx; }
  .manual-goal-save { width: 118rpx; min-width: 118rpx; flex-basis: 118rpx; padding-right: 10rpx; padding-left: 10rpx; }
  .membership-overlay { padding: 20rpx; }
  .membership-dialog { max-height: calc(100vh - 40rpx); padding: 20rpx; }
  .membership-dialog-plans { margin-top: 14rpx; }
  .membership-dialog-plan { min-height: 142rpx; padding: 14rpx; }
  .membership-dialog-plan-label { font-size: 24rpx; }
  .membership-dialog-plan-price { font-size: 27rpx; }
  .membership-dialog-plan-badge { padding-right: 6rpx; padding-left: 6rpx; font-size: 13rpx; }
  .membership-dialog-plan-buy { padding-right: 7rpx; padding-left: 7rpx; }
  .expiry-recovery { padding-right: 15rpx; padding-left: 15rpx; }
  .recovery-reward { display: none; }
  .recovery-secondary-actions { grid-template-columns: minmax(0, 1fr); }
}

@media (prefers-reduced-motion: reduce) {
  .sports-page .anim-up,
  .typing-dot { animation: none; }
  .composer { transition: none; }
  .membership-header-action,
  .manual-goal-preset,
  .membership-dialog-plan,
  .recovery-ad-action,
  .recovery-secondary-action { transition: none; }
}

page {
  height: 100%;
  overflow: hidden;
  padding-bottom: calc(146rpx + env(safe-area-inset-bottom));
  background: #f3f8f5;
  box-sizing: border-box;
}

.sports-page {
  display: flex;
  width: 100%;
  height: calc(100vh - 146rpx - env(safe-area-inset-bottom));
  min-height: 760rpx;
  padding: 22rpx 24rpx 0;
  flex-direction: column;
  gap: 16rpx;
  box-sizing: border-box;
}

.account-panel {
  display: flex;
  min-width: 0;
  min-height: 148rpx;
  padding: 16rpx;
  flex: 0 0 148rpx;
  align-items: center;
  gap: 20rpx;
  border: 1rpx solid rgba(10, 60, 42, 0.08);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow:
    0 1rpx 2rpx rgba(10, 60, 42, 0.035),
    0 12rpx 28rpx -22rpx rgba(7, 84, 60, 0.24);
  box-sizing: border-box;
}

.bind-action {
  display: flex;
  width: 174rpx;
  min-width: 174rpx;
  height: 76rpx;
  margin: 0;
  padding: 0 12rpx;
  flex: 0 0 174rpx;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 0;
  border-radius: 18rpx;
  color: #ffffff;
  background: #087b55;
  box-shadow:
    inset 0 1rpx 0 rgba(255, 255, 255, 0.2),
    0 8rpx 18rpx -12rpx rgba(7, 84, 60, 0.7);
  box-sizing: border-box;
}

.bind-action::after,
.send-button::after,
.dialog-close::after,
.dialog-primary::after {
  border: 0;
}

.bind-action.is-loading {
  opacity: 0.78;
}

.bind-icon {
  position: relative;
  width: 34rpx;
  height: 32rpx;
  flex: 0 0 34rpx;
}

.link-ring {
  position: absolute;
  top: 6rpx;
  width: 24rpx;
  height: 17rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.96);
  border-radius: 999rpx;
  box-sizing: border-box;
}

.link-ring-left {
  left: 0;
  transform: rotate(-32deg);
}

.link-ring-right {
  right: 0;
  transform: rotate(-32deg);
}

.bind-title {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
}

.account-summary {
  min-width: 0;
  flex: 1;
}

.account-heading {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.account-label {
  color: #64766c;
  font-size: 21rpx;
  font-weight: 500;
}

.status-pill {
  display: flex;
  min-height: 34rpx;
  padding: 0 12rpx;
  align-items: center;
  gap: 7rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 600;
  white-space: nowrap;
  box-sizing: border-box;
}

.status-pill.is-unbound {
  color: #7b5a1c;
  background: #f8edd2;
}

.status-pill.is-bound {
  color: #07684a;
  background: #dcf2e7;
}

.status-dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: currentColor;
}

.account-detail {
  min-width: 0;
  margin-top: 7rpx;
}

.account-name {
  overflow: hidden;
  color: #17251e;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-meta {
  margin-top: 3rpx;
  overflow: hidden;
  color: #74867c;
  font-size: 19rpx;
  line-height: 1.45;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.chat-panel {
  display: flex;
  min-height: 0;
  flex: 1;
  flex-direction: column;
  overflow: hidden;
  border: 1rpx solid rgba(10, 60, 42, 0.08);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx -28rpx rgba(7, 84, 60, 0.28);
}

.chat-header {
  display: flex;
  min-height: 96rpx;
  padding: 16rpx 22rpx;
  flex: 0 0 auto;
  align-items: center;
  border-bottom: 1rpx solid rgba(10, 60, 42, 0.07);
  box-sizing: border-box;
}

.assistant-identity {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 14rpx;
}

.assistant-avatar {
  position: relative;
  display: flex;
  width: 56rpx;
  height: 56rpx;
  flex: 0 0 56rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #e3f3eb;
}

.activity-line {
  position: relative;
  width: 32rpx;
  height: 2rpx;
  background: #087b55;
}

.activity-line::before,
.activity-line::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  background: #087b55;
}

.activity-line::before {
  top: -6rpx;
  left: 5rpx;
  width: 13rpx;
  height: 13rpx;
}

.activity-line::after {
  top: -4rpx;
  right: 2rpx;
  width: 9rpx;
  height: 9rpx;
}

.assistant-copy {
  min-width: 0;
}

.assistant-name {
  color: #17251e;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1.25;
}

.assistant-state {
  margin-top: 4rpx;
  color: #75877d;
  font-size: 20rpx;
  line-height: 1.4;
  white-space: nowrap;
}

.chat-scroll {
  min-height: 0;
  flex: 1;
  background: #f9fbfa;
}

.chat-content {
  display: flex;
  padding: 26rpx 22rpx 34rpx;
  flex-direction: column;
  gap: 30rpx;
  box-sizing: border-box;
}

.message-row {
  display: flex;
  min-width: 0;
  align-items: flex-start;
  gap: 12rpx;
}

.message-row.is-user {
  flex-direction: row-reverse;
}

.message-row.is-user .message-avatar {
  color: #087b55;
  background: #dff1e9;
}

.message-row.is-user .message-author {
  text-align: right;
}

.message-row.is-user .message-bubble {
  border-color: #087b55;
  border-radius: 18rpx 6rpx 18rpx 18rpx;
  color: #ffffff;
  background: #087b55;
}

.message-avatar {
  display: flex;
  width: 46rpx;
  height: 46rpx;
  flex: 0 0 46rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #ffffff;
  background: #087b55;
  font-size: 19rpx;
  font-weight: 600;
}

.message-group {
  min-width: 0;
  max-width: 86%;
}

.message-author {
  margin-bottom: 7rpx;
  color: #73857b;
  font-size: 19rpx;
  font-weight: 500;
  line-height: 1.3;
}

.message-bubble {
  padding: 19rpx 21rpx;
  border: 1rpx solid rgba(10, 60, 42, 0.08);
  border-radius: 6rpx 18rpx 18rpx 18rpx;
  color: #314239;
  background: #ffffff;
  box-shadow:
    0 1rpx 2rpx rgba(10, 60, 42, 0.03),
    0 8rpx 20rpx -18rpx rgba(10, 60, 42, 0.26);
  font-size: 24rpx;
  line-height: 1.65;
  box-sizing: border-box;
  white-space: pre-wrap;
  word-break: break-word;
}

.message-bubble.is-success {
  border-color: rgba(8, 123, 85, 0.24);
  background: #eff8f4;
}

.typing-bubble {
  display: flex;
  min-width: 92rpx;
  align-items: center;
  gap: 8rpx;
}

.typing-bubble view {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #8ba097;
  animation: typing-pulse 1.1s ease-in-out infinite;
}

.typing-bubble view:nth-child(2) {
  animation-delay: 0.15s;
}

.typing-bubble view:nth-child(3) {
  animation-delay: 0.3s;
}

.suggestion-block {
  margin-left: 58rpx;
}

.suggestion-title {
  color: #73857b;
  font-size: 20rpx;
  font-weight: 500;
}

.suggestion-list {
  margin-top: 10rpx;
  overflow: hidden;
  border: 1rpx solid rgba(10, 60, 42, 0.08);
  border-radius: 18rpx;
  background: #ffffff;
}

.suggestion-item {
  display: flex;
  min-height: 70rpx;
  padding: 0 18rpx;
  align-items: center;
  gap: 12rpx;
  border-bottom: 1rpx solid rgba(10, 60, 42, 0.065);
  box-sizing: border-box;
}

.suggestion-item:last-child {
  border-bottom: 0;
}

.suggestion-mark {
  display: flex;
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #087b55;
  background: #e5f3ec;
  font-size: 17rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.suggestion-text {
  min-width: 0;
  flex: 1;
  color: #385046;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.4;
}

.suggestion-arrow {
  flex: 0 0 auto;
  color: #9aaba2;
  font-size: 30rpx;
  font-weight: 400;
}

.composer-wrap {
  flex: 0 0 auto;
  padding: 12rpx 16rpx 16rpx;
  border-top: 1rpx solid rgba(10, 60, 42, 0.07);
  background: #ffffff;
}

.composer-notice {
  display: flex;
  margin-bottom: 9rpx;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #7c8c84;
  font-size: 19rpx;
  line-height: 1.4;
}

.notice-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #b59a60;
}

.composer {
  display: flex;
  min-height: 80rpx;
  padding: 8rpx 8rpx 8rpx 20rpx;
  align-items: flex-end;
  gap: 10rpx;
  border: 1rpx solid rgba(10, 60, 42, 0.11);
  border-radius: 20rpx;
  background: #f4f7f5;
  box-sizing: border-box;
}

.composer-input {
  min-width: 0;
  min-height: 46rpx;
  max-height: 120rpx;
  padding: 7rpx 0;
  flex: 1;
  color: #34473d;
  font-size: 24rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.composer-placeholder {
  color: #a0ada6;
}

.send-button {
  position: relative;
  width: 58rpx;
  height: 58rpx;
  min-width: 58rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 18rpx;
  background: #dde6e1;
  box-sizing: border-box;
}

.send-button.is-disabled {
  color: #8fa198;
  background: #dde6e1;
}

.send-button.is-active {
  background: #087b55;
}

.send-button.is-active .send-arrow {
  border-color: #ffffff;
}

.send-button.is-active .send-arrow::after {
  border-color: #ffffff;
}

.send-arrow {
  position: absolute;
  top: 20rpx;
  left: 17rpx;
  width: 23rpx;
  height: 16rpx;
  border-top: 3rpx solid #85978e;
  transform: rotate(-30deg);
}

.send-arrow::after {
  content: "";
  position: absolute;
  top: -6rpx;
  right: -1rpx;
  width: 11rpx;
  height: 11rpx;
  border-top: 3rpx solid #85978e;
  border-right: 3rpx solid #85978e;
  transform: rotate(36deg);
}

@keyframes typing-pulse {
  0%, 60%, 100% { opacity: 0.35; transform: translateY(0); }
  30% { opacity: 1; transform: translateY(-4rpx); }
}

.binding-overlay {
  position: fixed;
  z-index: 1200;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  padding: 40rpx;
  align-items: center;
  justify-content: center;
  background: rgba(15, 31, 24, 0.52);
  box-sizing: border-box;
}

.binding-dialog {
  position: relative;
  width: 100%;
  max-width: 610rpx;
  padding: 30rpx 34rpx 32rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 24rpx 70rpx rgba(8, 47, 34, 0.24);
  box-sizing: border-box;
}

.dialog-header {
  display: flex;
  min-height: 64rpx;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.dialog-close {
  position: relative;
  display: flex;
  flex: 0 0 64rpx;
  width: 64rpx;
  min-width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 50%;
  background: #f2f6f3;
}

.dialog-close.is-disabled {
  opacity: 0.48;
}

.dialog-close-icon,
.dialog-close-icon::after {
  position: absolute;
  width: 26rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #63756b;
  content: "";
}

.dialog-close-icon {
  transform: rotate(45deg);
}

.dialog-close-icon::after {
  top: 0;
  left: 0;
  transform: rotate(90deg);
}

.dialog-title {
  min-width: 0;
  flex: 1;
  color: #17251e;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
}

.dialog-description {
  margin-top: 8rpx;
  color: #718278;
  font-size: 22rpx;
  line-height: 1.6;
}

.captcha-image {
  width: 100%;
  height: 126rpx;
  margin-top: 24rpx;
  border: 1rpx solid rgba(10, 60, 42, 0.1);
  border-radius: 16rpx;
  background: #f7faf8;
}

.captcha-input {
  width: 100%;
  height: 82rpx;
  margin-top: 18rpx;
  padding: 0 22rpx;
  border: 1rpx solid rgba(10, 60, 42, 0.16);
  border-radius: 16rpx;
  color: #22352b;
  background: #ffffff;
  font-size: 25rpx;
  line-height: 82rpx;
  box-sizing: border-box;
}

.bind-qrcode {
  display: block;
  width: 360rpx;
  height: 360rpx;
  margin: 24rpx auto 8rpx;
  border: 1rpx solid rgba(10, 60, 42, 0.08);
  border-radius: 18rpx;
  background: #ffffff;
}

.dialog-primary {
  width: 100%;
  height: 82rpx;
  margin: 22rpx 0 0;
  padding: 0 24rpx;
  border: 0;
  border-radius: 18rpx;
  color: #ffffff;
  background: #087b55;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 82rpx;
}

.dialog-primary.is-disabled {
  color: rgba(255, 255, 255, 0.82);
  background: #5a9d84;
}

.binding-message,
.binding-error {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  font-size: 21rpx;
  line-height: 1.55;
}

.binding-message {
  color: #52665b;
  background: #f1f6f3;
}

.binding-error {
  color: #a0352b;
  background: #fff0ed;
}

@media (max-width: 360px) {
  .sports-page {
    padding-right: 18rpx;
    padding-left: 18rpx;
  }

  .account-panel {
    padding: 14rpx;
    gap: 16rpx;
  }

  .bind-action {
    width: 160rpx;
    min-width: 160rpx;
    flex-basis: 160rpx;
    padding: 0 10rpx;
  }

  .bind-icon {
    width: 30rpx;
    flex-basis: 30rpx;
    transform: scale(0.88);
  }

  .bind-title {
    font-size: 22rpx;
  }

  .account-meta,
  .assistant-state {
    white-space: normal;
  }

  .suggestion-block {
    margin-left: 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  .sports-page .anim-up {
    animation: none;
  }
}

.sports-page {
  display: flex;
  width: 100%;
  height: calc(100vh - 146rpx - env(safe-area-inset-bottom));
  min-height: 760rpx;
  padding: 20rpx 22rpx 0;
  flex-direction: column;
  gap: 14rpx;
  overflow: hidden;
  color: #102521;
  background: #f4f7f6;
  box-sizing: border-box;
}

.account-panel {
  display: flex;
  min-width: 0;
  min-height: 120rpx;
  padding: 15rpx 16rpx;
  flex: 0 0 120rpx;
  align-items: center;
  gap: 14rpx;
  border: 1rpx solid rgba(16, 58, 49, 0.08);
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow:
    0 20rpx 42rpx -32rpx rgba(17, 72, 61, 0.28),
    0 7rpx 16rpx -14rpx rgba(16, 37, 33, 0.16);
  box-sizing: border-box;
}

.account-emblem {
  position: relative;
  display: flex;
  width: 62rpx;
  height: 62rpx;
  flex: 0 0 62rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(0, 124, 97, 0.14);
  border-radius: 18rpx;
  background: #eaf8f3;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  box-sizing: border-box;
}

.emblem-line {
  position: relative;
  width: 30rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #007c61;
}

.emblem-line::before,
.emblem-line::after {
  position: absolute;
  top: -6rpx;
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid #00a97d;
  border-radius: 50%;
  background: #eaf8f3;
  content: "";
  box-sizing: border-box;
}

.emblem-line::before { left: -2rpx; }
.emblem-line::after { right: -2rpx; }

.account-summary {
  min-width: 0;
  flex: 1;
}

.account-heading {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 10rpx;
}

.account-label {
  color: #5f746e;
  font-size: 19rpx;
  font-weight: 500;
  line-height: 1.35;
}

.account-platform {
  color: #00a97d;
  font-family: "SFMono-Regular", Menlo, Consolas, monospace;
  font-size: 15rpx;
  font-weight: 600;
  line-height: 1.35;
  letter-spacing: 1rpx;
}

.account-name {
  margin-top: 2rpx;
  overflow: hidden;
  color: #102521;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.account-meta-row {
  display: flex;
  min-width: 0;
  margin-top: 2rpx;
  align-items: center;
  gap: 12rpx;
}

.account-meta,
.account-target {
  overflow: hidden;
  font-size: 17rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.account-meta {
  min-width: 0;
  color: #768983;
}

.account-target {
  flex: 0 0 auto;
  color: #007c61;
  font-weight: 600;
}

.bind-action {
  display: flex;
  width: 112rpx;
  min-width: 112rpx;
  max-width: 112rpx;
  min-height: 56rpx;
  margin: 0;
  padding: 0 15rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 0;
  border-radius: 999rpx;
  font-size: 19rpx;
  font-weight: 600;
  line-height: 1;
  box-sizing: border-box;
}

.bind-action::after,
.quick-target::after,
.quick-custom-action::after,
.send-button::after,
.dialog-close::after,
.dialog-primary::after { border: 0; }

.bind-action.is-bound {
  color: #007c61;
  background: #e5f7f0;
}

.bind-action.is-unbound {
  color: #ffffff;
  background: #00a97d;
  box-shadow: 0 9rpx 18rpx -12rpx rgba(0, 124, 97, 0.7);
}

.bind-action.is-loading { opacity: 0.72; }
.bind-action.is-pressed { transform: scale(0.97); }

.bind-status-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
}

.bind-title { white-space: nowrap; }

.chat-panel {
  display: flex;
  min-height: 0;
  flex: 1;
  flex-direction: column;
  overflow: hidden;
  border: 1rpx solid rgba(16, 58, 49, 0.08);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow:
    0 24rpx 48rpx -34rpx rgba(17, 72, 61, 0.32),
    0 8rpx 20rpx -18rpx rgba(16, 37, 33, 0.18);
}

.chat-header {
  display: flex;
  min-height: 82rpx;
  padding: 12rpx 20rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-bottom: 1rpx solid #e6eeeb;
  box-sizing: border-box;
}

.assistant-identity {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 12rpx;
}

.assistant-avatar,
.message-avatar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(0, 124, 97, 0.14);
  background: #eaf8f3;
  box-sizing: border-box;
}

.assistant-avatar {
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  border-radius: 15rpx;
}

.activity-line,
.message-avatar-mark {
  position: relative;
  width: 26rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #007c61;
}

.activity-line::before,
.activity-line::after,
.message-avatar-mark::before,
.message-avatar-mark::after {
  position: absolute;
  top: -4rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #00a97d;
  content: "";
}

.activity-line::before,
.message-avatar-mark::before { left: -1rpx; }
.activity-line::after,
.message-avatar-mark::after { right: -1rpx; }

.assistant-copy { min-width: 0; }

.assistant-name {
  color: #102521;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.25;
}

.assistant-state {
  margin-top: 2rpx;
  overflow: hidden;
  color: #7a8d87;
  font-size: 17rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.system-state {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 7rpx;
  color: #698078;
  font-family: "SFMono-Regular", Menlo, Consolas, monospace;
  font-size: 15rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.system-state-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #00a97d;
  box-shadow: 0 0 0 5rpx rgba(0, 169, 125, 0.09);
}

.goal-dashboard {
  display: grid;
  min-height: 246rpx;
  padding: 18rpx 22rpx;
  flex: 0 0 auto;
  grid-template-columns: minmax(250rpx, 0.98fr) minmax(0, 1.02fr);
  align-items: center;
  gap: 20rpx;
  background: #fbfdfc;
  border-bottom: 1rpx solid #e6eeeb;
  box-sizing: border-box;
}

.goal-ring-wrap {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: center;
}

.goal-ring {
  position: relative;
  display: flex;
  width: 198rpx;
  height: 198rpx;
  align-items: center;
  justify-content: center;
  border: 11rpx solid #dfe9e6;
  border-radius: 50%;
  background: #ffffff;
  box-shadow:
    inset 0 0 0 1rpx rgba(16, 58, 49, 0.06),
    0 20rpx 34rpx -26rpx rgba(0, 124, 97, 0.4);
  box-sizing: border-box;
}

.goal-ring::before {
  position: absolute;
  inset: -11rpx;
  border: 11rpx solid transparent;
  border-top-color: #00a97d;
  border-right-color: #00a97d;
  border-bottom-color: rgba(0, 169, 125, 0.34);
  border-radius: 50%;
  content: "";
  transform: rotate(20deg);
}

.goal-ring:not(.has-target)::before {
  border-top-color: #b9cac4;
  border-right-color: transparent;
  border-bottom-color: transparent;
}

.goal-ring-core {
  position: relative;
  z-index: 1;
  min-width: 0;
  text-align: center;
}

.goal-kicker {
  color: #778b84;
  font-size: 17rpx;
  font-weight: 500;
  line-height: 1.4;
}

.goal-number {
  margin-top: 2rpx;
  overflow: hidden;
  color: #102521;
  font-family: "SFMono-Regular", Menlo, Consolas, monospace;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: -2rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.goal-unit {
  margin-top: 2rpx;
  color: #007c61;
  font-size: 16rpx;
  font-weight: 600;
  line-height: 1.4;
}

.goal-data { min-width: 0; }

.goal-data-head,
.goal-stat {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.goal-data-head {
  padding-bottom: 11rpx;
  border-bottom: 1rpx solid #dce8e4;
}

.goal-data-title {
  color: #29443b;
  font-size: 20rpx;
  font-weight: 600;
}

.goal-data-badge {
  padding: 5rpx 9rpx;
  border-radius: 8rpx;
  color: #7b6a43;
  background: #f5eedf;
  font-size: 15rpx;
  font-weight: 600;
  line-height: 1.25;
}

.goal-data-badge.is-ready {
  color: #007c61;
  background: #e5f7f0;
}

.goal-stat {
  padding-top: 10rpx;
}

.goal-stat-label {
  flex: 0 0 auto;
  color: #7a8d87;
  font-size: 16rpx;
  line-height: 1.35;
}

.goal-stat-value {
  min-width: 0;
  overflow: hidden;
  color: #3e554d;
  font-size: 17rpx;
  font-weight: 600;
  line-height: 1.35;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.goal-stat-value.is-positive { color: #007c61; }

.goal-hint {
  margin-top: 11rpx;
  color: #879993;
  font-size: 15rpx;
  line-height: 1.5;
}

.quick-targets {
  padding: 14rpx 22rpx 16rpx;
  flex: 0 0 auto;
  border-bottom: 1rpx solid #e6eeeb;
  background: #ffffff;
}

.quick-targets-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.quick-targets-title {
  color: #29443b;
  font-size: 19rpx;
  font-weight: 600;
}

.quick-custom-action {
  min-height: 44rpx;
  margin: 0;
  padding: 0 11rpx;
  border: 0;
  border-radius: 10rpx;
  color: #007c61;
  background: #eaf8f3;
  font-size: 16rpx;
  font-weight: 600;
  line-height: 44rpx;
}

.quick-custom-action.is-pressed {
  background: #dcf2ea;
  transform: scale(0.97);
}

.quick-targets-row {
  display: grid;
  margin-top: 10rpx;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 9rpx;
}

.quick-target {
  display: flex;
  min-width: 0;
  height: 68rpx;
  margin: 0;
  padding: 8rpx 11rpx;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid #dce8e4;
  border-radius: 14rpx;
  color: #102521;
  background: #ffffff;
  text-align: left;
  line-height: 1;
  box-sizing: border-box;
}

.quick-target.is-pressed {
  border-color: rgba(0, 169, 125, 0.36);
  background: #e5f7f0;
  transform: scale(0.97);
}

.quick-target-copy { min-width: 0; }

.quick-target-main {
  display: flex;
  min-width: 0;
  align-items: baseline;
  gap: 4rpx;
}

.quick-target-value {
  overflow: hidden;
  font-family: "SFMono-Regular", Menlo, Consolas, monospace;
  font-size: 21rpx;
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: -1rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-variant-numeric: tabular-nums;
}

.quick-target-unit {
  color: #60766e;
  font-size: 15rpx;
  font-weight: 500;
}

.quick-target-caption {
  display: block;
  margin-top: 2rpx;
  color: #8a9b95;
  font-size: 14rpx;
  line-height: 1.25;
}

.chat-scroll {
  min-height: 0;
  flex: 1;
  background-color: #f5f7f7;
  background-image:
    linear-gradient(rgba(16, 58, 49, 0.025) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(16, 58, 49, 0.025) 1rpx, transparent 1rpx);
  background-size: 36rpx 36rpx;
}

.chat-content {
  display: flex;
  min-height: 100%;
  padding: 20rpx 22rpx 28rpx;
  flex-direction: column;
  gap: 20rpx;
  box-sizing: border-box;
}

.empty-conversation {
  display: flex;
  margin: 12rpx 0 0;
  padding: 18rpx;
  align-items: center;
  gap: 14rpx;
  border: 1rpx solid rgba(0, 124, 97, 0.08);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.72);
}

.empty-conversation-mark {
  position: relative;
  width: 38rpx;
  height: 38rpx;
  flex: 0 0 38rpx;
  border: 4rpx solid #00a97d;
  border-radius: 50%;
  box-sizing: border-box;
}

.empty-conversation-mark::after {
  position: absolute;
  right: -5rpx;
  bottom: -3rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #102521;
  content: "";
}

.empty-conversation-copy { min-width: 0; }
.empty-conversation-title { color: #29443b; font-size: 19rpx; font-weight: 600; line-height: 1.35; }
.empty-conversation-text { margin-top: 3rpx; color: #7b8e88; font-size: 16rpx; line-height: 1.5; }

.message-row {
  display: flex;
  min-width: 0;
  align-items: flex-start;
  gap: 10rpx;
}

.message-row.is-user { flex-direction: row-reverse; }
.message-row.is-user .message-author { text-align: right; }
.message-row.is-user .message-avatar { background: #102521; border-color: #102521; }
.message-row.is-user .message-bubble { border-color: #102521; border-radius: 17rpx 6rpx 17rpx 17rpx; color: #ffffff; background: #102521; }

.message-avatar {
  width: 36rpx;
  height: 36rpx;
  flex: 0 0 36rpx;
  border-radius: 11rpx;
}

.message-avatar-mark { width: 17rpx; height: 2rpx; }
.message-avatar-mark::before,
.message-avatar-mark::after { top: -3rpx; width: 8rpx; height: 8rpx; }
.message-avatar-mark.is-user { width: 9rpx; height: 9rpx; border-radius: 50%; background: #ffffff; }
.message-avatar-mark.is-user::before,
.message-avatar-mark.is-user::after { display: none; }

.message-group { min-width: 0; max-width: 88%; }
.message-author { margin-bottom: 5rpx; color: #7d8f89; font-size: 16rpx; font-weight: 500; line-height: 1.3; }

.message-bubble {
  padding: 15rpx 18rpx;
  border: 1rpx solid #dce8e4;
  border-radius: 6rpx 17rpx 17rpx 17rpx;
  color: #344c43;
  background: #ffffff;
  font-size: 21rpx;
  line-height: 1.58;
  white-space: pre-wrap;
  word-break: break-word;
  box-sizing: border-box;
}

.message-bubble.is-success { border-color: rgba(0, 169, 125, 0.2); color: #075d49; background: #e8f8f2; }
.typing-bubble { display: flex; min-width: 86rpx; align-items: center; gap: 7rpx; }
.typing-dot { width: 8rpx; height: 8rpx; border-radius: 50%; background: #7f938c; animation: typing-pulse 1.1s cubic-bezier(0.23, 1, 0.32, 1) infinite; }
.typing-dot:nth-child(2) { animation-delay: 0.15s; }
.typing-dot:nth-child(3) { animation-delay: 0.3s; }

.composer-wrap {
  flex: 0 0 auto;
  padding: 10rpx 14rpx 14rpx;
  border-top: 1rpx solid #e6eeeb;
  background: #ffffff;
}

.composer-notice {
  display: flex;
  margin-bottom: 8rpx;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  color: #7d8f89;
  font-size: 17rpx;
  line-height: 1.4;
}

.notice-dot { width: 7rpx; height: 7rpx; border-radius: 50%; background: #9b6829; }

.composer {
  display: flex;
  min-height: 68rpx;
  padding: 4rpx 4rpx 4rpx 15rpx;
  align-items: center;
  gap: 8rpx;
  border: 1rpx solid #d3e1dc;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  transition: border-color 150ms cubic-bezier(0.23, 1, 0.32, 1), box-shadow 150ms cubic-bezier(0.23, 1, 0.32, 1);
  box-sizing: border-box;
}

.composer.is-focused { border-color: rgba(0, 169, 125, 0.62); box-shadow: 0 0 0 3rpx rgba(0, 169, 125, 0.08); }
.composer.is-disabled { opacity: 0.72; }

.composer-input {
  min-width: 0;
  height: 56rpx;
  min-height: 56rpx;
  padding: 0;
  flex: 1;
  color: #29443b;
  font-size: 21rpx;
  line-height: 56rpx;
  box-sizing: border-box;
}

.composer-placeholder { color: #97a7a2; }

.send-button {
  display: flex;
  width: 88rpx;
  min-width: 88rpx;
  height: 56rpx;
  margin: 0;
  padding: 0;
  flex: 0 0 88rpx;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 13rpx;
  line-height: 1;
  box-sizing: border-box;
}

.send-button.is-disabled { color: #a0ada8; background: #eef2f0; }
.send-button.is-active { color: #ffffff; background: #00a97d; box-shadow: 0 9rpx 18rpx -12rpx rgba(0, 124, 97, 0.76); }
.send-button.is-active:active { transform: scale(0.97); }
.send-label { font-size: 19rpx; font-weight: 600; line-height: 1; }

@keyframes typing-pulse {
  0%, 60%, 100% { opacity: 0.35; transform: translateY(0); }
  30% { opacity: 1; transform: translateY(-3rpx); }
}

.binding-overlay {
  position: fixed;
  z-index: 1200;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  padding: 40rpx;
  align-items: center;
  justify-content: center;
  background: rgba(12, 32, 27, 0.54);
  box-sizing: border-box;
}

.binding-dialog {
  position: relative;
  width: 100%;
  max-width: 610rpx;
  padding: 28rpx 32rpx 32rpx;
  border: 1rpx solid rgba(16, 58, 49, 0.08);
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 28rpx 72rpx rgba(8, 47, 38, 0.28);
  box-sizing: border-box;
}

.dialog-header { display: flex; min-height: 64rpx; align-items: center; justify-content: space-between; gap: 24rpx; }
.dialog-title { min-width: 0; flex: 1; color: #102521; font-size: 28rpx; font-weight: 600; line-height: 1.4; }

.dialog-close {
  position: relative;
  display: flex;
  width: 64rpx;
  min-width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  flex: 0 0 64rpx;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 50%;
  background: #eef4f1;
}

.dialog-close.is-disabled { opacity: 0.48; }
.dialog-close-icon,
.dialog-close-icon::after { position: absolute; width: 24rpx; height: 3rpx; border-radius: 999rpx; background: #5d746c; content: ""; }
.dialog-close-icon { transform: rotate(45deg); }
.dialog-close-icon::after { top: 0; left: 0; transform: rotate(90deg); }

.dialog-description { margin-top: 8rpx; color: #71857e; font-size: 21rpx; line-height: 1.6; }
.captcha-image { width: 100%; height: 126rpx; margin-top: 22rpx; border: 1rpx solid #dce8e4; border-radius: 14rpx; background: #f5f7f7; }
.captcha-input { width: 100%; height: 80rpx; margin-top: 18rpx; padding: 0 21rpx; border: 1rpx solid #d3e1dc; border-radius: 14rpx; color: #29443b; background: #ffffff; font-size: 24rpx; line-height: 80rpx; box-sizing: border-box; }
.bind-qrcode { display: block; width: 360rpx; height: 360rpx; margin: 22rpx auto 8rpx; border: 1rpx solid #dce8e4; border-radius: 16rpx; background: #ffffff; }

.dialog-primary {
  width: 100%;
  height: 80rpx;
  margin: 20rpx 0 0;
  padding: 0 24rpx;
  border: 0;
  border-radius: 16rpx;
  color: #ffffff;
  background: #00a97d;
  font-size: 23rpx;
  font-weight: 600;
  line-height: 80rpx;
}

.dialog-primary.is-disabled { color: rgba(255, 255, 255, 0.82); background: #67a994; }
.binding-message,
.binding-error { margin-top: 16rpx; padding: 13rpx 15rpx; border-radius: 12rpx; font-size: 20rpx; line-height: 1.55; }
.binding-message { color: #52665f; background: #eef5f2; }
.binding-error { color: #a23b32; background: #fff0ed; }

@media (max-width: 360px) {
  .sports-page { padding-right: 16rpx; padding-left: 16rpx; }
  .account-panel { padding-right: 13rpx; padding-left: 13rpx; gap: 11rpx; }
  .account-emblem { width: 56rpx; height: 56rpx; flex-basis: 56rpx; }
  .account-platform { display: none; }
  .bind-action { width: 100rpx; min-width: 100rpx; max-width: 100rpx; padding-right: 12rpx; padding-left: 12rpx; }
  .goal-dashboard { padding-right: 16rpx; padding-left: 16rpx; grid-template-columns: minmax(214rpx, .92fr) minmax(0, 1.08fr); gap: 13rpx; }
  .goal-ring { width: 174rpx; height: 174rpx; }
  .goal-number { font-size: 33rpx; }
  .goal-hint { display: none; }
  .quick-targets { padding-right: 16rpx; padding-left: 16rpx; }
  .quick-targets-row { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 7rpx; }
  .quick-target { padding-right: 8rpx; padding-left: 8rpx; }
  .quick-target-value { font-size: 19rpx; }
  .system-state { display: none; }
}

@media (prefers-reduced-motion: reduce) {
  .sports-page .anim-up,
  .typing-dot { animation: none; }
  .composer { transition: none; }
}

page {
  background: #eef5f1;
}

.poster-page {
  min-height: 100vh;
  padding: 32rpx 30rpx calc(56rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.poster-intro {
  max-width: 680rpx;
  margin: 0 auto 26rpx;
}

.poster-kicker {
  color: #087451;
  font-size: 22rpx;
  font-weight: 800;
}

.poster-heading {
  margin-top: 8rpx;
  color: #17251e;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.35;
}

.poster-subtitle {
  margin-top: 10rpx;
  color: #718078;
  font-size: 24rpx;
  line-height: 1.5;
}

.poster-preview {
  position: relative;
  width: 600rpx;
  height: 960rpx;
  max-width: 100%;
  margin: 0 auto;
  overflow: hidden;
  border: 1rpx solid rgba(18, 50, 35, 0.12);
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 42rpx rgba(21, 70, 45, 0.14);
}

.poster-canvas {
  display: block;
  width: 600rpx;
  height: 960rpx;
  max-width: 100%;
}

.poster-image {
  position: absolute;
  z-index: 1;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: block;
  width: 100%;
  height: 100%;
}

.poster-loading,
.poster-error {
  position: absolute;
  z-index: 2;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  padding: 50rpx;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 20rpx;
  background: rgba(247, 250, 248, 0.94);
  color: #607068;
  font-size: 25rpx;
  text-align: center;
}

.poster-loading-mark {
  width: 44rpx;
  height: 44rpx;
  border: 5rpx solid #cae6d8;
  border-top-color: #087451;
  border-radius: 50%;
  animation: poster-spin 0.8s linear infinite;
}

@keyframes poster-spin {
  to { transform: rotate(360deg); }
}

.poster-error-mark {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #fff0ec;
  color: #c34531;
  font-size: 30rpx;
  font-weight: 900;
}

.poster-retry {
  height: 64rpx;
  margin: 4rpx 0 0;
  padding: 0 30rpx;
  border: 1rpx solid #b9d9c8;
  border-radius: 32rpx;
  background: #ffffff;
  color: #087451;
  font-size: 24rpx;
  line-height: 64rpx;
}

.poster-retry::after {
  border: 0;
}

.template-section {
  max-width: 690rpx;
  margin: 34rpx auto 0;
}

.template-label {
  margin-bottom: 16rpx;
  color: #25362d;
  font-size: 27rpx;
  font-weight: 800;
}

.template-scroll {
  width: 100%;
  white-space: nowrap;
}

.template-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 2rpx 2rpx 12rpx;
}

.template-option {
  width: 260rpx;
  min-height: 174rpx;
  margin: 0;
  padding: 20rpx;
  border: 2rpx solid transparent;
  border-radius: 12rpx;
  background: #ffffff;
  color: #25362d;
  text-align: left;
  white-space: normal;
  box-sizing: border-box;
}

.template-option::after {
  border: 0;
}

.template-option.active {
  border-color: #087451;
  box-shadow: 0 8rpx 22rpx rgba(8, 116, 81, 0.12);
}

.template-swatches {
  display: flex;
  gap: 6rpx;
}

.template-swatch {
  width: 36rpx;
  height: 18rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  border-radius: 4rpx;
}

.template-name {
  margin-top: 14rpx;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.25;
}

.template-desc {
  margin-top: 8rpx;
  color: #75847c;
  font-size: 21rpx;
  line-height: 1.45;
}

.poster-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  max-width: 690rpx;
  margin: 28rpx auto 0;
}

.poster-save-btn,
.poster-share-btn {
  width: 100%;
  height: 84rpx;
  margin: 0;
  padding: 0 16rpx;
  border-radius: 12rpx;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 84rpx;
  box-sizing: border-box;
}

.poster-save-btn {
  border: 0;
  background: #087451;
  color: #ffffff;
}

.poster-share-btn {
  border: 1rpx solid #b9d9c8;
  background: #ffffff;
  color: #087451;
}

.poster-save-btn::after,
.poster-share-btn::after {
  border: 0;
}

.poster-save-btn[disabled] {
  background: #a8c6b8;
  color: rgba(255, 255, 255, 0.82);
}

.poster-save-tip {
  max-width: 690rpx;
  margin: 16rpx auto 0;
  color: #718078;
  font-size: 21rpx;
  line-height: 1.5;
  text-align: center;
}

.poster-note {
  max-width: 690rpx;
  margin: 8rpx auto 0;
  color: #7b8982;
  font-size: 21rpx;
  line-height: 1.5;
  text-align: center;
}

@media (max-width: 360px) {
  .poster-page {
    padding-right: 22rpx;
    padding-left: 22rpx;
  }

  .poster-actions {
    grid-template-columns: 1fr;
  }
}

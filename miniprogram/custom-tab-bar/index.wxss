.tab-safe {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding: 14rpx 26rpx calc(14rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  pointer-events: none;
}

.tab-shell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 108rpx;
  padding: 10rpx;
  border: 1rpx solid rgba(244, 217, 78, 0.42);
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 18rpx 48rpx rgba(168, 128, 0, 0.12);
  box-sizing: border-box;
  pointer-events: auto;
}

.tab-item {
  display: flex;
  flex: 1;
  min-width: 0;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 26rpx;
  color: #7a6724;
  font-size: 24rpx;
  font-weight: 700;
}

.tab-item.active {
  color: #2f2500;
  background: linear-gradient(135deg, #ffe24f 0%, #ffc400 100%);
  box-shadow: 0 12rpx 26rpx rgba(255, 196, 0, 0.28);
}

.tab-mark {
  width: 42rpx;
  height: 42rpx;
  border-radius: 999rpx;
  background: #fff8bd;
  color: #6f4d00;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 42rpx;
  text-align: center;
}

.tab-item.active .tab-mark {
  background: rgba(255, 255, 255, 0.42);
  color: #2f2500;
}

.tab-label {
  line-height: 1;
}

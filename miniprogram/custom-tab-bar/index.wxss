.tab-safe {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding: 14rpx 28rpx calc(14rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  pointer-events: none;
}

.tab-shell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  padding: 10rpx;
  border: 1rpx solid rgba(16, 185, 129, 0.15);
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 14rpx 40rpx rgba(8, 84, 57, 0.1);
  box-sizing: border-box;
  pointer-events: auto;
}

.tab-item {
  display: flex;
  flex: 1;
  min-width: 0;
  height: 84rpx;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 22rpx;
  color: #66796d;
  font-size: 24rpx;
  font-weight: 700;
  transition: background 0.24s ease, color 0.24s ease, box-shadow 0.24s ease;
}

.tab-item:active {
  transform: scale(0.95);
}

.tab-item.active {
  color: #ffffff;
  background: linear-gradient(135deg, #2fce8e 0%, #0d9d6c 100%);
  box-shadow: 0 10rpx 22rpx rgba(13, 157, 108, 0.26);
}

@keyframes tab-mark-bounce {
  0% {
    transform: scale(1);
  }
  45% {
    transform: scale(1.18);
  }
  100% {
    transform: scale(1);
  }
}

.tab-mark {
  width: 42rpx;
  height: 42rpx;
  border-radius: 999rpx;
  background: #e6f6ee;
  color: #0a7a52;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 42rpx;
  text-align: center;
  transition: background 0.24s ease, color 0.24s ease;
}

.tab-item.active .tab-mark {
  animation: tab-mark-bounce 0.32s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.tab-item.active .tab-mark {
  background: rgba(255, 255, 255, 0.92);
  color: #0a7a52;
}

.tab-label {
  line-height: 1;
}

.tab-safe {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding: 14rpx 28rpx calc(14rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  pointer-events: none;
  width: 100%;
  max-width: 760px;
  margin: 0 auto;
}

.tab-shell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  padding: 10rpx;
  border: 1rpx solid rgba(10, 60, 42, 0.08);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(24rpx);
  box-shadow:
    0 2rpx 6rpx rgba(10, 60, 42, 0.05),
    0 18rpx 44rpx -12rpx rgba(7, 67, 47, 0.28);
  box-sizing: border-box;
  pointer-events: auto;
}

.tab-item {
  display: flex;
  flex: 1;
  min-width: 0;
  height: 84rpx;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 24rpx;
  color: #6b7f74;
  font-size: 24rpx;
  font-weight: 700;
  transition: background 0.24s ease, color 0.24s ease, box-shadow 0.24s ease;
}

.tab-item:active {
  transform: scale(0.95);
}

.tab-item.active {
  color: #ffffff;
  background: linear-gradient(160deg, #13c489 0%, #0a8f60 52%, #07684a 100%);
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.22),
    0 10rpx 22rpx -6rpx rgba(9, 110, 76, 0.55);
}

@keyframes tab-mark-bounce {
  0% {
    transform: scale(1);
  }
  45% {
    transform: scale(1.18);
  }
  100% {
    transform: scale(1);
  }
}

.tab-mark {
  width: 42rpx;
  height: 42rpx;
  border-radius: 999rpx;
  background: #e6f6ee;
  transition: background 0.24s ease, color 0.24s ease;
}

.tab-icon {
  display: block;
  width: 28rpx;
  height: 28rpx;
  margin: 7rpx;
}

.tab-item.active .tab-mark {
  animation: tab-mark-bounce 0.32s cubic-bezier(0.22, 0.61, 0.36, 1);
  background: rgba(255, 255, 255, 0.94);
  color: #07684a;
}

.tab-label {
  line-height: 1;
}

@media (max-width: 360px) {
  .tab-safe {
    padding-left: 16rpx;
    padding-right: 16rpx;
  }

  .tab-shell {
    padding-left: 6rpx;
    padding-right: 6rpx;
  }

  .tab-item {
    gap: 4rpx;
    font-size: 22rpx;
  }
}

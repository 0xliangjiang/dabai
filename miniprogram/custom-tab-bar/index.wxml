<view class="tab-safe" wx:if="{{!hidden}}">
  <view class="tab-shell">
    <view
      wx:for="{{list}}"
      wx:key="pagePath"
      class="tab-item {{item.activeClass}}"
      data-index="{{index}}"
      bindtap="switchTab"
      aria-role="button"
      aria-label="{{item.label}}"
    >
      <view class="tab-mark">
        <image class="tab-icon" src="{{item.icon}}" mode="aspectFit" />
      </view>
      <view class="tab-label">{{item.label}}</view>
    </view>
  </view>
</view>

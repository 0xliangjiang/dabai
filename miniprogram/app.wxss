page {
  min-height: 100vh;
  background: #edf5f3;
  color: #101827;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.cu-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 180rpx;
  box-sizing: border-box;
}

.page-shell {
  min-height: 100vh;
}

.hero {
  margin: -28rpx -28rpx 0;
  padding: 52rpx 36rpx 64rpx;
  border-bottom-left-radius: 34rpx;
  border-bottom-right-radius: 34rpx;
  background: linear-gradient(135deg, #0f766e 0%, #2563eb 72%, #4f46e5 100%);
  color: #ffffff;
}

.eyebrow {
  display: inline-block;
  min-height: 46rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: rgba(255, 255, 255, 0.92);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 46rpx;
}

.hero-title {
  margin-top: 22rpx;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.15;
}

.hero-desc {
  margin-top: 14rpx;
  max-width: 620rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 26rpx;
  line-height: 1.55;
}

.content-stack {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.floating-stack {
  margin-top: -34rpx;
}

.cu-card {
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(222, 232, 240, 0.92);
  border-radius: 28rpx;
  padding: 30rpx;
  box-shadow: 0 16rpx 42rpx rgba(15, 23, 42, 0.07);
  box-sizing: border-box;
}

.glass-card {
  background: rgba(255, 255, 255, 0.92);
  border-color: rgba(255, 255, 255, 0.72);
}

.section-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.25;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.section-desc {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.5;
}

.cu-label {
  color: #334155;
  font-size: 24rpx;
  font-weight: 700;
}

.muted {
  color: #64748b;
}

.text-sm {
  font-size: 22rpx;
}

.text-base {
  font-size: 26rpx;
}

.text-lg {
  font-size: 32rpx;
}

.text-bold {
  font-weight: 800;
}

.text-green {
  color: #0f766e;
}

.text-blue {
  color: #2563eb;
}

.text-orange {
  color: #c2410c;
}

.text-grey {
  color: #64748b;
}

.text-cut-2 {
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.text-cut {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.flex {
  display: flex;
}

.flex-direction {
  display: flex;
  flex-direction: column;
}

.justify-between {
  justify-content: space-between;
}

.justify-center {
  justify-content: center;
}

.align-center {
  align-items: center;
}

.align-start {
  align-items: flex-start;
}

.flex-sub {
  flex: 1;
  min-width: 0;
}

.gap-xs {
  gap: 8rpx;
}

.gap-sm {
  gap: 16rpx;
}

.gap {
  gap: 24rpx;
}

.gap-lg {
  gap: 32rpx;
}

.margin-top-xs {
  margin-top: 8rpx;
}

.margin-top-sm {
  margin-top: 14rpx;
}

.margin-top {
  margin-top: 24rpx;
}

.margin-bottom-sm {
  margin-bottom: 14rpx;
}

.margin-bottom {
  margin-bottom: 24rpx;
}

.grid-2 {
  display: flex;
  gap: 18rpx;
}

.quick-steps {
  display: flex;
  gap: 14rpx;
}

.step-pill {
  flex: 1;
  min-width: 0;
  min-height: 108rpx;
  padding: 18rpx 12rpx;
  border-radius: 22rpx;
  background: #f8fafc;
  box-sizing: border-box;
  text-align: center;
}

.step-index {
  width: 38rpx;
  height: 38rpx;
  margin: 0 auto 10rpx;
  border-radius: 999rpx;
  background: #e0f2fe;
  color: #2563eb;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 38rpx;
}

.metric {
  flex: 1;
  min-width: 0;
  padding: 22rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
  border: 1rpx solid #e7eef6;
  box-sizing: border-box;
}

.metric-value {
  margin-top: 8rpx;
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 800;
}

.cu-input,
.cu-textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #d7e1ec;
  border-radius: 22rpx;
  background: #f8fafc;
  color: #111827;
  font-size: 28rpx;
}

.cu-form {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.cu-input {
  height: 92rpx;
  padding: 0 26rpx;
}

.cu-textarea {
  min-height: 230rpx;
  padding: 26rpx;
  line-height: 1.55;
}

.prompt-box {
  position: relative;
  overflow: hidden;
}

.cu-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  padding: 0;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.cu-btn::after {
  border: 0;
}

.cu-btn.block {
  width: 100%;
}

.cu-btn.primary {
  color: #ffffff;
  background: linear-gradient(135deg, #0f766e 0%, #2563eb 100%);
  box-shadow: 0 14rpx 28rpx rgba(37, 99, 235, 0.22);
}

.cu-btn.secondary {
  color: #2563eb;
  background: #eff6ff;
  border: 1rpx solid #bfdbfe;
}

.cu-btn.success {
  color: #ffffff;
  background: #0f766e;
}

.cu-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  white-space: nowrap;
}

.cu-tag.blue {
  color: #1d4ed8;
  background: #dbeafe;
}

.cu-tag.green {
  color: #047857;
  background: #d1fae5;
}

.cu-tag.orange {
  color: #c2410c;
  background: #ffedd5;
}

.cu-tag.dark {
  color: #0f172a;
  background: #e2e8f0;
}

.product-card {
  overflow: hidden;
}

.product-thumb {
  width: 156rpx;
  height: 156rpx;
  flex: 0 0 156rpx;
  border-radius: 22rpx;
  background: #e2e8f0;
}

.product-thumb.placeholder {
  color: #64748b;
  font-size: 24rpx;
  font-weight: 800;
}

.price {
  color: #ef4444;
  font-size: 34rpx;
  font-weight: 900;
}

.rate-badge {
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  background: #ecfdf5;
  color: #047857;
  font-size: 22rpx;
  font-weight: 800;
}

.code-box {
  padding: 20rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  color: #334155;
  font-size: 24rpx;
  line-height: 1.55;
  word-break: break-all;
}

.hint-bar {
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #f0fdfa;
  color: #0f766e;
  font-size: 24rpx;
  line-height: 1.45;
}

.soft-panel {
  padding: 20rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  border: 1rpx solid #e7eef6;
}

.cu-empty {
  min-height: 260rpx;
  color: #64748b;
  font-size: 26rpx;
  text-align: center;
}

.empty-icon {
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 18rpx;
  border-radius: 999rpx;
  background: #e0f2fe;
  color: #2563eb;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 92rpx;
}

.cu-list {
  overflow: hidden;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(226, 232, 240, 0.9);
  box-shadow: 0 18rpx 50rpx rgba(15, 23, 42, 0.08);
}

.cu-item {
  min-height: 120rpx;
  padding: 26rpx 28rpx;
  box-sizing: border-box;
}

.line {
  border-bottom: 1rpx solid #e5e7eb;
}

.cu-arrow {
  color: #94a3b8;
  font-size: 38rpx;
}

.cu-upload {
  height: 168rpx;
  border: 2rpx dashed #b6c7da;
  border-radius: 22rpx;
  color: #64748b;
  background: #f8fafc;
  box-sizing: border-box;
}

.mini-link {
  color: #2563eb;
  font-size: 24rpx;
  font-weight: 800;
}

page {
  min-height: 100vh;
  background: #eef4f8;
  color: #101827;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.cu-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 44rpx;
  box-sizing: border-box;
}

.page-shell {
  position: relative;
  min-height: 100vh;
}

.page-shell::before {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 360rpx;
  background: linear-gradient(135deg, #0f766e 0%, #2563eb 58%, #7c3aed 100%);
  content: "";
  z-index: -1;
}

.hero {
  padding: 24rpx 8rpx 30rpx;
  color: #ffffff;
}

.eyebrow {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: rgba(255, 255, 255, 0.92);
  font-size: 22rpx;
  font-weight: 600;
}

.hero-title {
  margin-top: 22rpx;
  font-size: 46rpx;
  font-weight: 800;
  line-height: 1.15;
}

.hero-desc {
  margin-top: 14rpx;
  max-width: 620rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 26rpx;
  line-height: 1.55;
}

.content-stack {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.cu-card {
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(226, 232, 240, 0.9);
  border-radius: 26rpx;
  padding: 28rpx;
  box-shadow: 0 18rpx 50rpx rgba(15, 23, 42, 0.08);
  box-sizing: border-box;
}

.glass-card {
  background: rgba(255, 255, 255, 0.88);
  border-color: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(18rpx);
}

.section-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.25;
}

.section-desc {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
  line-height: 1.5;
}

.cu-label {
  color: #334155;
  font-size: 24rpx;
  font-weight: 700;
}

.muted {
  color: #64748b;
}

.text-sm {
  font-size: 22rpx;
}

.text-base {
  font-size: 26rpx;
}

.text-lg {
  font-size: 32rpx;
}

.text-bold {
  font-weight: 800;
}

.text-green {
  color: #0f766e;
}

.text-blue {
  color: #2563eb;
}

.text-orange {
  color: #c2410c;
}

.text-grey {
  color: #64748b;
}

.text-cut-2 {
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.flex {
  display: flex;
}

.flex-direction {
  display: flex;
  flex-direction: column;
}

.justify-between {
  justify-content: space-between;
}

.justify-center {
  justify-content: center;
}

.align-center {
  align-items: center;
}

.align-start {
  align-items: flex-start;
}

.flex-sub {
  flex: 1;
  min-width: 0;
}

.gap-xs {
  gap: 8rpx;
}

.gap-sm {
  gap: 16rpx;
}

.gap {
  gap: 24rpx;
}

.gap-lg {
  gap: 32rpx;
}

.margin-top-xs {
  margin-top: 8rpx;
}

.margin-top-sm {
  margin-top: 14rpx;
}

.margin-top {
  margin-top: 24rpx;
}

.margin-bottom-sm {
  margin-bottom: 14rpx;
}

.margin-bottom {
  margin-bottom: 24rpx;
}

.grid-2 {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.metric {
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f8fafc;
  box-sizing: border-box;
}

.metric-value {
  margin-top: 8rpx;
  color: #0f172a;
  font-size: 34rpx;
  font-weight: 800;
}

.cu-input,
.cu-textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #d7e1ec;
  border-radius: 22rpx;
  background: #f8fafc;
  color: #111827;
  font-size: 28rpx;
}

.cu-form {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.cu-input {
  height: 92rpx;
  padding: 0 26rpx;
}

.cu-textarea {
  min-height: 244rpx;
  padding: 26rpx;
  line-height: 1.55;
}

.prompt-box {
  position: relative;
  overflow: hidden;
}

.prompt-box::after {
  position: absolute;
  right: -64rpx;
  bottom: -72rpx;
  width: 190rpx;
  height: 190rpx;
  border-radius: 999rpx;
  background: rgba(15, 118, 110, 0.08);
  content: "";
}

.cu-btn {
  height: 92rpx;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 92rpx;
}

.cu-btn::after {
  border: 0;
}

.cu-btn.block {
  width: 100%;
}

.cu-btn.primary {
  color: #ffffff;
  background: linear-gradient(135deg, #0f766e 0%, #2563eb 100%);
  box-shadow: 0 14rpx 28rpx rgba(37, 99, 235, 0.22);
}

.cu-btn.secondary {
  color: #2563eb;
  background: #eff6ff;
  border: 1rpx solid #bfdbfe;
}

.cu-btn.success {
  color: #ffffff;
  background: #0f766e;
}

.cu-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  white-space: nowrap;
}

.cu-tag.blue {
  color: #1d4ed8;
  background: #dbeafe;
}

.cu-tag.green {
  color: #047857;
  background: #d1fae5;
}

.cu-tag.orange {
  color: #c2410c;
  background: #ffedd5;
}

.cu-tag.dark {
  color: #0f172a;
  background: #e2e8f0;
}

.product-card {
  overflow: hidden;
}

.product-thumb {
  width: 150rpx;
  height: 150rpx;
  flex: 0 0 150rpx;
  border-radius: 22rpx;
  background: #e2e8f0;
}

.product-thumb.placeholder {
  color: #64748b;
  font-size: 24rpx;
  font-weight: 800;
}

.price {
  color: #ef4444;
  font-size: 34rpx;
  font-weight: 900;
}

.code-box {
  padding: 20rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  color: #334155;
  font-size: 24rpx;
  line-height: 1.55;
  word-break: break-all;
}

.cu-empty {
  min-height: 260rpx;
  color: #64748b;
  font-size: 26rpx;
  text-align: center;
}

.empty-icon {
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 18rpx;
  border-radius: 999rpx;
  background: #e0f2fe;
  color: #2563eb;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 92rpx;
}

.cu-list {
  overflow: hidden;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(226, 232, 240, 0.9);
  box-shadow: 0 18rpx 50rpx rgba(15, 23, 42, 0.08);
}

.cu-item {
  min-height: 120rpx;
  padding: 26rpx 28rpx;
  box-sizing: border-box;
}

.line {
  border-bottom: 1rpx solid #e5e7eb;
}

.cu-arrow {
  color: #94a3b8;
  font-size: 38rpx;
}

.cu-upload {
  height: 168rpx;
  border: 2rpx dashed #b6c7da;
  border-radius: 22rpx;
  color: #64748b;
  background: #f8fafc;
  box-sizing: border-box;
}

page {
  min-height: 100vh;
  background: #fff8dc;
  color: #2b2116;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.cu-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 180rpx;
  box-sizing: border-box;
}

.page-shell {
  min-height: 100vh;
}

.hero {
  margin: -28rpx -28rpx 0;
  padding: 52rpx 36rpx 64rpx;
  border-bottom-left-radius: 34rpx;
  border-bottom-right-radius: 34rpx;
  background: linear-gradient(135deg, #f8d45c 0%, #f5b83d 58%, #eaa12f 100%);
  color: #3a260f;
}

.eyebrow {
  display: inline-block;
  min-height: 46rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.34);
  color: #5f3d10;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 46rpx;
}

.hero-title {
  margin-top: 22rpx;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.15;
}

.hero-desc {
  margin-top: 14rpx;
  max-width: 620rpx;
  color: #6d4a1a;
  font-size: 26rpx;
  line-height: 1.55;
}

.content-stack {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.floating-stack {
  margin-top: -34rpx;
}

.cu-card {
  background: rgba(255, 255, 255, 0.99);
  border: 1rpx solid rgba(242, 218, 153, 0.9);
  border-radius: 28rpx;
  padding: 30rpx;
  box-shadow: 0 16rpx 42rpx rgba(148, 101, 25, 0.09);
  box-sizing: border-box;
}

.glass-card {
  background: rgba(255, 255, 255, 0.94);
  border-color: rgba(255, 255, 255, 0.72);
}

.section-title {
  color: #2b2116;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.25;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.section-desc {
  margin-top: 8rpx;
  color: #8a7147;
  font-size: 24rpx;
  line-height: 1.5;
}

.cu-label {
  color: #5a421f;
  font-size: 24rpx;
  font-weight: 700;
}

.muted {
  color: #8a7147;
}

.text-sm {
  font-size: 22rpx;
}

.text-base {
  font-size: 26rpx;
}

.text-lg {
  font-size: 32rpx;
}

.text-bold {
  font-weight: 800;
}

.text-green {
  color: #b87912;
}

.text-blue {
  color: #b87912;
}

.text-orange {
  color: #c98716;
}

.text-grey {
  color: #8a7147;
}

.text-cut-2 {
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.text-cut {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.flex {
  display: flex;
}

.flex-direction {
  display: flex;
  flex-direction: column;
}

.justify-between {
  justify-content: space-between;
}

.justify-center {
  justify-content: center;
}

.align-center {
  align-items: center;
}

.align-start {
  align-items: flex-start;
}

.flex-sub {
  flex: 1;
  min-width: 0;
}

.gap-xs {
  gap: 8rpx;
}

.gap-sm {
  gap: 16rpx;
}

.gap {
  gap: 24rpx;
}

.gap-lg {
  gap: 32rpx;
}

.margin-top-xs {
  margin-top: 8rpx;
}

.margin-top-sm {
  margin-top: 14rpx;
}

.margin-top {
  margin-top: 24rpx;
}

.margin-bottom-sm {
  margin-bottom: 14rpx;
}

.margin-bottom {
  margin-bottom: 24rpx;
}

.grid-2 {
  display: flex;
  gap: 18rpx;
}

.quick-steps {
  display: flex;
  gap: 14rpx;
}

.platform-grid {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.platform-pill {
  display: flex;
  min-height: 92rpx;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 18rpx;
  border-radius: 20rpx;
  background: #fffdf3;
  border: 1rpx solid #f3e4ad;
  box-sizing: border-box;
}

.platform-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.platform-mark {
  width: 54rpx;
  height: 54rpx;
  flex: 0 0 54rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #ffe89b 0%, #f5ba35 100%);
  color: #a8660d;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 54rpx;
  text-align: center;
}

.platform-name {
  color: #3b2a16;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.2;
}

.platform-meta {
  margin-top: 6rpx;
  color: #8a7147;
  font-size: 22rpx;
}

.platform-status {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fff4cf;
  color: #a8660d;
  font-size: 22rpx;
  font-weight: 800;
}

.step-pill {
  flex: 1;
  min-width: 0;
  min-height: 108rpx;
  padding: 18rpx 12rpx;
  border-radius: 22rpx;
  background: #fffbea;
  box-sizing: border-box;
  text-align: center;
}

.step-index {
  width: 38rpx;
  height: 38rpx;
  margin: 0 auto 10rpx;
  border-radius: 999rpx;
  background: #fff0b8;
  color: #a8660d;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 38rpx;
}

.metric {
  flex: 1;
  min-width: 0;
  padding: 22rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fffbea 100%);
  border: 1rpx solid #f1dfa5;
  box-sizing: border-box;
}

.metric-value {
  margin-top: 8rpx;
  color: #3b2a16;
  font-size: 32rpx;
  font-weight: 800;
}

.cu-input,
.cu-textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #ecd99b;
  border-radius: 22rpx;
  background: #fffbea;
  color: #2b2116;
  font-size: 28rpx;
}

.cu-form {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.cu-input {
  height: 92rpx;
  padding: 0 26rpx;
}

.cu-textarea {
  min-height: 230rpx;
  padding: 26rpx;
  line-height: 1.55;
}

.prompt-box {
  position: relative;
  overflow: hidden;
}

.cu-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  padding: 0;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.cu-btn::after {
  border: 0;
}

.cu-btn.block {
  width: 100%;
}

.cu-btn.primary {
  color: #ffffff;
  background: linear-gradient(135deg, #f0b429 0%, #d98b18 100%);
  box-shadow: 0 14rpx 28rpx rgba(217, 139, 24, 0.24);
}

.cu-btn.secondary {
  color: #a8660d;
  background: #fff6cf;
  border: 1rpx solid #efd982;
}

.cu-btn.success {
  color: #ffffff;
  background: #d98b18;
}

.cu-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  white-space: nowrap;
}

.cu-tag.blue {
  color: #a8660d;
  background: #fff0b8;
}

.cu-tag.green {
  color: #a8660d;
  background: #ffed9f;
}

.cu-tag.orange {
  color: #a8660d;
  background: #fff0ca;
}

.cu-tag.dark {
  color: #3b2a16;
  background: #f3e7c9;
}

.product-card {
  overflow: hidden;
}

.product-thumb {
  width: 156rpx;
  height: 156rpx;
  flex: 0 0 156rpx;
  border-radius: 22rpx;
  background: #f3e7c9;
}

.product-thumb.placeholder {
  color: #8a7147;
  font-size: 24rpx;
  font-weight: 800;
}

.price {
  color: #c76a12;
  font-size: 34rpx;
  font-weight: 900;
}

.rate-badge {
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  background: #fff0b8;
  color: #a8660d;
  font-size: 22rpx;
  font-weight: 800;
}

.code-box {
  padding: 20rpx;
  border-radius: 18rpx;
  background: #fffbea;
  color: #5a421f;
  font-size: 24rpx;
  line-height: 1.55;
  word-break: break-all;
}

.hint-bar {
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #fff6cf;
  color: #a8660d;
  font-size: 24rpx;
  line-height: 1.45;
}

.soft-panel {
  padding: 20rpx;
  border-radius: 20rpx;
  background: #fffbea;
  border: 1rpx solid #f1dfa5;
}

.cu-empty {
  min-height: 260rpx;
  color: #8a7147;
  font-size: 26rpx;
  text-align: center;
}

.empty-icon {
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 18rpx;
  border-radius: 999rpx;
  background: #fff0b8;
  color: #a8660d;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 92rpx;
}

.cu-list {
  overflow: hidden;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(242, 218, 153, 0.9);
  box-shadow: 0 18rpx 50rpx rgba(148, 101, 25, 0.09);
}

.cu-item {
  min-height: 120rpx;
  padding: 26rpx 28rpx;
  box-sizing: border-box;
}

.line {
  border-bottom: 1rpx solid #f2e2ae;
}

.cu-arrow {
  color: #b79d63;
  font-size: 38rpx;
}

.cu-upload {
  height: 168rpx;
  border: 2rpx dashed #e8cd71;
  border-radius: 22rpx;
  color: #8a7147;
  background: #fffbea;
  box-sizing: border-box;
}

.mini-link {
  color: #a8660d;
  font-size: 24rpx;
  font-weight: 800;
}

page {
  min-height: 100vh;
  background: #fbf5ea;
  color: #241a10;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.cu-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 180rpx;
  box-sizing: border-box;
}

.page-shell {
  min-height: 100vh;
}

.hero {
  margin: -28rpx -28rpx 0;
  padding: 52rpx 36rpx 64rpx;
  border-bottom-left-radius: 34rpx;
  border-bottom-right-radius: 34rpx;
  background: linear-gradient(135deg, #7c3f12 0%, #b76a1d 58%, #d99832 100%);
  color: #ffffff;
}

.eyebrow {
  display: inline-block;
  min-height: 46rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  color: rgba(255, 255, 255, 0.94);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 46rpx;
}

.hero-title {
  margin-top: 22rpx;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.15;
}

.hero-desc {
  margin-top: 14rpx;
  max-width: 620rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 26rpx;
  line-height: 1.55;
}

.content-stack {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.floating-stack {
  margin-top: -34rpx;
}

.cu-card {
  background: rgba(255, 255, 255, 0.99);
  border: 1rpx solid rgba(238, 222, 196, 0.96);
  border-radius: 28rpx;
  padding: 30rpx;
  box-shadow: 0 16rpx 42rpx rgba(92, 53, 18, 0.08);
  box-sizing: border-box;
}

.glass-card {
  background: rgba(255, 255, 255, 0.94);
  border-color: rgba(255, 255, 255, 0.72);
}

.section-title {
  color: #241a10;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.25;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.section-desc {
  margin-top: 8rpx;
  color: #806f5d;
  font-size: 24rpx;
  line-height: 1.5;
}

.cu-label {
  color: #4b3927;
  font-size: 24rpx;
  font-weight: 700;
}

.muted {
  color: #806f5d;
}

.text-sm {
  font-size: 22rpx;
}

.text-base {
  font-size: 26rpx;
}

.text-lg {
  font-size: 32rpx;
}

.text-bold {
  font-weight: 800;
}

.text-green {
  color: #9a5c0b;
}

.text-blue {
  color: #9a5c0b;
}

.text-orange {
  color: #b76a1d;
}

.text-grey {
  color: #806f5d;
}

.text-cut-2 {
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.text-cut {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.flex {
  display: flex;
}

.flex-direction {
  display: flex;
  flex-direction: column;
}

.justify-between {
  justify-content: space-between;
}

.justify-center {
  justify-content: center;
}

.align-center {
  align-items: center;
}

.align-start {
  align-items: flex-start;
}

.flex-sub {
  flex: 1;
  min-width: 0;
}

.gap-xs {
  gap: 8rpx;
}

.gap-sm {
  gap: 16rpx;
}

.gap {
  gap: 24rpx;
}

.gap-lg {
  gap: 32rpx;
}

.margin-top-xs {
  margin-top: 8rpx;
}

.margin-top-sm {
  margin-top: 14rpx;
}

.margin-top {
  margin-top: 24rpx;
}

.margin-bottom-sm {
  margin-bottom: 14rpx;
}

.margin-bottom {
  margin-bottom: 24rpx;
}

.grid-2 {
  display: flex;
  gap: 18rpx;
}

.quick-steps {
  display: flex;
  gap: 14rpx;
}

.step-pill {
  flex: 1;
  min-width: 0;
  min-height: 108rpx;
  padding: 18rpx 12rpx;
  border-radius: 22rpx;
  background: #fff9ef;
  box-sizing: border-box;
  text-align: center;
}

.step-index {
  width: 38rpx;
  height: 38rpx;
  margin: 0 auto 10rpx;
  border-radius: 999rpx;
  background: #fff1d6;
  color: #9a5c0b;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 38rpx;
}

.metric {
  flex: 1;
  min-width: 0;
  padding: 22rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fff9ef 100%);
  border: 1rpx solid #f0dfc2;
  box-sizing: border-box;
}

.metric-value {
  margin-top: 8rpx;
  color: #2f2012;
  font-size: 32rpx;
  font-weight: 800;
}

.cu-input,
.cu-textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #ead8b9;
  border-radius: 22rpx;
  background: #fff9ef;
  color: #241a10;
  font-size: 28rpx;
}

.cu-form {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.cu-input {
  height: 92rpx;
  padding: 0 26rpx;
}

.cu-textarea {
  min-height: 230rpx;
  padding: 26rpx;
  line-height: 1.55;
}

.prompt-box {
  position: relative;
  overflow: hidden;
}

.cu-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  padding: 0;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.cu-btn::after {
  border: 0;
}

.cu-btn.block {
  width: 100%;
}

.cu-btn.primary {
  color: #ffffff;
  background: linear-gradient(135deg, #8f4d13 0%, #d08a24 100%);
  box-shadow: 0 14rpx 28rpx rgba(183, 106, 29, 0.22);
}

.cu-btn.secondary {
  color: #9a5c0b;
  background: #fff4df;
  border: 1rpx solid #efd3a2;
}

.cu-btn.success {
  color: #ffffff;
  background: #9a5c0b;
}

.cu-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  white-space: nowrap;
}

.cu-tag.blue {
  color: #8f4d13;
  background: #fff1d6;
}

.cu-tag.green {
  color: #8f4d13;
  background: #ffedc2;
}

.cu-tag.orange {
  color: #9a5c0b;
  background: #fff0ca;
}

.cu-tag.dark {
  color: #2f2012;
  background: #efe4d4;
}

.product-card {
  overflow: hidden;
}

.product-thumb {
  width: 156rpx;
  height: 156rpx;
  flex: 0 0 156rpx;
  border-radius: 22rpx;
  background: #efe4d4;
}

.product-thumb.placeholder {
  color: #806f5d;
  font-size: 24rpx;
  font-weight: 800;
}

.price {
  color: #b45309;
  font-size: 34rpx;
  font-weight: 900;
}

.rate-badge {
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  background: #fff1d6;
  color: #9a5c0b;
  font-size: 22rpx;
  font-weight: 800;
}

.code-box {
  padding: 20rpx;
  border-radius: 18rpx;
  background: #fff9ef;
  color: #4b3927;
  font-size: 24rpx;
  line-height: 1.55;
  word-break: break-all;
}

.hint-bar {
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #fff4df;
  color: #8f4d13;
  font-size: 24rpx;
  line-height: 1.45;
}

.soft-panel {
  padding: 20rpx;
  border-radius: 20rpx;
  background: #fff9ef;
  border: 1rpx solid #f0dfc2;
}

.cu-empty {
  min-height: 260rpx;
  color: #806f5d;
  font-size: 26rpx;
  text-align: center;
}

.empty-icon {
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 18rpx;
  border-radius: 999rpx;
  background: #fff1d6;
  color: #9a5c0b;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 92rpx;
}

.cu-list {
  overflow: hidden;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(238, 222, 196, 0.96);
  box-shadow: 0 18rpx 50rpx rgba(92, 53, 18, 0.08);
}

.cu-item {
  min-height: 120rpx;
  padding: 26rpx 28rpx;
  box-sizing: border-box;
}

.line {
  border-bottom: 1rpx solid #efe2cf;
}

.cu-arrow {
  color: #b7a28d;
  font-size: 38rpx;
}

.cu-upload {
  height: 168rpx;
  border: 2rpx dashed #e2c89e;
  border-radius: 22rpx;
  color: #806f5d;
  background: #fff9ef;
  box-sizing: border-box;
}

.mini-link {
  color: #9a5c0b;
  font-size: 24rpx;
  font-weight: 800;
}

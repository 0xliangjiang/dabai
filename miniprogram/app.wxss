page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff7c9 0%, #fffaf0 34%, #fffdf7 100%);
  color: #241c08;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.cu-page {
  min-height: 100vh;
  padding: 28rpx 30rpx 184rpx;
  box-sizing: border-box;
}

.page-shell {
  min-height: 100vh;
}

.hero {
  margin: -28rpx -30rpx 0;
  padding: 54rpx 38rpx 66rpx;
  border-bottom-left-radius: 30rpx;
  border-bottom-right-radius: 30rpx;
  background: linear-gradient(135deg, #fff7a8 0%, #ffdd45 56%, #ffc400 100%);
  color: #2d2300;
  box-shadow: 0 18rpx 48rpx rgba(172, 126, 0, 0.12);
}

.eyebrow {
  display: inline-block;
  min-height: 46rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.44);
  color: #5b4700;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 46rpx;
}

.hero-title {
  margin-top: 22rpx;
  font-size: 50rpx;
  font-weight: 800;
  line-height: 1.15;
}

.hero-desc {
  margin-top: 14rpx;
  max-width: 620rpx;
  color: #5f4a00;
  font-size: 26rpx;
  line-height: 1.55;
}

.content-stack {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.floating-stack {
  margin-top: -32rpx;
}

.cu-card {
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(237, 205, 73, 0.36);
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 14rpx 36rpx rgba(152, 111, 0, 0.075);
  box-sizing: border-box;
}

.glass-card {
  background: rgba(255, 255, 255, 0.9);
  border-color: rgba(255, 255, 255, 0.82);
}

.section-title {
  color: #241c08;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.25;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.section-desc {
  margin-top: 8rpx;
  color: #75622a;
  font-size: 24rpx;
  line-height: 1.5;
}

.cu-label {
  color: #443608;
  font-size: 24rpx;
  font-weight: 700;
}

.muted {
  color: #75622a;
}

.text-sm {
  font-size: 22rpx;
}

.text-base {
  font-size: 26rpx;
}

.text-lg {
  font-size: 32rpx;
}

.text-bold {
  font-weight: 800;
}

.text-green {
  color: #b87912;
}

.text-blue {
  color: #b87912;
}

.text-orange {
  color: #c98716;
}

.text-grey {
  color: #75622a;
}

.text-cut-2 {
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.text-cut {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.flex {
  display: flex;
}

.flex-direction {
  display: flex;
  flex-direction: column;
}

.justify-between {
  justify-content: space-between;
}

.justify-center {
  justify-content: center;
}

.align-center {
  align-items: center;
}

.align-start {
  align-items: flex-start;
}

.flex-sub {
  flex: 1;
  min-width: 0;
}

.gap-xs {
  gap: 8rpx;
}

.gap-sm {
  gap: 16rpx;
}

.gap {
  gap: 24rpx;
}

.gap-lg {
  gap: 32rpx;
}

.margin-top-xs {
  margin-top: 8rpx;
}

.margin-top-sm {
  margin-top: 14rpx;
}

.margin-top {
  margin-top: 24rpx;
}

.margin-bottom-sm {
  margin-bottom: 14rpx;
}

.margin-bottom {
  margin-bottom: 24rpx;
}

.grid-2 {
  display: flex;
  gap: 16rpx;
}

.quick-steps {
  display: flex;
  gap: 14rpx;
}

.platform-strip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 56rpx;
  padding: 9rpx 13rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(237, 205, 73, 0.46);
  box-sizing: border-box;
  overflow: hidden;
}

.platform-strip-label {
  color: #7a6724;
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.platform-strip-item {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fff2a3;
  color: #6f4d00;
  font-size: 22rpx;
  font-weight: 800;
  white-space: nowrap;
}

.step-pill {
  flex: 1;
  min-width: 0;
  min-height: 108rpx;
  padding: 18rpx 12rpx;
  border: 1rpx solid rgba(237, 205, 73, 0.34);
  border-radius: 20rpx;
  background: #fffdf5;
  box-sizing: border-box;
  text-align: center;
}

.step-index {
  width: 38rpx;
  height: 38rpx;
  margin: 0 auto 10rpx;
  border-radius: 999rpx;
  background: #ffe674;
  color: #6f4d00;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 38rpx;
}

.metric {
  flex: 1;
  min-width: 0;
  padding: 22rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fffaf0 100%);
  border: 1rpx solid rgba(237, 205, 73, 0.36);
  box-sizing: border-box;
}

.metric-value {
  margin-top: 8rpx;
  color: #3b2a16;
  font-size: 32rpx;
  font-weight: 800;
}

.cu-input,
.cu-textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid rgba(237, 205, 73, 0.52);
  border-radius: 20rpx;
  background: #fffdf7;
  color: #241c08;
  font-size: 28rpx;
}

.cu-form {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.cu-input {
  height: 92rpx;
  padding: 0 26rpx;
}

.cu-textarea {
  min-height: 226rpx;
  padding: 26rpx;
  line-height: 1.55;
}

.prompt-box {
  position: relative;
  overflow: hidden;
}

.cu-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 90rpx;
  padding: 0;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.cu-btn::after {
  border: 0;
}

.cu-btn.block {
  width: 100%;
}

.cu-btn.primary {
  color: #2d2300;
  background: linear-gradient(135deg, #ffe86a 0%, #ffc814 100%);
  box-shadow: 0 14rpx 26rpx rgba(255, 196, 0, 0.22);
}

.cu-btn.secondary {
  color: #6f4d00;
  background: #fff8c7;
  border: 1rpx solid rgba(237, 205, 73, 0.62);
}

.cu-btn.success {
  color: #2d2300;
  background: #ffd437;
}

.cu-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  white-space: nowrap;
}

.cu-tag.blue {
  color: #6f4d00;
  background: #ffe674;
}

.paste-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 92rpx;
  height: 42rpx;
  margin: 0;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #2d2300;
  background: #ffd437;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.paste-chip::after {
  border: 0;
}

.cu-tag.green {
  color: #6f4d00;
  background: #fff1a1;
}

.cu-tag.orange {
  color: #6f4d00;
  background: #fff2ae;
}

.cu-tag.dark {
  color: #3a2b06;
  background: #f6ecbb;
}

.product-card {
  overflow: hidden;
}

.product-thumb {
  width: 156rpx;
  height: 156rpx;
  flex: 0 0 156rpx;
  border-radius: 20rpx;
  background: #f6ecbb;
}

.product-thumb.placeholder {
  color: #7a6724;
  font-size: 24rpx;
  font-weight: 800;
}

.price {
  color: #9c6500;
  font-size: 34rpx;
  font-weight: 900;
}

.rate-badge {
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  background: #ffe674;
  color: #6f4d00;
  font-size: 22rpx;
  font-weight: 800;
}

.rebate-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #fff4a1 0%, #ffd436 100%);
  color: #4f3900;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.55);
}

.rebate-label {
  font-size: 24rpx;
  font-weight: 800;
}

.rebate-value {
  color: #704900;
  font-size: 36rpx;
  font-weight: 900;
}

.code-box {
  padding: 20rpx;
  border: 1rpx solid rgba(237, 205, 73, 0.32);
  border-radius: 18rpx;
  background: #fffdf7;
  color: #4f3f10;
  font-size: 24rpx;
  line-height: 1.55;
  word-break: break-all;
}

.hint-bar {
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #fff8c7;
  color: #6f4d00;
  font-size: 24rpx;
  line-height: 1.45;
}

.soft-panel {
  padding: 20rpx;
  border-radius: 20rpx;
  background: #fffdf7;
  border: 1rpx solid rgba(237, 205, 73, 0.38);
}

.cu-empty {
  min-height: 260rpx;
  color: #7a6724;
  font-size: 26rpx;
  text-align: center;
}

.empty-icon {
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 18rpx;
  border-radius: 999rpx;
  background: #ffe674;
  color: #6f4d00;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 92rpx;
}

.cu-list {
  overflow: hidden;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(237, 205, 73, 0.34);
  box-shadow: 0 14rpx 36rpx rgba(152, 111, 0, 0.07);
}

.cu-item {
  min-height: 116rpx;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

.contact-item {
  width: 100%;
  margin: 0;
  border-radius: 0;
  border: 0;
  background: transparent;
  color: inherit;
  font-size: inherit;
  line-height: inherit;
  text-align: left;
}

.contact-item::after {
  border: 0;
}

.line {
  border-bottom: 1rpx solid rgba(237, 205, 73, 0.32);
}

.cu-arrow {
  color: #b4961a;
  font-size: 38rpx;
}

.cu-upload {
  height: 168rpx;
  border: 2rpx dashed rgba(203, 172, 22, 0.62);
  border-radius: 20rpx;
  color: #7a6724;
  background: #fffdf7;
  box-sizing: border-box;
}

.mini-link {
  color: #6f4d00;
  font-size: 24rpx;
  font-weight: 800;
}

.profile-card {
  min-height: 150rpx;
}

.profile-avatar {
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #fff4a1 0%, #ffd436 100%);
  color: #2d2300;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 88rpx;
  text-align: center;
}

.login-btn,
.mini-btn {
  width: 164rpx;
  height: 72rpx;
  flex: 0 0 164rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
}

.login-btn {
  color: #2d2300;
  background: linear-gradient(135deg, #ffe86a 0%, #ffc814 100%);
}

.article-card {
  gap: 14rpx;
}

.article-text {
  margin-top: 14rpx;
  color: #5b4a16;
  font-size: 26rpx;
  line-height: 1.7;
}

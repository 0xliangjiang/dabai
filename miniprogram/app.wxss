page {
  min-height: 100vh;
  background: #fffbe6;
  color: #2b2116;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.cu-page {
  min-height: 100vh;
  padding: 28rpx 28rpx 180rpx;
  box-sizing: border-box;
}

.page-shell {
  min-height: 100vh;
}

.hero {
  margin: -28rpx -28rpx 0;
  padding: 52rpx 36rpx 64rpx;
  border-bottom-left-radius: 34rpx;
  border-bottom-right-radius: 34rpx;
  background: linear-gradient(135deg, #fff27a 0%, #ffd83d 54%, #ffc414 100%);
  color: #2f2500;
}

.eyebrow {
  display: inline-block;
  min-height: 46rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.34);
  color: #5b4700;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 46rpx;
}

.hero-title {
  margin-top: 22rpx;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1.15;
}

.hero-desc {
  margin-top: 14rpx;
  max-width: 620rpx;
  color: #5f4a00;
  font-size: 26rpx;
  line-height: 1.55;
}

.content-stack {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.floating-stack {
  margin-top: -34rpx;
}

.cu-card {
  background: rgba(255, 255, 255, 0.99);
  border: 1rpx solid rgba(244, 217, 78, 0.42);
  border-radius: 28rpx;
  padding: 30rpx;
  box-shadow: 0 16rpx 42rpx rgba(168, 128, 0, 0.08);
  box-sizing: border-box;
}

.glass-card {
  background: rgba(255, 255, 255, 0.94);
  border-color: rgba(255, 255, 255, 0.72);
}

.section-title {
  color: #2b2116;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.25;
}

.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.section-desc {
  margin-top: 8rpx;
  color: #7a6724;
  font-size: 24rpx;
  line-height: 1.5;
}

.cu-label {
  color: #4f3f10;
  font-size: 24rpx;
  font-weight: 700;
}

.muted {
  color: #7a6724;
}

.text-sm {
  font-size: 22rpx;
}

.text-base {
  font-size: 26rpx;
}

.text-lg {
  font-size: 32rpx;
}

.text-bold {
  font-weight: 800;
}

.text-green {
  color: #b87912;
}

.text-blue {
  color: #b87912;
}

.text-orange {
  color: #c98716;
}

.text-grey {
  color: #7a6724;
}

.text-cut-2 {
  display: -webkit-box;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.text-cut {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.flex {
  display: flex;
}

.flex-direction {
  display: flex;
  flex-direction: column;
}

.justify-between {
  justify-content: space-between;
}

.justify-center {
  justify-content: center;
}

.align-center {
  align-items: center;
}

.align-start {
  align-items: flex-start;
}

.flex-sub {
  flex: 1;
  min-width: 0;
}

.gap-xs {
  gap: 8rpx;
}

.gap-sm {
  gap: 16rpx;
}

.gap {
  gap: 24rpx;
}

.gap-lg {
  gap: 32rpx;
}

.margin-top-xs {
  margin-top: 8rpx;
}

.margin-top-sm {
  margin-top: 14rpx;
}

.margin-top {
  margin-top: 24rpx;
}

.margin-bottom-sm {
  margin-bottom: 14rpx;
}

.margin-bottom {
  margin-bottom: 24rpx;
}

.grid-2 {
  display: flex;
  gap: 18rpx;
}

.quick-steps {
  display: flex;
  gap: 14rpx;
}

.platform-strip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-height: 58rpx;
  padding: 10rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid #f6df69;
  box-sizing: border-box;
  overflow: hidden;
}

.platform-strip-label {
  color: #7a6724;
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.platform-strip-item {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fff4a3;
  color: #6f4d00;
  font-size: 22rpx;
  font-weight: 800;
  white-space: nowrap;
}

.step-pill {
  flex: 1;
  min-width: 0;
  min-height: 108rpx;
  padding: 18rpx 12rpx;
  border-radius: 22rpx;
  background: #fffdf0;
  box-sizing: border-box;
  text-align: center;
}

.step-index {
  width: 38rpx;
  height: 38rpx;
  margin: 0 auto 10rpx;
  border-radius: 999rpx;
  background: #ffe875;
  color: #6f4d00;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 38rpx;
}

.metric {
  flex: 1;
  min-width: 0;
  padding: 22rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #ffffff 0%, #fffdf0 100%);
  border: 1rpx solid #f5dc5b;
  box-sizing: border-box;
}

.metric-value {
  margin-top: 8rpx;
  color: #3b2a16;
  font-size: 32rpx;
  font-weight: 800;
}

.cu-input,
.cu-textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #f3da59;
  border-radius: 22rpx;
  background: #fffdf0;
  color: #2b2116;
  font-size: 28rpx;
}

.cu-form {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.cu-input {
  height: 92rpx;
  padding: 0 26rpx;
}

.cu-textarea {
  min-height: 230rpx;
  padding: 26rpx;
  line-height: 1.55;
}

.prompt-box {
  position: relative;
  overflow: hidden;
}

.cu-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  padding: 0;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.cu-btn::after {
  border: 0;
}

.cu-btn.block {
  width: 100%;
}

.cu-btn.primary {
  color: #2f2500;
  background: linear-gradient(135deg, #ffe24f 0%, #ffc400 100%);
  box-shadow: 0 14rpx 28rpx rgba(255, 196, 0, 0.28);
}

.cu-btn.secondary {
  color: #6f4d00;
  background: #fff8bd;
  border: 1rpx solid #f2d643;
}

.cu-btn.success {
  color: #2f2500;
  background: #ffd21c;
}

.cu-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
  white-space: nowrap;
}

.cu-tag.blue {
  color: #6f4d00;
  background: #ffe875;
}

.paste-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 92rpx;
  height: 44rpx;
  margin: 0;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #2f2500;
  background: #ffd21c;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.paste-chip::after {
  border: 0;
}

.cu-tag.green {
  color: #6f4d00;
  background: #fff18b;
}

.cu-tag.orange {
  color: #6f4d00;
  background: #fff2a6;
}

.cu-tag.dark {
  color: #3b2a16;
  background: #f7edb0;
}

.product-card {
  overflow: hidden;
}

.product-thumb {
  width: 156rpx;
  height: 156rpx;
  flex: 0 0 156rpx;
  border-radius: 22rpx;
  background: #f7edb0;
}

.product-thumb.placeholder {
  color: #7a6724;
  font-size: 24rpx;
  font-weight: 800;
}

.price {
  color: #b06f00;
  font-size: 34rpx;
  font-weight: 900;
}

.rate-badge {
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  background: #ffe875;
  color: #6f4d00;
  font-size: 22rpx;
  font-weight: 800;
}

.rebate-panel {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #fff48a, #ffd100);
  color: #4f3900;
}

.rebate-label {
  font-size: 24rpx;
  font-weight: 800;
}

.rebate-value {
  color: #7a4f00;
  font-size: 36rpx;
  font-weight: 900;
}

.code-box {
  padding: 20rpx;
  border-radius: 18rpx;
  background: #fffdf0;
  color: #4f3f10;
  font-size: 24rpx;
  line-height: 1.55;
  word-break: break-all;
}

.hint-bar {
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #fff8bd;
  color: #6f4d00;
  font-size: 24rpx;
  line-height: 1.45;
}

.soft-panel {
  padding: 20rpx;
  border-radius: 20rpx;
  background: #fffdf0;
  border: 1rpx solid #f5dc5b;
}

.cu-empty {
  min-height: 260rpx;
  color: #7a6724;
  font-size: 26rpx;
  text-align: center;
}

.empty-icon {
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 18rpx;
  border-radius: 999rpx;
  background: #ffe875;
  color: #6f4d00;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 92rpx;
}

.cu-list {
  overflow: hidden;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(244, 217, 78, 0.42);
  box-shadow: 0 18rpx 50rpx rgba(168, 128, 0, 0.08);
}

.cu-item {
  min-height: 120rpx;
  padding: 26rpx 28rpx;
  box-sizing: border-box;
}

.line {
  border-bottom: 1rpx solid #f3df6f;
}

.cu-arrow {
  color: #b4961a;
  font-size: 38rpx;
}

.cu-upload {
  height: 168rpx;
  border: 2rpx dashed #e7c91f;
  border-radius: 22rpx;
  color: #7a6724;
  background: #fffdf0;
  box-sizing: border-box;
}

.mini-link {
  color: #6f4d00;
  font-size: 24rpx;
  font-weight: 800;
}

.profile-card {
  min-height: 150rpx;
}

.profile-avatar {
  width: 88rpx;
  height: 88rpx;
  flex: 0 0 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #fff48a, #ffd100);
  color: #2f2500;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 88rpx;
  text-align: center;
}

.login-btn,
.mini-btn {
  width: 164rpx;
  height: 72rpx;
  flex: 0 0 164rpx;
  border-radius: 18rpx;
  font-size: 24rpx;
}

.login-btn {
  color: #2f2500;
  background: linear-gradient(135deg, #ffe24f 0%, #ffc400 100%);
}

.article-card {
  gap: 14rpx;
}

.article-text {
  margin-top: 14rpx;
  color: #5f4a00;
  font-size: 26rpx;
  line-height: 1.7;
}

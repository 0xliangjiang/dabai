generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  openid      String    @unique
  unionid     String?
  nickname    String?
  avatarUrl   String?   @db.VarChar(512)
  status      String    @default("active")
  rebateRatio Float?
  inviterId   String?
  sportsInviteRewardedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  conversions       Conversion[]
  copyEvents        CopyEvent[]
  orderAttributions OrderAttribution[]
  commissionLedger  CommissionLedger[]
  orderClaims       OrderClaim[]
  checkIns          CheckIn[]
  subscribeGrants   SubscribeGrant[]
  withdrawals       Withdrawal[]
  pointAdjustments  PointAdjustment[]
  sportsAccount     SportsAccount?
  sportsDailyTargets SportsDailyTarget[]
  redeemedSportsCodes SportsAccessCode[]
  sportsAdGrants     SportsAdGrant[]

  // 二级分销：邀请人（上线），仅新用户首次注册时绑定，永久不变
  inviter  User?  @relation("Referral", fields: [inviterId], references: [id])
  invitees User[] @relation("Referral")

  @@index([inviterId])
}

model SportsAccount {
  id                  String    @id @default(cuid())
  userId              String    @unique
  email               String    @unique @db.VarChar(255)
  passwordCipher      String    @db.Text
  loginTokenCipher    String?   @db.Text
  appTokenCipher      String?   @db.Text
  zeppUserId          String?   @unique @db.VarChar(100)
  status              String    @default("awaiting_captcha") @db.VarChar(32)
  bindStatus          String    @default("unbound") @db.VarChar(32)
  captchaKey          String?   @db.VarChar(512)
  captchaExpiresAt    DateTime?
  membershipExpiresAt DateTime?
  lastTargetSteps     Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([bindStatus, updatedAt])
}

model SportsDailyTarget {
  id         String   @id @default(cuid())
  userId     String
  targetDate String   @db.VarChar(10)
  steps      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, targetDate])
  @@index([targetDate, updatedAt])
}

model SportsAccessCode {
  id               String    @id @default(cuid())
  code             String?   @db.VarChar(32)
  codeHash         String    @unique @db.Char(64)
  codeHint         String    @db.VarChar(24)
  batchId          String    @db.VarChar(36)
  durationDays     Int
  status           String    @default("active") @db.VarChar(20)
  validUntil       DateTime?
  redeemedByUserId String?
  redeemedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  redeemedBy User? @relation(fields: [redeemedByUserId], references: [id])

  @@index([status, createdAt])
  @@index([batchId])
  @@index([redeemedByUserId, redeemedAt])
}

model SportsAdGrant {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique @db.Char(64)
  status     String    @default("active") @db.VarChar(20)
  expiresAt  DateTime
  reservedAt DateTime?
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status, expiresAt])
}

model Setting {
  key       String   @id @db.VarChar(64)
  value     String   @db.VarChar(255)
  updatedAt DateTime @updatedAt
}

model PointAdjustment {
  id          String   @id @default(cuid())
  userId      String
  amountCents Int
  reason      String   @db.VarChar(512)
  createdBy   String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Withdrawal {
  id          String    @id @default(cuid())
  userId      String
  amountCents Int
  status      String    @default("pending")
  payAccount  String    @db.VarChar(256)
  payType     String
  notes       String?   @db.VarChar(512)
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// 订单同步记录：每次同步（自动/手动）跑完追加一条，后台只读最新一条看「在不在跑/成败/抓了多少」
model OrderSyncRun {
  id               String   @id @default(cuid())
  trigger          String   // auto(定时) | manual(后台手动)
  ok               Boolean
  taobaoSynced     Int      @default(0)
  taobaoAttributed Int      @default(0)
  jdSynced         Int      @default(0)
  jdAttributed     Int      @default(0)
  errorMessage     String?  @db.VarChar(1024)
  durationMs       Int
  createdAt        DateTime @default(now())

  @@index([createdAt])
}

model OrderSyncLease {
  key        String   @id @db.VarChar(64)
  owner      String   @db.VarChar(64)
  leaseUntil DateTime
  updatedAt  DateTime @updatedAt
}

model CheckIn {
  id          String   @id @default(cuid())
  userId      String
  checkInDate String
  points      Int
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, checkInDate])
  @@index([userId, createdAt])
}

model Conversion {
  id                String   @id @default(cuid())
  userId            String
  rawContent        String  @db.Text
  platform          String   @default("taobao")
  itemId            String
  itemTitle         String  @db.VarChar(512)
  itemImageUrl      String? @db.VarChar(1024)
  itemPriceCents    Int?
  commissionRate    Float?
  estimatedCommissionCents Int @default(0)
  estimatedRebateCents     Int @default(0)
  generatedPassword String  @db.VarChar(512)
  generatedShortUrl String  @db.VarChar(1024)
  generatedClickUrl String  @db.Text
  createdAt         DateTime @default(now())

  user              User               @relation(fields: [userId], references: [id])
  copyEvents        CopyEvent[]
  orderAttributions OrderAttribution[]

  @@index([userId, createdAt])
  @@index([itemId, createdAt])
}

model CopyEvent {
  id           String   @id @default(cuid())
  conversionId String
  userId       String
  itemId       String
  copyType     String
  copiedAt     DateTime @default(now())

  conversion       Conversion         @relation(fields: [conversionId], references: [id])
  user             User               @relation(fields: [userId], references: [id])
  orderAttributions OrderAttribution[]

  @@index([userId, copiedAt])
  @@index([itemId, copiedAt])
}

model ProductSnapshot {
  id             String   @id @default(cuid())
  platform       String   @default("taobao")
  itemId         String
  itemTitle      String   @db.VarChar(512)
  itemImageUrl   String?  @db.VarChar(1024)
  itemPriceCents Int?
  rawPayload     Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([platform, itemId])
  @@index([updatedAt])
}

model TbkOrder {
  id                       String   @id @default(cuid())
  tbkOrderId               String   @unique
  itemId                   String
  itemTitle                String   @db.VarChar(512)
  payTime                  DateTime
  payAmountCents           Int
  estimatedCommissionCents Int
  settledCommissionCents   Int?
  orderStatus              String
  manualStatus             String?
  receivedAt               DateTime? // 首次变「已收货」的时间，用于大额佣金延迟结算计时
  rawPayload               Json
  syncedAt                 DateTime @default(now())
  updatedAt                DateTime @updatedAt

  attribution      OrderAttribution?
  commissionLedger CommissionLedger[]

  @@index([itemId, payTime])
  @@index([orderStatus, syncedAt])
}

model OrderAttribution {
  id           String   @id @default(cuid())
  tbkOrderId   String   @unique
  userId       String?
  conversionId String?
  copyEventId  String?
  status       String
  confidence   Float
  reason       String   @db.VarChar(512)
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tbkOrder   TbkOrder    @relation(fields: [tbkOrderId], references: [id])
  user       User?       @relation(fields: [userId], references: [id])
  conversion Conversion? @relation(fields: [conversionId], references: [id])
  copyEvent  CopyEvent?  @relation(fields: [copyEventId], references: [id])

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model CommissionLedger {
  id         String   @id @default(cuid())
  userId     String
  tbkOrderId String
  amountCents Int
  ledgerType String
  status     String
  reason     String   @db.VarChar(512)
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id])
  tbkOrder TbkOrder @relation(fields: [tbkOrderId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([tbkOrderId])
  @@unique([userId, tbkOrderId, ledgerType])
}

model OrderClaim {
  id            String   @id @default(cuid())
  userId        String
  orderSuffix   String
  screenshotUrl String? @db.VarChar(1024)
  notes         String? @db.VarChar(1024)
  status        String
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model DealPost {
  id          String    @id @default(cuid())
  title       String
  summary     String?   @db.VarChar(512)
  status      String    @default("draft")
  pinned      Boolean   @default(false)
  steps       Json
  viewCount   Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  visits DealVisit[]

  @@index([status, pinned, publishedAt])
}

model DealVisit {
  id         String   @id @default(cuid())
  dealId     String
  visitorKey String   @db.VarChar(64)
  createdAt  DateTime @default(now())

  deal DealPost @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([dealId, visitorKey])
  @@index([dealId])
}

model ArticlePost {
  id          String    @id @default(cuid())
  title       String
  summary     String?   @db.VarChar(512)
  coverUrl    String?   @db.VarChar(1024)
  status      String    @default("draft")
  pinned      Boolean   @default(false)
  blocks      Json
  viewCount   Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  visits ArticleVisit[]

  @@index([status, pinned, publishedAt])
}

model ArticleVisit {
  id         String   @id @default(cuid())
  articleId  String
  visitorKey String   @db.VarChar(64)
  createdAt  DateTime @default(now())

  article ArticlePost @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, visitorKey])
  @@index([articleId])
}

model SubscribeGrant {
  id         String    @id @default(cuid())
  userId     String
  templateId String
  used       Boolean   @default(false)
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([templateId, used])
  @@index([userId, used])
}

model SystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

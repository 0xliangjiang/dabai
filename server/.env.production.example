# 复制为 server/.env.production 并填入真实值（该文件已被 gitignore，勿提交）
NODE_ENV="production"
PORT=3001

# MySQL 连接串（utf8mb4），示例：mysql://user:password@host:3306/dabai
DATABASE_URL="mysql://user:password@host:3306/dabai"

# 安全凭证：用 openssl rand -hex 32 生成
ADMIN_TOKEN="replace-with-strong-random"
SCHEDULER_TOKEN="replace-with-strong-random"
AUTH_TOKEN_SECRET="replace-with-strong-random"

# 管理后台域名（CORS 白名单，逗号分隔）
CORS_ORIGINS="https://admin.your-domain.com"

# 微信小程序
WECHAT_APP_ID="wx6d7e2eacac4b36ff"
WECHAT_APP_SECRET="replace-with-wechat-secret"
# 订阅消息模板 ID（mp 后台「订阅消息」选用模板后填入；留空则关闭订阅功能）
WECHAT_DEAL_TEMPLATE_ID=""

# 分佣比例（0-1）
COMMISSION_SHARING_RATIO=0.5

# 订单侠
DINGDANXIA_API_KEY="replace-with-key"
DINGDANXIA_PID="replace-with-pid"
DINGDANXIA_JD_SITE_ID="replace-with-site-id"
DINGDANXIA_JD_UNION_ID="replace-with-union-id"
DINGDANXIA_JD_AUTH_KEY="replace-with-auth-key"
DINGDANXIA_PDD_PID="replace-with-pdd-pid"

# 订单同步：每 N 分钟拉一次（0 或 ORDER_SYNC_ENABLED=0 关闭）
ORDER_SYNC_INTERVAL_MINUTES=15
ORDER_SYNC_ENABLED=1

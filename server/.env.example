DATABASE_URL="mysql://user:password@localhost:3306/dabai"
# 或者使用分离配置（密码含特殊字符时推荐，自动 URL 编码；二选一，DATABASE_URL 优先）
# DB_HOST="127.0.0.1"
# DB_PORT="3306"
# DB_USER="dabai"
# DB_PASSWORD="p@ss#word!"
# DB_NAME="dabai"

PORT=3001
ADMIN_TOKEN="replace-with-admin-token"
SCHEDULER_TOKEN="replace-with-scheduler-token"
AUTH_TOKEN_SECRET="replace-with-long-random-secret"
CORS_ORIGINS="https://admin.example.com"

WECHAT_APP_ID="replace-with-wechat-app-id"
WECHAT_APP_SECRET="replace-with-wechat-app-secret"

COMMISSION_SHARING_RATIO=0.5


uid\":\"default\"}"

UPLOAD_DIR="./uploads"
ORDER_SYNC_INTERVAL_MINUTES="15"
ORDER_SYNC_ENABLED="1"
WECHAT_DEAL_TEMPLATE_ID="replace-with-template-id"
# 京东联盟官方 API（免费；配置后京东转链/订单同步走官方，优先于订单侠）
JD_UNION_APP_KEY="replace-with-jd-union-app-key"
JD_UNION_APP_SECRET="replace-with-jd-union-app-secret"
JD_UNION_SITE_ID="replace-with-site-id"
JD_UNION_POSITION_ID=""

# 折淘客（淘宝转链，zhetaoke.com 注册获取）
ZTK_APP_KEY="replace-with-ztk-appkey"
ZTK_SID="replace-with-ztk-sid"
ZTK_PID="replace-with-taobao-pid"
# 折淘客代理的京东转链（unionId = 你的京东联盟ID）
ZTK_JD_UNION_ID="replace-with-jd-union-id"
ZTK_JD_POSITION_ID=""

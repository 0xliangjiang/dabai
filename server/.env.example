DATABASE_URL="file:./dev.db"

PORT=3001
ADMIN_TOKEN="replace-with-admin-token"
SCHEDULER_TOKEN="replace-with-scheduler-token"

WECHAT_APP_ID="replace-with-wechat-app-id"
WECHAT_APP_SECRET="replace-with-wechat-app-secret"

TAOBAO_APP_KEY="replace-with-taobao-app-key"
TAOBAO_APP_SECRET="replace-with-taobao-app-secret"
TAOBAO_API_URL="https://eco.taobao.com/router/rest"
TBK_ADZONE_ID="replace-with-adzone-id"

COMMISSION_SHARING_RATIO=0.5

# official | dingdanxia
TAOBAO_PROVIDER="official"

# Dingdanxia provider
DINGDANXIA_API_KEY="replace-with-dingdanxia-api-key"
DINGDANXIA_API_URL="https://api.tbk.dingdanxia.com/tbk/wn_convert"
DINGDANXIA_PID="replace-with-your-taobao-pid"
